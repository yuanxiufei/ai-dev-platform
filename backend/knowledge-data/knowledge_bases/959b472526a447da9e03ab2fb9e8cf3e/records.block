{"doc_id": "16_505464645594427573", "text": "an class=\"line\"><span> }).<span><span>mount<span><span>(<span><span>'#app'<span><span>)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><p><a href=\"https://codepen.io/vuejs-examples/pen/QWJwJLp\" target=\"_blank\">CodePen 示例 ><a><p><div><div class=\"composition-api\"><div class=\"language-html\"> <span class=\"lang\">html<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> src<span><span>=<span><span>\"https://unpkg.com/vue@3/dist/vue.global.js\"<span><span>></<span><span>script<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/quick-start.html", "title": "快速上手", "doc_id": "937f65348e764db2893e6dca1a4de97f", "content_type": "web_page", "word_count": 917, "chunk_index": 16, "_doc_id": "16_505464645594427573"}}
{"doc_id": "17_995943323087456860", "text": "tps://unpkg.com/vue@3/dist/vue.global.js\"<span><span>></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>div<span><span> id<span><span>=<span><span>\"app\"<span><span>>{{ message }}</<span><span>div<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>script<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/quick-start.html", "title": "快速上手", "doc_id": "937f65348e764db2893e6dca1a4de97f", "content_type": "web_page", "word_count": 917, "chunk_index": 17, "_doc_id": "17_995943323087456860"}}
{"doc_id": "18_1721090273596238987", "text": "an>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>script<span><span>><span><span>\n<span class=\"line\"><span> const<span><span> { <span><span>createApp<span><span>, <span><span>ref<span><span> } <span><span>=<span><span> Vue<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> createApp<span><span>({<span><span>\n<span class=\"line\"><span> setup<span><span>() {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/quick-start.html", "title": "快速上手", "doc_id": "937f65348e764db2893e6dca1a4de97f", "content_type": "web_page", "word_count": 917, "chunk_index": 18, "_doc_id": "18_1721090273596238987"}}
