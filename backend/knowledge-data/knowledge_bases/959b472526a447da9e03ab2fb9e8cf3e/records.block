{"doc_id": "38_7519581862632735458", "text": "span><<span><span>script<span><span> type<span><span>=<span><span>\"module\"<span><span>><span><span>\n<span class=\"line highlighted\"><span> import<span><span> { createApp, ref } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> createApp<span><span>({<span><span>\n<span class=\"line\"><span> setup<span><span>() {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/quick-start", "title": "快速上手", "doc_id": "20ca8b210a1f42038b6aa2bfbe17d001", "content_type": "web_page", "word_count": 917, "chunk_index": 38, "_doc_id": "38_7519581862632735458"}}
