{"doc_id": "119_3230199362550462742", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>const<span><span> [<span><span>firstName<span><span>, <span><span>firstNameModifiers<span><span>] <span><span>=<span><span> defineModel<span><span>(<span><span>'firstName'<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 119, "_doc_id": "119_3230199362550462742"}}
{"doc_id": "120_3221743632466710837", "text": "<span><span>=<span><span> defineModel<span><span>(<span><span>'firstName'<span><span>)<span><span>\n<span class=\"line\"><span>const<span><span> [<span><span>lastName<span><span>, <span><span>lastNameModifiers<span><span>] <span><span>=<span><span> defineModel<span><span>(<span><span>'lastName'<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>console.<span><span>log<span><span>(firstNameModifiers) <span><span>// { capitalize: true }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 120, "_doc_id": "120_3221743632466710837"}}
{"doc_id": "121_1785702163289604399", "text": "ole.<span><span>log<span><span>(firstNameModifiers) <span><span>// { capitalize: true }<span><span>\n<span class=\"line\"><span>console.<span><span>log<span><span>(lastNameModifiers) <span><span>// { uppercase: true }<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div> 3.4 之前的用法 <div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 121, "_doc_id": "121_1785702163289604399"}}
{"doc_id": "122_5523799124613451257", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>const<span><span> props<span><span> =<span><span> defineProps<span><span>({<span><span>\n<span class=\"line\"><span> firstName: String,<span><span>\n<span class=\"line\"><span> lastName: String,<span><span>\n<span class=\"line highlighted\"><span> firstNameModifiers: { <span><span>default<span><span>: () <span><span>=><span><span> ({}) },<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 122, "_doc_id": "122_5523799124613451257"}}
{"doc_id": "123_4108154130068327448", "text": "NameModifiers: { <span><span>default<span><span>: () <span><span>=><span><span> ({}) },<span><span>\n<span class=\"line highlighted\"><span> lastNameModifiers: { <span><span>default<span><span>: () <span><span>=><span><span> ({}) }<span><span>\n<span class=\"line\"><span>})<span><span>\n<span class=\"line\"><span>defineEmits<span><span>([<span><span>'update:firstName'<span><span>, <span><span>'update:lastName'<span><span>])<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 123, "_doc_id": "123_4108154130068327448"}}
{"doc_id": "124_1219393766745831751", "text": "ame'<span><span>, <span><span>'update:lastName'<span><span>])<span><span>\n<span class=\"line\"><span>\n<span class=\"line highlighted\"><span>console.<span><span>log<span><span>(props.firstNameModifiers) <span><span>// { capitalize: true }<span><span>\n<span class=\"line highlighted\"><span>console.<span><span>log<span><span>(props.lastNameModifiers) <span><span>// { uppercase: true }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 124, "_doc_id": "124_1219393766745831751"}}
{"doc_id": "125_2395648841429648836", "text": "<span><span>log<span><span>(props.lastNameModifiers) <span><span>// { uppercase: true }<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div> <div><div class=\"options-api\"><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> props: {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 125, "_doc_id": "125_2395648841429648836"}}
{"doc_id": "126_6340985139017225898", "text": "export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> props: {<span><span>\n<span class=\"line\"><span> firstName: String,<span><span>\n<span class=\"line\"><span> lastName: String,<span><span>\n<span class=\"line\"><span> firstNameModifiers: {<span><span>\n<span class=\"line\"><span> default<span><span>: () <span><span>=><span><span> ({})<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> lastNameModifiers: {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 126, "_doc_id": "126_6340985139017225898"}}
{"doc_id": "127_7982185861767739698", "text": "<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> lastNameModifiers: {<span><span>\n<span class=\"line\"><span> default<span><span>: () <span><span>=><span><span> ({})<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> emits: [<span><span>'update:firstName'<span><span>, <span><span>'update:lastName'<span><span>],<span><span>\n<span class=\"line\"><span> created<span><span>() {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 127, "_doc_id": "127_7982185861767739698"}}
{"doc_id": "128_4218585709635154780", "text": "e:lastName'<span><span>],<span><span>\n<span class=\"line\"><span> created<span><span>() {<span><span>\n<span class=\"line highlighted\"><span> console.<span><span>log<span><span>(<span><span>this<span><span>.firstNameModifiers) <span><span>// { capitalize: true }<span><span>\n<span class=\"line highlighted\"><span> console.<span><span>log<span><span>(<span><span>this<span><span>.lastNameModifiers) <span><span>// { uppercase: true }<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 128, "_doc_id": "128_4218585709635154780"}}
{"doc_id": "129_6517365676116261666", "text": "meModifiers) <span><span>// { uppercase: true }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><div><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 129, "_doc_id": "129_6517365676116261666"}}
{"doc_id": "0_5105222090429891315", "text": "<div><div><h1 id=\"fallthrough-attributes\">透传 Attributes <a class=\"header-anchor\" href=\"#fallthrough-attributes\">​<a><h1><blockquote><p>此章节假设你已经看过了<a href=\"/guide/essentials/component-basics.html\">组件基础<a>。若你还不了解组件是什么，请先阅读该章节。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 0, "_doc_id": "0_5105222090429891315"}}
{"doc_id": "1_2271079055195421513", "text": "ckquote><p>此章节假设你已经看过了<a href=\"/guide/essentials/component-basics.html\">组件基础<a>。若你还不了解组件是什么，请先阅读该章节。<p><blockquote><h2 id=\"attribute-inheritance\">Attributes 继承 <a class=\"header-anchor\" href=\"#attribute-inheritance\">​<a><h2><p>“透传 attribute”指的是传递给一个组件，却没有被该组件声明为 <a href=\"./props.html\">props<a> 或 <a href=\"./events.html#defining-custom-events\">emits<a> 的 attribute 或者 <code>v-on<code> 事件监听器。最常见的例子就是 <code>class<code>、<code>style<code> 和 <code>id<code>。<p><p>当一个组件以单个元素为根作渲染时，透传的 attribute 会自动被添加到根元素上。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 1, "_doc_id": "1_2271079055195421513"}}
{"doc_id": "2_3312899051460455927", "text": "ode>class<code>、<code>style<code> 和 <code>id<code>。<p><p>当一个组件以单个元素为根作渲染时，透传的 attribute 会自动被添加到根元素上。举例来说，假如我们有一个 <code><MyButton><code> 组件，它的模板长这样：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- <MyButton> 的模板 --><span><span>\n<span class=\"line\"><span><<span><span>button<span><span>>Click Me</<span><span>button<span><span>><span><span><code><pre><div><p>一个父组件使用了这个组件，并且传入了 <code>class<code>：<p><div", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 2, "_doc_id": "2_3312899051460455927"}}
{"doc_id": "3_3139694658375780992", "text": "span>button<span><span>><span><span><code><pre><div><p>一个父组件使用了这个组件，并且传入了 <code>class<code>：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyButton<span><span> class<span><span>=<span><span>\"large\"<span><span> /><span><span><code><pre><div><p>最后渲染出的 DOM 结果是：<p><div class=\"language-html\"> <span class=\"lang\">html<span><pre class=\"shiki github-dark vp-code\"><code><span", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 3, "_doc_id": "3_3139694658375780992"}}
{"doc_id": "4_8589871266512320090", "text": "ss=\"language-html\"> <span class=\"lang\">html<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span> class<span><span>=<span><span>\"large\"<span><span>>Click Me</<span><span>button<span><span>><span><span><code><pre><div><p>这里，<code><MyButton><code> 并没有将 <code>class<code> 声明为一个它所接受的 prop，所以 <code>class<code> 被视作透传 attribute，自动透传到了 <code><MyButton><code> 的根元素上。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 4, "_doc_id": "4_8589871266512320090"}}
{"doc_id": "5_8892247353788233203", "text": "lass<code> 声明为一个它所接受的 prop，所以 <code>class<code> 被视作透传 attribute，自动透传到了 <code><MyButton><code> 的根元素上。<p><h3 id=\"class-and-style-merging\">对 <code>class<code> 和 <code>style<code> 的合并 <a class=\"header-anchor\" href=\"#class-and-style-merging\">​<a><h3><p>如果一个子组件的根元素已经有了 <code>class<code> 或 <code>style<code> attribute，它会和从父组件上继承的值合并。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 5, "_doc_id": "5_8892247353788233203"}}
{"doc_id": "6_846907709151754657", "text": "-merging\">​<a><h3><p>如果一个子组件的根元素已经有了 <code>class<code> 或 <code>style<code> attribute，它会和从父组件上继承的值合并。如果我们将之前的 <code><MyButton><code> 组件的模板改成这样：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- <MyButton> 的模板 --><span><span>\n<span class=\"line\"><span><<span><span>button<span><span> class<span><span>=<span><span>\"btn\"<span><span>>Click Me</<span><span>button<span><span>><span><span><code><pre><div><p>则最后渲染出的 DOM", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 6, "_doc_id": "6_846907709151754657"}}
{"doc_id": "7_8365172332295209131", "text": "tn\"<span><span>>Click Me</<span><span>button<span><span>><span><span><code><pre><div><p>则最后渲染出的 DOM 结果会变成：<p><div class=\"language-html\"> <span class=\"lang\">html<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span> class<span><span>=<span><span>\"btn large\"<span><span>>Click Me</<span><span>button<span><span>><span><span><code><pre><div><h3 id=\"v-on-listener-inheritance\"><code>v-on<code> 监听器继承 <a class=\"header-anchor\"", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 7, "_doc_id": "7_8365172332295209131"}}
{"doc_id": "8_6679375095439147088", "text": "><code><pre><div><h3 id=\"v-on-listener-inheritance\"><code>v-on<code> 监听器继承 <a class=\"header-anchor\" href=\"#v-on-listener-inheritance\">​<a><h3><p>同样的规则也适用于 <code>v-on<code> 事件监听器：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyButton<span><span> @<span><span>click<span><span>=<span><span>\"<span><span>onClick<span><span>\"<span><span> /><span><span><code><pre><div><p><code>click<code> 监听器会被添加到", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 8, "_doc_id": "8_6679375095439147088"}}
{"doc_id": "9_7869079609280438397", "text": "><span>onClick<span><span>\"<span><span> /><span><span><code><pre><div><p><code>click<code> 监听器会被添加到 <code><MyButton><code> 的根元素，即那个原生的 <code><button><code> 元素之上。当原生的 <code><button><code> 被点击，会触发父组件的 <code>onClick<code> 方法。同样的，如果原生 <code>button<code> 元素自身也通过 <code>v-on<code> 绑定了一个事件监听器，则这个监听器和从父组件继承的监听器都会被触发。<p><h3 id=\"nested-component-inheritance\">深层组件继承 <a class=\"header-anchor\" href=\"#nested-component-inheritance\">​<a><h3><p>有些情况下一个组件会在根节点上渲染另一个组件。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 9, "_doc_id": "9_7869079609280438397"}}
{"doc_id": "10_6544917143067507986", "text": "件继承 <a class=\"header-anchor\" href=\"#nested-component-inheritance\">​<a><h3><p>有些情况下一个组件会在根节点上渲染另一个组件。例如，我们重构一下 <code><MyButton><code>，让它在根节点上渲染 <code><BaseButton><code>：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- <MyButton/> 的模板，只是渲染另一个组件 --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 10, "_doc_id": "10_6544917143067507986"}}
{"doc_id": "11_3285946623720870267", "text": "github-dark vp-code\"><code><span class=\"line\"><span><!-- <MyButton/> 的模板，只是渲染另一个组件 --><span><span>\n<span class=\"line\"><span><<span><span>BaseButton<span><span> /><span><span><code><pre><div><p>此时 <code><MyButton><code> 接收的透传 attribute 会直接继续传给 <code><BaseButton><code>。<p><p>请注意：<p><ol><li><p>透传的 attribute 不会包含 <code><MyButton><code> 上声明过的 props 或是针对 <code>emits<code> 声明事件的 <code>v-on<code> 侦听函数，换句话说，声明过的 props 和侦听函数被 <code><MyButton><code>“消费”了。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 11, "_doc_id": "11_3285946623720870267"}}
{"doc_id": "12_7307241838565645370", "text": "针对 <code>emits<code> 声明事件的 <code>v-on<code> 侦听函数，换句话说，声明过的 props 和侦听函数被 <code><MyButton><code>“消费”了。<p><li><li><p>透传的 attribute 若符合声明，也可以作为 props 传入 <code><BaseButton><code>。<p><li><ol><h2 id=\"disabling-attribute-inheritance\">禁用 Attributes 继承 <a class=\"header-anchor\" href=\"#disabling-attribute-inheritance\">​<a><h2><p>如果你<strong>不想要<strong>一个组件自动地继承 attribute，你可以在组件选项中设置 <code>inheritAttrs: false<code>。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 12, "_doc_id": "12_7307241838565645370"}}
{"doc_id": "13_8064180446144372461", "text": "e\">​<a><h2><p>如果你<strong>不想要<strong>一个组件自动地继承 attribute，你可以在组件选项中设置 <code>inheritAttrs: false<code>。<p><div class=\"composition-api\"><p>从 3.3 开始你也可以直接在 <code><script setup><code> 中使用 <a href=\"/api/sfc-script-setup.html#defineoptions\"><code>defineOptions<code><a>：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 13, "_doc_id": "13_8064180446144372461"}}
{"doc_id": "14_7132622456940786187", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>defineOptions<span><span>({<span><span>\n<span class=\"line\"><span> inheritAttrs: <span><span>false<span><span>\n<span class=\"line\"><span>})<span><span>\n<span class=\"line\"><span>// ...setup 逻辑<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><div><p>最常见的需要禁用 attribute 继承的场景就是 attribute 需要应用在根节点以外的其他元素上。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 14, "_doc_id": "14_7132622456940786187"}}
{"doc_id": "15_3253789116062425570", "text": "an><span>><span><span><code><pre><div><div><p>最常见的需要禁用 attribute 继承的场景就是 attribute 需要应用在根节点以外的其他元素上。通过设置 <code>inheritAttrs<code> 选项为 <code>false<code>，你可以完全控制透传进来的 attribute 被如何使用。<p><p>这些透传进来的 attribute 可以在模板的表达式中直接用 <code>$attrs<code> 访问到。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 15, "_doc_id": "15_3253789116062425570"}}
{"doc_id": "16_4764713083967151516", "text": "lse<code>，你可以完全控制透传进来的 attribute 被如何使用。<p><p>这些透传进来的 attribute 可以在模板的表达式中直接用 <code>$attrs<code> 访问到。<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>span<span><span>>Fallthrough attribute: {{ $attrs }}</<span><span>span<span><span>><span><span><code><pre><div><p>这个 <code>$attrs<code> 对象包含了除组件所声明的 <code>props<code> 和 <code>emits<code> 之外的所有其他 attribute，例如 <code>class<code>，<code>style<code>，<code>v-on<code> 监听器等等。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 16, "_doc_id": "16_4764713083967151516"}}
{"doc_id": "17_3360365578102973291", "text": "和 <code>emits<code> 之外的所有其他 attribute，例如 <code>class<code>，<code>style<code>，<code>v-on<code> 监听器等等。<p><p>有几点需要注意：<p><p>现在我们要再次使用一下<a href=\"#attribute-inheritance\">之前小节<a>中的 <code><MyButton><code> 组件例子。有时候我们可能为了样式，需要在 <code><button><code> 元素外包装一层 <code><div><code>：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> class<span><span>=<span><span>\"btn-wrapper\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 17, "_doc_id": "17_3360365578102973291"}}
{"doc_id": "18_1605757601373366819", "text": "n><<span><span>div<span><span> class<span><span>=<span><span>\"btn-wrapper\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>button<span><span> class<span><span>=<span><span>\"btn\"<span><span>>Click Me</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span></<span><span>div<span><span>><span><span><code><pre><div><p>我们想要所有像 <code>class<code> 和 <code>v-on<code> 监听器这样的透传 attribute 都应用在内部的 <code><button><code> 上而不是外层的 <code><div><code> 上。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 18, "_doc_id": "18_1605757601373366819"}}
{"doc_id": "19_4035997978356348706", "text": "ode> 和 <code>v-on<code> 监听器这样的透传 attribute 都应用在内部的 <code><button><code> 上而不是外层的 <code><div><code> 上。我们可以通过设定 <code>inheritAttrs: false<code> 和使用 <code>v-bind=\"$attrs\"<code> 来实现：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> class<span><span>=<span><span>\"btn-wrapper\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 19, "_doc_id": "19_4035997978356348706"}}
{"doc_id": "20_6918965250354788266", "text": "n><<span><span>div<span><span> class<span><span>=<span><span>\"btn-wrapper\"<span><span>><span><span>\n<span class=\"line highlighted\"><span> <<span><span>button<span><span> class<span><span>=<span><span>\"btn\"<span><span> v-bind<span><span>=<span><span>\"<span><span>$attrs<span><span>\"<span><span>>Click Me</<span><span>button<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 20, "_doc_id": "20_6918965250354788266"}}
{"doc_id": "21_1733263252071480182", "text": ">\"<span><span>$attrs<span><span>\"<span><span>>Click Me</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span></<span><span>div<span><span>><span><span><code><pre><div><p>小提示：<a href=\"/guide/essentials/template-syntax.html#dynamically-binding-multiple-attributes\">没有参数的 <code>v-bind<code><a> 会将一个对象的所有属性都作为 attribute 应用到目标元素上。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 21, "_doc_id": "21_1733263252071480182"}}
{"doc_id": "22_5589928958333438088", "text": "amically-binding-multiple-attributes\">没有参数的 <code>v-bind<code><a> 会将一个对象的所有属性都作为 attribute 应用到目标元素上。<p><h2 id=\"attribute-inheritance-on-multiple-root-nodes\">多根节点的 Attributes 继承 <a class=\"header-anchor\" href=\"#attribute-inheritance-on-multiple-root-nodes\">​<a><h2><p>和单根节点组件有所不同，有着多个根节点的组件没有自动 attribute 透传行为。如果 <code>$attrs<code> 没有被显式绑定，将会抛出一个运行时警告。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 22, "_doc_id": "22_5589928958333438088"}}
{"doc_id": "23_3119916824940215524", "text": "des\">​<a><h2><p>和单根节点组件有所不同，有着多个根节点的组件没有自动 attribute 透传行为。如果 <code>$attrs<code> 没有被显式绑定，将会抛出一个运行时警告。<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>CustomLayout<span><span> id<span><span>=<span><span>\"custom-layout\"<span><span> @<span><span>click<span><span>=<span><span>\"<span><span>changeValue<span><span>\"<span><span> /><span><span><code><pre><div><p>如果 <code><CustomLayout><code> 有下面这样的多根节点模板，由于 Vue 不知道要将 attribute 透传到哪里，所以会抛出一个警告。", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 23, "_doc_id": "23_3119916824940215524"}}
{"doc_id": "24_2727602922100039867", "text": "code><pre><div><p>如果 <code><CustomLayout><code> 有下面这样的多根节点模板，由于 Vue 不知道要将 attribute 透传到哪里，所以会抛出一个警告。<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>header<span><span>>...</<span><span>header<span><span>><span><span>\n<span class=\"line\"><span><<span><span>main<span><span>>...</<span><span>main<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 24, "_doc_id": "24_2727602922100039867"}}
{"doc_id": "25_1277687099501042579", "text": "pan class=\"line\"><span><<span><span>main<span><span>>...</<span><span>main<span><span>><span><span>\n<span class=\"line\"><span><<span><span>footer<span><span>>...</<span><span>footer<span><span>><span><span><code><pre><div><p>如果 <code>$attrs<code> 被显式绑定，则不会有警告：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>header<span><span>>...</<span><span>header<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 25, "_doc_id": "25_1277687099501042579"}}
{"doc_id": "26_478576025250697038", "text": "class=\"line\"><span><<span><span>header<span><span>>...</<span><span>header<span><span>><span><span>\n<span class=\"line highlighted\"><span><<span><span>main<span><span> v-bind<span><span>=<span><span>\"<span><span>$attrs<span><span>\"<span><span>>...</<span><span>main<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 26, "_doc_id": "26_478576025250697038"}}
{"doc_id": "27_1310929412612030375", "text": "n><span>\"<span><span>$attrs<span><span>\"<span><span>>...</<span><span>main<span><span>><span><span>\n<span class=\"line\"><span><<span><span>footer<span><span>>...</<span><span>footer<span><span>><span><span><code><pre><div><h2 id=\"accessing-fallthrough-attributes-in-javascript\">在 JavaScript 中访问透传 Attributes <a class=\"header-anchor\" href=\"#accessing-fallthrough-attributes-in-javascript\">​<a><h2><div class=\"composition-api\"><p>如果需要，", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 27, "_doc_id": "27_1310929412612030375"}}
{"doc_id": "28_2375766932655020739", "text": "href=\"#accessing-fallthrough-attributes-in-javascript\">​<a><h2><div class=\"composition-api\"><p>如果需要，你可以在 <code><script setup><code> 中使用 <code>useAttrs()<code> API 来访问一个组件的所有透传 attribute：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { useAttrs } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 28, "_doc_id": "28_2375766932655020739"}}
{"doc_id": "29_3902334199975340889", "text": "t<span><span> { useAttrs } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> attrs<span><span> =<span><span> useAttrs<span><span>()<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 29, "_doc_id": "29_3902334199975340889"}}
{"doc_id": "30_2669635146763188430", "text": "s=\"line\"><span>const<span><span> attrs<span><span> =<span><span> useAttrs<span><span>()<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><p>如果没有使用 <code><script setup><code>，<code>attrs<code> 会作为 <code>setup()<code> 上下文对象的一个属性暴露：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 30, "_doc_id": "30_2669635146763188430"}}
{"doc_id": "31_7275232369446233633", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> setup<span><span>(<span><span>props<span><span>, <span><span>ctx<span><span>) {<span><span>\n<span class=\"line\"><span> // 透传 attribute 被暴露为 ctx.attrs<span><span>\n<span class=\"line\"><span> console.<span><span>log<span><span>(ctx.attrs)<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 31, "_doc_id": "31_7275232369446233633"}}
{"doc_id": "32_5803736118797366", "text": "console.<span><span>log<span><span>(ctx.attrs)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>需要注意的是，虽然这里的 <code>attrs<code> 对象总是反映为最新的透传 attribute，但它并不是响应式的 (考虑到性能因素)。你不能通过侦听器去监听它的变化。如果你需要响应性，可以使用 prop。或者你也可以使用 <code>onUpdated()<code> 使得在每次更新时结合最新的 <code>attrs<code> 执行副作用。<p><div><div class=\"options-api\"><p>如果需要，你可以通过 <code>$attrs<code> 这个实例属性来访问组件的所有透传 attribute：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 32, "_doc_id": "32_5803736118797366"}}
{"doc_id": "33_5152623560546120179", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> created<span><span>() {<span><span>\n<span class=\"line\"><span> console.<span><span>log<span><span>(<span><span>this<span><span>.$attrs)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/components/attrs.html", "title": "透传 Attributes", "doc_id": "0d1757861491474a909ee2dc89858704", "content_type": "web_page", "word_count": 473, "chunk_index": 33, "_doc_id": "33_5152623560546120179"}}
{"doc_id": "0_2612167172246208728", "text": "<div><div><h1 id=\"slots\">插槽 Slots <a class=\"header-anchor\" href=\"#slots\">​<a><h1><blockquote><p>此章节假设你已经看过了<a href=\"/guide/essentials/component-basics.html\">组件基础<a>。若你还不了解组件是什么，请先阅读该章节。<p><blockquote><h2 id=\"slot-content-and-outlet\">插槽内容与出口 <a class=\"header-anchor\" href=\"#slot-content-and-outlet\">​<a><h2><p>在之前的章节中，我们已经了解到组件能够接收任意类型的 JavaScript 值作为 props，但组件要如何接收模板内容呢？在某些场景中，我们可能想要为子组件传递一些模板片段，让子组件在它们的组件中渲染这些片段。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 0, "_doc_id": "0_2612167172246208728"}}
{"doc_id": "1_1820952586860339980", "text": "中，我们已经了解到组件能够接收任意类型的 JavaScript 值作为 props，但组件要如何接收模板内容呢？在某些场景中，我们可能想要为子组件传递一些模板片段，让子组件在它们的组件中渲染这些片段。<p><p>举例来说，这里有一个 <code><FancyButton><code> 组件，可以像这样使用：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>FancyButton<span><span>><span><span>\n<span class=\"line highlighted\"><span> Click me! <span><span><!-- 插槽内容 --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 1, "_doc_id": "1_1820952586860339980"}}
{"doc_id": "2_5082987607370797357", "text": "><span><span>\n<span class=\"line highlighted\"><span> Click me! <span><span><!-- 插槽内容 --><span><span>\n<span class=\"line\"><span></<span><span>FancyButton<span><span>><span><span><code><pre><div><p>而 <code><FancyButton><code> 的模板是这样的：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span> class<span><span>=<span><span>\"fancy-btn\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 2, "_doc_id": "2_5082987607370797357"}}
{"doc_id": "3_3057525729266976668", "text": "><<span><span>button<span><span> class<span><span>=<span><span>\"fancy-btn\"<span><span>><span><span>\n<span class=\"line highlighted\"><span> <<span><span>slot<span><span>></<span><span>slot<span><span>> <span><span><!-- 插槽出口 --><span><span>\n<span class=\"line\"><span></<span><span>button<span><span>><span><span><code><pre><div><p><code><slot><code> 元素是一个<strong>插槽出口<strong> (slot outlet)，标示了父元素提供的<strong>插槽内容<strong> (slot content) 将在哪里被渲染。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 3, "_doc_id": "3_3057525729266976668"}}
{"doc_id": "4_7256300376872166431", "text": "<code> 元素是一个<strong>插槽出口<strong> (slot outlet)，标示了父元素提供的<strong>插槽内容<strong> (slot content) 将在哪里被渲染。<p><p> <p><p>最终渲染出的 DOM 是这样：<p><div class=\"language-html\"> <span class=\"lang\">html<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span> class<span><span>=<span><span>\"fancy-btn\"<span><span>>Click me!</<span><span>button<span><span>><span><span><code><pre><div><p>通过使用插槽，<code><FancyButton><code> 仅负责渲染外层的 <code><button><code> (以及相应的样式)，而其内部的内容由父组件提供。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 4, "_doc_id": "4_7256300376872166431"}}
{"doc_id": "5_4662270320587612061", "text": "<pre><div><p>通过使用插槽，<code><FancyButton><code> 仅负责渲染外层的 <code><button><code> (以及相应的样式)，而其内部的内容由父组件提供。<p><p>理解插槽的另一种方式是和下面的 JavaScript 函数作类比，其概念是类似的：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 父元素传入插槽内容<span><span>\n<span class=\"line\"><span>FancyButton<span><span>(<span><span>'Click me!'<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// FancyButton 在自己的模板中渲染插槽内容<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 5, "_doc_id": "5_4662270320587612061"}}
{"doc_id": "6_441024895909192690", "text": "><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// FancyButton 在自己的模板中渲染插槽内容<span><span>\n<span class=\"line\"><span>function<span><span> FancyButton<span><span>(<span><span>slotContent<span><span>) {<span><span>\n<span class=\"line\"><span> return<span><span> `<button class=\"fancy-btn\"><span><span>\n<span class=\"line\"><span> ${<span><span>slotContent<span><span>}<span><span>\n<span class=\"line\"><span> </button>`<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 6, "_doc_id": "6_441024895909192690"}}
{"doc_id": "7_2521013449603793169", "text": "${<span><span>slotContent<span><span>}<span><span>\n<span class=\"line\"><span> </button>`<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>插槽内容可以是任意合法的模板内容，不局限于文本。例如我们可以传入多个元素，甚至是组件：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>FancyButton<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 7, "_doc_id": "7_2521013449603793169"}}
{"doc_id": "8_8463249108659257948", "text": "thub-dark vp-code\"><code><span class=\"line\"><span><<span><span>FancyButton<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>span<span><span> style<span><span>=<span><span>\"color:red\"<span><span>>Click me!</<span><span>span<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>AwesomeIcon<span><span> name<span><span>=<span><span>\"plus\"<span><span> /><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 8, "_doc_id": "8_8463249108659257948"}}
{"doc_id": "9_5047478743245750948", "text": "<<span><span>AwesomeIcon<span><span> name<span><span>=<span><span>\"plus\"<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>FancyButton<span><span>><span><span><code><pre><div><p>通过使用插槽，<code><FancyButton><code> 组件更加灵活和具有可复用性。现在组件可以用在不同的地方渲染各异的内容，但同时还保证都具有相同的样式。<p><p>Vue 组件的插槽机制是受<a href=\"https://developer.mozilla.org/en-US/docs/Web/HTML/Element/slot\" target=\"_blank\">原生 Web Component <code><slot><code> 元素<a>的启发而诞生，同时还做了一些功能拓展，这些拓展的功能我们后面会学习到。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 9, "_doc_id": "9_5047478743245750948"}}
{"doc_id": "10_8218686546726675249", "text": "t/slot\" target=\"_blank\">原生 Web Component <code><slot><code> 元素<a>的启发而诞生，同时还做了一些功能拓展，这些拓展的功能我们后面会学习到。<p><h2 id=\"render-scope\">渲染作用域 <a class=\"header-anchor\" href=\"#render-scope\">​<a><h2><p>插槽内容可以访问到父组件的数据作用域，因为插槽内容本身是在父组件模板中定义的。举例来说：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>span<span><span>>{{ message }}</<span><span>span<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 10, "_doc_id": "10_8218686546726675249"}}
{"doc_id": "11_3772340381748381098", "text": "\"line\"><span><<span><span>span<span><span>>{{ message }}</<span><span>span<span><span>><span><span>\n<span class=\"line\"><span><<span><span>FancyButton<span><span>>{{ message }}</<span><span>FancyButton<span><span>><span><span><code><pre><div><p>这里的两个 <span><code>{{ message }}<code><span> 插值表达式渲染的内容都是一样的。<p><p>插槽内容<strong>无法访问<strong>子组件的数据。Vue 模板中的表达式只能访问其定义时所处的作用域，这和 JavaScript 的词法作用域规则是一致的。换言之：<p><blockquote><p>父组件模板中的表达式只能访问父组件的作用域；子组件模板中的表达式只能访问子组件的作用域。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 11, "_doc_id": "11_3772340381748381098"}}
{"doc_id": "12_2617403192001882382", "text": "所处的作用域，这和 JavaScript 的词法作用域规则是一致的。换言之：<p><blockquote><p>父组件模板中的表达式只能访问父组件的作用域；子组件模板中的表达式只能访问子组件的作用域。<p><blockquote><h2 id=\"fallback-content\">默认内容 <a class=\"header-anchor\" href=\"#fallback-content\">​<a><h2><p>在外部没有提供任何内容的情况下，可以为插槽指定默认内容。比如有这样一个 <code><SubmitButton><code> 组件：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span> type<span><span>=<span><span>\"submit\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 12, "_doc_id": "12_2617403192001882382"}}
{"doc_id": "13_4691609522296481674", "text": "span><<span><span>button<span><span> type<span><span>=<span><span>\"submit\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span>></<span><span>slot<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 13, "_doc_id": "13_4691609522296481674"}}
{"doc_id": "14_4451867424968246545", "text": "<span class=\"line\"><span> <<span><span>slot<span><span>></<span><span>slot<span><span>><span><span>\n<span class=\"line\"><span></<span><span>button<span><span>><span><span><code><pre><div><p>如果我们想在父组件没有提供任何插槽内容时在 <code><button><code> 内渲染“Submit”，只需要将“Submit”写在 <code><slot><code> 标签之间来作为默认内容：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span> type<span><span>=<span><span>\"submit\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 14, "_doc_id": "14_4451867424968246545"}}
{"doc_id": "15_5508565170476550040", "text": "span><<span><span>button<span><span> type<span><span>=<span><span>\"submit\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span>><span><span>\n<span class=\"line highlighted\"><span> Submit <span><span><!-- 默认内容 --><span><span>\n<span class=\"line\"><span> </<span><span>slot<span><span>><span><span>\n<span class=\"line\"><span></<span><span>button<span><span>><span><span><code><pre><div><p>现在，当我们在父组件中使用 <code><SubmitButton><code> 且没有提供任何插槽内容时：<p><p>“Submit”将会被作为默认内容渲染：<p><div", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 15, "_doc_id": "15_5508565170476550040"}}
{"doc_id": "16_193215304439877225", "text": "pre><div><p>现在，当我们在父组件中使用 <code><SubmitButton><code> 且没有提供任何插槽内容时：<p><p>“Submit”将会被作为默认内容渲染：<p><div class=\"language-html\"> <span class=\"lang\">html<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span> type<span><span>=<span><span>\"submit\"<span><span>>Submit</<span><span>button<span><span>><span><span><code><pre><div><p>但如果我们提供了插槽内容：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 16, "_doc_id": "16_193215304439877225"}}
{"doc_id": "17_1694824141776352732", "text": "uage-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>SubmitButton<span><span>>Save</<span><span>SubmitButton<span><span>><span><span><code><pre><div><p>那么被显式提供的内容会取代默认内容：<p><div class=\"language-html\"> <span class=\"lang\">html<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 17, "_doc_id": "17_1694824141776352732"}}
{"doc_id": "18_8189129283479816442", "text": "re class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span> type<span><span>=<span><span>\"submit\"<span><span>>Save</<span><span>button<span><span>><span><span><code><pre><div><h2 id=\"named-slots\">具名插槽 <a class=\"header-anchor\" href=\"#named-slots\">​<a><h2><p>有时在一个组件中包含多个插槽出口是很有用的。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 18, "_doc_id": "18_8189129283479816442"}}
{"doc_id": "19_3751714379602986259", "text": "id=\"named-slots\">具名插槽 <a class=\"header-anchor\" href=\"#named-slots\">​<a><h2><p>有时在一个组件中包含多个插槽出口是很有用的。举例来说，在一个 <code><BaseLayout><code> 组件中，有如下模板：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> class<span><span>=<span><span>\"container\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>header<span><span>><span><span>\n<span class=\"line\"><span> <!-- 标题内容放这里 --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 19, "_doc_id": "19_3751714379602986259"}}
{"doc_id": "20_7043848162580366249", "text": "<<span><span>header<span><span>><span><span>\n<span class=\"line\"><span> <!-- 标题内容放这里 --><span><span>\n<span class=\"line\"><span> </<span><span>header<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>main<span><span>><span><span>\n<span class=\"line\"><span> <!-- 主要内容放这里 --><span><span>\n<span class=\"line\"><span> </<span><span>main<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span> <!-- 底部内容放这里 --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 20, "_doc_id": "20_7043848162580366249"}}
{"doc_id": "21_4758295454222331043", "text": "<<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span> <!-- 底部内容放这里 --><span><span>\n<span class=\"line\"><span> </<span><span>footer<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 21, "_doc_id": "21_4758295454222331043"}}
{"doc_id": "22_6980563681549693772", "text": "!-- 底部内容放这里 --><span><span>\n<span class=\"line\"><span> </<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span></<span><span>div<span><span>><span><span><code><pre><div><p>对于这种场景，<code><slot><code> 元素可以有一个特殊的 attribute <code>name<code>，用来给各个插槽分配唯一的 ID，以确定每一处要渲染的内容：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> class<span><span>=<span><span>\"container\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 22, "_doc_id": "22_6980563681549693772"}}
{"doc_id": "23_1522760028333411565", "text": "pan><<span><span>div<span><span> class<span><span>=<span><span>\"container\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>header<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span> name<span><span>=<span><span>\"header\"<span><span>></<span><span>slot<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>header<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>main<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 23, "_doc_id": "23_1522760028333411565"}}
{"doc_id": "24_3377685496559527482", "text": "eader<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>main<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span>></<span><span>slot<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>main<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span> name<span><span>=<span><span>\"footer\"<span><span>></<span><span>slot<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 24, "_doc_id": "24_3377685496559527482"}}
{"doc_id": "25_7672024035451430087", "text": "span> name<span><span>=<span><span>\"footer\"<span><span>></<span><span>slot<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span></<span><span>div<span><span>><span><span><code><pre><div><p>这类带 <code>name<code> 的插槽被称为具名插槽 (named slots)。没有提供 <code>name<code> 的 <code><slot><code> 出口会隐式地命名为“default”。<p><p>在父组件中使用 <code><BaseLayout><code> 时，我们需要一种方式将多个插槽内容传入到各自目标插槽的出口。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 25, "_doc_id": "25_7672024035451430087"}}
{"doc_id": "26_2806008495220502826", "text": "slot><code> 出口会隐式地命名为“default”。<p><p>在父组件中使用 <code><BaseLayout><code> 时，我们需要一种方式将多个插槽内容传入到各自目标插槽的出口。此时就需要用到<strong>具名插槽<strong>了：<p><p>要为具名插槽传入内容，我们需要使用一个含 <code>v-slot<code> 指令的 <code><template><code> 元素，并将目标插槽的名字传给该指令：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>BaseLayout<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>template<span><span> v-slot:header<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 26, "_doc_id": "26_2806008495220502826"}}
{"doc_id": "27_298618691456181575", "text": "<span class=\"line\"><span> <<span><span>template<span><span> v-slot:header<span><span>><span><span>\n<span class=\"line\"><span> <!-- header 插槽的内容放这里 --><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 27, "_doc_id": "27_298618691456181575"}}
{"doc_id": "28_7558365644413112402", "text": "插槽的内容放这里 --><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span></<span><span>BaseLayout<span><span>><span><span><code><pre><div><p><code>v-slot<code> 有对应的简写 <code>#<code>，因此 <code><template v-slot:header><code> 可以简写为 <code><template #header><code>。其意思就是“将这部分模板片段传入子组件的 header 插槽中”。<p><p> <p><p>下面我们给出完整的、向 <code><BaseLayout><code> 传递插槽内容的代码，指令均使用的是缩写形式：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>BaseLayout<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 28, "_doc_id": "28_7558365644413112402"}}
{"doc_id": "29_3261621805291761491", "text": "ithub-dark vp-code\"><code><span class=\"line\"><span><<span><span>BaseLayout<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>header<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>h1<span><span>>Here might be a page title</<span><span>h1<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 29, "_doc_id": "29_3261621805291761491"}}
{"doc_id": "30_4995213617788304869", "text": "<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>default<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>A paragraph for the main content.</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>And another one.</<span><span>p<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 30, "_doc_id": "30_4995213617788304869"}}
{"doc_id": "31_8223053091218597382", "text": "s=\"line\"><span> <<span><span>p<span><span>>And another one.</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>Here's some contact info</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 31, "_doc_id": "31_8223053091218597382"}}
{"doc_id": "32_4469180609353397453", "text": "<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span></<span><span>BaseLayout<span><span>><span><span><code><pre><div><p>当一个组件同时接收默认插槽和具名插槽时，所有位于顶级的非 <code><template><code> 节点都被隐式地视为默认插槽的内容。所以上面也可以写成：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>BaseLayout<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 32, "_doc_id": "32_4469180609353397453"}}
{"doc_id": "33_5124639432426565497", "text": "ithub-dark vp-code\"><code><span class=\"line\"><span><<span><span>BaseLayout<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>header<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>h1<span><span>>Here might be a page title</<span><span>h1<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <!-- 隐式的默认插槽 --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 33, "_doc_id": "33_5124639432426565497"}}
{"doc_id": "34_9099971946167761219", "text": "span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <!-- 隐式的默认插槽 --><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>A paragraph for the main content.</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>And another one.</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>footer<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 34, "_doc_id": "34_9099971946167761219"}}
{"doc_id": "35_3800390386362704329", "text": "class=\"line\"><span> <<span><span>template<span><span> #<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>Here's some contact info</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 35, "_doc_id": "35_3800390386362704329"}}
{"doc_id": "36_4625231570211305035", "text": "<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span></<span><span>BaseLayout<span><span>><span><span><code><pre><div><p>现在 <code><template><code> 元素中的所有内容都将被传递到相应的插槽。最终渲染出的 HTML 如下：<p><div class=\"language-html\"> <span class=\"lang\">html<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> class<span><span>=<span><span>\"container\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 36, "_doc_id": "36_4625231570211305035"}}
{"doc_id": "37_2835503834306729370", "text": "pan><<span><span>div<span><span> class<span><span>=<span><span>\"container\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>header<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>h1<span><span>>Here might be a page title</<span><span>h1<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>header<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>main<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 37, "_doc_id": "37_2835503834306729370"}}
{"doc_id": "38_1421600089181449272", "text": "eader<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>main<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>A paragraph for the main content.</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>And another one.</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>main<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>footer<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 38, "_doc_id": "38_1421600089181449272"}}
{"doc_id": "39_3455904084583977695", "text": "ain<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>Here's some contact info</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>footer<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 39, "_doc_id": "39_3455904084583977695"}}
{"doc_id": "40_1279466876910602776", "text": ">p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span></<span><span>div<span><span>><span><span><code><pre><div><p>使用 JavaScript 函数来类比可能更有助于你来理解具名插槽：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 传入不同的内容给不同名字的插槽<span><span>\n<span class=\"line\"><span>BaseLayout<span><span>({<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 40, "_doc_id": "40_1279466876910602776"}}
{"doc_id": "41_2712858874297428136", "text": "><span>// 传入不同的内容给不同名字的插槽<span><span>\n<span class=\"line\"><span>BaseLayout<span><span>({<span><span>\n<span class=\"line\"><span> header: <span><span>`...`<span><span>,<span><span>\n<span class=\"line\"><span> default: <span><span>`...`<span><span>,<span><span>\n<span class=\"line\"><span> footer: <span><span>`...`<span><span>\n<span class=\"line\"><span>})<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// <BaseLayout> 渲染插槽内容到对应位置<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 41, "_doc_id": "41_2712858874297428136"}}
{"doc_id": "42_2806044476242891823", "text": "n><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// <BaseLayout> 渲染插槽内容到对应位置<span><span>\n<span class=\"line\"><span>function<span><span> BaseLayout<span><span>(<span><span>slots<span><span>) {<span><span>\n<span class=\"line\"><span> return<span><span> `<div class=\"container\"><span><span>\n<span class=\"line\"><span> <header>${<span><span>slots<span><span>.<span><span>header<span><span>}</header><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 42, "_doc_id": "42_2806044476242891823"}}
{"doc_id": "43_6591011192919315763", "text": "<span> <header>${<span><span>slots<span><span>.<span><span>header<span><span>}</header><span><span>\n<span class=\"line\"><span> <main>${<span><span>slots<span><span>.<span><span>default<span><span>}</main><span><span>\n<span class=\"line\"><span> <footer>${<span><span>slots<span><span>.<span><span>footer<span><span>}</footer><span><span>\n<span class=\"line\"><span> </div>`<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 43, "_doc_id": "43_6591011192919315763"}}
{"doc_id": "44_3766939819233703522", "text": ".<span><span>footer<span><span>}</footer><span><span>\n<span class=\"line\"><span> </div>`<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><h2 id=\"conditional-slots\">条件插槽 <a class=\"header-anchor\" href=\"#conditional-slots\">​<a><h2><p>有时你需要根据内容是否被传入了插槽来渲染某些内容。<p><p>你可以结合使用 <a href=\"/api/component-instance.html#slots\">$slots<a> 属性与 <a href=\"/guide/essentials/conditional.html#v-if\">v-if<a> 来实现。<p><p>在下面的示例中，我们定义了一个卡片组件，它拥有三个条件插槽：<code>header<code>、<code>footer<code> 和 <code>default<code>。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 44, "_doc_id": "44_3766939819233703522"}}
{"doc_id": "45_6608695541065287063", "text": "来实现。<p><p>在下面的示例中，我们定义了一个卡片组件，它拥有三个条件插槽：<code>header<code>、<code>footer<code> 和 <code>default<code>。 当 header、footer 或 default 的内容存在时，我们希望包装它以提供额外的样式：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> class<span><span>=<span><span>\"card\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 45, "_doc_id": "45_6608695541065287063"}}
{"doc_id": "46_4589272685073683235", "text": "\"><span> <<span><span>div<span><span> class<span><span>=<span><span>\"card\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> v-if<span><span>=<span><span>\"<span><span>$slots.header<span><span>\"<span><span> class<span><span>=<span><span>\"card-header\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span> name<span><span>=<span><span>\"header\"<span><span> /><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 46, "_doc_id": "46_4589272685073683235"}}
{"doc_id": "47_2894293287210363795", "text": "er\"<span><span> /><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> <span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> v-if<span><span>=<span><span>\"<span><span>$slots.default<span><span>\"<span><span> class<span><span>=<span><span>\"card-content\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span> /><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 47, "_doc_id": "47_2894293287210363795"}}
{"doc_id": "48_3086395988139286957", "text": "lot<span><span> /><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> <span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> v-if<span><span>=<span><span>\"<span><span>$slots.footer<span><span>\"<span><span> class<span><span>=<span><span>\"card-footer\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span> name<span><span>=<span><span>\"footer\"<span><span> /><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 48, "_doc_id": "48_3086395988139286957"}}
{"doc_id": "49_6770078743520446811", "text": "pan> <<span><span>slot<span><span> name<span><span>=<span><span>\"footer\"<span><span> /><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span><code><pre><div><p><a href=\"https://play.vuejs.org/#eNqVVMtu2zAQ/BWCLZBLIjVoTq4aoA1yaA9t0eaoCy2tJcYUSZCUKyPwv2dJioplOw4C+EDuzM4+ONYT/aZ1tumBLmhhK8O1IxZcr29LyTutjCN3zNRkZVRHLrLcXzz9opRFHvnIxIuDTgvmAG+EFJ", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 49, "_doc_id": "49_6770078743520446811"}}
{"doc_id": "50_6807311819869698840", "text": "", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 50, "_doc_id": "50_6807311819869698840"}}
{"doc_id": "51_3442277221299267711", "text": "qBj1YoZ7NosJLOEq5S9OXtPZtI1gFSppx8engUHs+vVhq9eVhq9ORRrXdpRyseSqfo6SmmnONK6XTw9yis24q448wXSG+0VAb3sSDXeiBoDV6TpWDV+ktENatrdMGCfAoBfL1JYNzzpINJjVFoJ9yKUKho19ul6OFQ6UYPx1rjIpPYeXIc/vXCgjetawzbni0dPnhhJ3T3DMVSruI=\" target=\"_blank\">在演练场中尝试一下<a><p><h2 id=\"dynamic-slot-names\">动态插槽名 <a class=\"header-anchor\" href=\"#dynamic-slot-names\">​<a><h2><p><a href=\"/guide/essentials/template-syntax.html#dynamic-arguments\">动态指令参数<a>在 <code>v-slot<code> 上也是有效的，", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 51, "_doc_id": "51_3442277221299267711"}}
{"doc_id": "52_8497716788437471883", "text": "ref=\"/guide/essentials/template-syntax.html#dynamic-arguments\">动态指令参数<a>在 <code>v-slot<code> 上也是有效的，即可以定义下面这样的动态插槽名：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>base-layout<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>template<span><span> v-slot:<span><span>[<span><span>dynamicSlotName<span><span>]><span><span>\n<span class=\"line\"><span> ...<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 52, "_doc_id": "52_8497716788437471883"}}
{"doc_id": "53_2109635592528369860", "text": "an>[<span><span>dynamicSlotName<span><span>]><span><span>\n<span class=\"line\"><span> ...<span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <!-- 缩写为 --><span><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #[<span><span>dynamicSlotName<span><span>]><span><span>\n<span class=\"line\"><span> ...<span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 53, "_doc_id": "53_2109635592528369860"}}
{"doc_id": "54_2928924391463601391", "text": "e\"><span> ...<span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span></<span><span>base-layout<span><span>><span><span><code><pre><div><p>注意这里的表达式和动态指令参数受相同的<a href=\"/guide/essentials/template-syntax.html#dynamic-argument-syntax-constraints\">语法限制<a>。<p><h2 id=\"scoped-slots\">作用域插槽 <a class=\"header-anchor\" href=\"#scoped-slots\">​<a><h2><p>在上面的<a href=\"#render-scope\">渲染作用域<a>中我们讨论到，插槽的内容无法访问到子组件的状态。<p><p>然而在某些场景下插槽的内容可能想要同时使用父组件域内和子组件域内的数据。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 54, "_doc_id": "54_2928924391463601391"}}
{"doc_id": "55_1292979515305606038", "text": "面的<a href=\"#render-scope\">渲染作用域<a>中我们讨论到，插槽的内容无法访问到子组件的状态。<p><p>然而在某些场景下插槽的内容可能想要同时使用父组件域内和子组件域内的数据。要做到这一点，我们需要一种方法来让子组件在渲染时将一部分数据提供给插槽。<p><p>我们也确实有办法这么做！可以像对组件传递 props 那样，向一个插槽的出口上传递 attributes：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- <MyComponent> 的模板 --><span><span>\n<span class=\"line\"><span><<span><span>div<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 55, "_doc_id": "55_1292979515305606038"}}
{"doc_id": "56_2924770071152049663", "text": "MyComponent> 的模板 --><span><span>\n<span class=\"line\"><span><<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span> :<span><span>text<span><span>=<span><span>\"<span><span>greetingMessage<span><span>\"<span><span> :<span><span>count<span><span>=<span><span>\"<span><span>1<span><span>\"<span><span>></<span><span>slot<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 56, "_doc_id": "56_2924770071152049663"}}
{"doc_id": "57_4566623013946335809", "text": "an>=<span><span>\"<span><span>1<span><span>\"<span><span>></<span><span>slot<span><span>><span><span>\n<span class=\"line\"><span></<span><span>div<span><span>><span><span><code><pre><div><p>当需要接收插槽 props 时，默认插槽和具名插槽的使用方式有一些小区别。下面我们将先展示默认插槽如何接受 props，通过子组件标签上的 <code>v-slot<code> 指令，直接接收到了一个插槽 props 对象：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyComponent<span><span> v-slot<span><span>=<span><span>\"<span><span>slotProps<span><span>\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 57, "_doc_id": "57_4566623013946335809"}}
{"doc_id": "58_8951018244585701018", "text": "><span> v-slot<span><span>=<span><span>\"<span><span>slotProps<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> {{ slotProps.text }} {{ slotProps.count }}<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 58, "_doc_id": "58_8951018244585701018"}}
{"doc_id": "59_5430573477658447810", "text": "span>><span><span>\n<span class=\"line\"><span> {{ slotProps.text }} {{ slotProps.count }}<span><span>\n<span class=\"line\"><span></<span><span>MyComponent<span><span>><span><span><code><pre><div><p> <p><p>子组件传入插槽的 props 作为了 <code>v-slot<code> 指令的值，可以在插槽内的表达式中访问。<p><p>你可以将作用域插槽类比为一个传入子组件的函数。子组件会将相应的 props 作为参数传给它：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>MyComponent<span><span>({<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 59, "_doc_id": "59_5430573477658447810"}}
{"doc_id": "60_3273410103538245350", "text": "ss=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>MyComponent<span><span>({<span><span>\n<span class=\"line\"><span> // 类比默认插槽，将其想成一个函数<span><span>\n<span class=\"line\"><span> default<span><span>: (<span><span>slotProps<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> return<span><span> `${<span><span>slotProps<span><span>.<span><span>text<span><span>} ${<span><span>slotProps<span><span>.<span><span>count<span><span>}`<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 60, "_doc_id": "60_3273410103538245350"}}
{"doc_id": "61_8000041002890462014", "text": "n>text<span><span>} ${<span><span>slotProps<span><span>.<span><span>count<span><span>}`<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>})<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>function<span><span> MyComponent<span><span>(<span><span>slots<span><span>) {<span><span>\n<span class=\"line\"><span> const<span><span> greetingMessage<span><span> =<span><span> 'hello'<span><span>\n<span class=\"line\"><span> return<span><span> `<div>${<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 61, "_doc_id": "61_8000041002890462014"}}
{"doc_id": "62_8118136902086794935", "text": "=<span><span> 'hello'<span><span>\n<span class=\"line\"><span> return<span><span> `<div>${<span><span>\n<span class=\"line\"><span> // 在插槽函数调用时传入 props<span><span>\n<span class=\"line\"><span> slots<span><span>.<span><span>default<span><span>({ text: <span><span>greetingMessage<span><span>, count: <span><span>1<span><span> })<span><span>\n<span class=\"line\"><span> }</div>`<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 62, "_doc_id": "62_8118136902086794935"}}
{"doc_id": "63_7511632171638303715", "text": "an>, count: <span><span>1<span><span> })<span><span>\n<span class=\"line\"><span> }</div>`<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>实际上，这已经和作用域插槽的最终代码编译结果、以及手动编写<a href=\"/guide/extras/render-function.html\">渲染函数<a>时使用作用域插槽的方式非常类似了。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 63, "_doc_id": "63_7511632171638303715"}}
{"doc_id": "64_9097771443262379112", "text": "p>实际上，这已经和作用域插槽的最终代码编译结果、以及手动编写<a href=\"/guide/extras/render-function.html\">渲染函数<a>时使用作用域插槽的方式非常类似了。<p><p><code>v-slot=\"slotProps\"<code> 可以类比这里的函数签名，和函数的参数类似，我们也可以在 <code>v-slot<code> 中使用解构：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyComponent<span><span> v-slot<span><span>=<span><span>\"<span><span>{ text, count }<span><span>\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 64, "_doc_id": "64_9097771443262379112"}}
{"doc_id": "65_1183018282829355120", "text": "> v-slot<span><span>=<span><span>\"<span><span>{ text, count }<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> {{ text }} {{ count }}<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 65, "_doc_id": "65_1183018282829355120"}}
{"doc_id": "66_7316452978105213620", "text": "<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> {{ text }} {{ count }}<span><span>\n<span class=\"line\"><span></<span><span>MyComponent<span><span>><span><span><code><pre><div><h3 id=\"named-scoped-slots\">具名作用域插槽 <a class=\"header-anchor\" href=\"#named-scoped-slots\">​<a><h3><p>具名作用域插槽的工作方式也是类似的，插槽 props 可以作为 <code>v-slot<code> 指令的值被访问到：<code>v-slot:name=\"slotProps\"<code>。当使用缩写时是这样：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyComponent<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 66, "_doc_id": "66_7316452978105213620"}}
{"doc_id": "67_8192390734901011593", "text": "thub-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyComponent<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>header<span><span>=<span><span>\"<span><span>headerProps<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> {{ headerProps }}<span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 67, "_doc_id": "67_8192390734901011593"}}
{"doc_id": "68_7350275995834116325", "text": "<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>default<span><span>=<span><span>\"<span><span>defaultProps<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> {{ defaultProps }}<span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 68, "_doc_id": "68_7350275995834116325"}}
{"doc_id": "69_665753166145881720", "text": "<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>footer<span><span>=<span><span>\"<span><span>footerProps<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> {{ footerProps }}<span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 69, "_doc_id": "69_665753166145881720"}}
{"doc_id": "70_904290198063612116", "text": "ooterProps }}<span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span></<span><span>MyComponent<span><span>><span><span><code><pre><div><p>向具名插槽中传入 props：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>slot<span><span> name<span><span>=<span><span>\"header\"<span><span> message<span><span>=<span><span>\"hello\"<span><span>></<span><span>slot<span><span>><span><span><code><pre><div><p>注意插槽上的 <code>name<code> 是一个 Vue 特别保留的 attribute，不会作为 props 传递给插槽。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 70, "_doc_id": "70_904290198063612116"}}
{"doc_id": "71_1137421186178600342", "text": "an>><span><span><code><pre><div><p>注意插槽上的 <code>name<code> 是一个 Vue 特别保留的 attribute，不会作为 props 传递给插槽。因此最终 <code>headerProps<code> 的结果是 <code>{ message: 'hello' }<code>。<p><p>如果你同时使用了具名插槽与默认插槽，则需要为默认插槽使用显式的 <code><template><code> 标签。尝试直接为组件添加 <code>v-slot<code> 指令将导致编译错误。这是为了避免因默认插槽的 props 的作用域而困惑。举例：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- <MyComponent> template --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 71, "_doc_id": "71_1137421186178600342"}}
{"doc_id": "72_7967322839349837051", "text": "iki github-dark vp-code\"><code><span class=\"line\"><span><!-- <MyComponent> template --><span><span>\n<span class=\"line\"><span><<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span> :<span><span>message<span><span>=<span><span>\"<span><span>hello<span><span>\"<span><span>></<span><span>slot<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span> name<span><span>=<span><span>\"footer\"<span><span> /><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 72, "_doc_id": "72_7967322839349837051"}}
{"doc_id": "73_8950610865472731735", "text": "pan> <<span><span>slot<span><span> name<span><span>=<span><span>\"footer\"<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>div<span><span>><span><span><code><pre><div><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- 该模板无法编译 --><span><span>\n<span class=\"line\"><span><<span><span>MyComponent<span><span> v-slot<span><span>=<span><span>\"<span><span>{ message }<span><span>\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 73, "_doc_id": "73_8950610865472731735"}}
{"doc_id": "74_2136765512494850389", "text": "span> v-slot<span><span>=<span><span>\"<span><span>{ message }<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>{{ message }}</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span> <!-- message 属于默认插槽，此处不可用 --><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>{{ message }}</<span><span>p<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 74, "_doc_id": "74_2136765512494850389"}}
{"doc_id": "75_3232539912238555147", "text": "lass=\"line\"><span> <<span><span>p<span><span>>{{ message }}</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 75, "_doc_id": "75_3232539912238555147"}}
{"doc_id": "76_1352900998794500819", "text": "<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span></<span><span>MyComponent<span><span>><span><span><code><pre><div><p>为默认插槽使用显式的 <code><template><code> 标签有助于更清晰地指出 <code>message<code> 属性在其他插槽中不可用：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyComponent<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 76, "_doc_id": "76_1352900998794500819"}}
{"doc_id": "77_3226184358338039712", "text": "thub-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyComponent<span><span>><span><span>\n<span class=\"line\"><span> <!-- 使用显式的默认插槽 --><span><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>default<span><span>=<span><span>\"<span><span>{ message }<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>{{ message }}</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 77, "_doc_id": "77_3226184358338039712"}}
{"doc_id": "78_796234962905809230", "text": "<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>footer<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>Here's some contact info</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 78, "_doc_id": "78_796234962905809230"}}
{"doc_id": "79_5435478734730536287", "text": "<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span></<span><span>MyComponent<span><span>><span><span><code><pre><div><h3 id=\"fancy-list-example\">高级列表组件示例 <a class=\"header-anchor\" href=\"#fancy-list-example\">​<a><h3><p>你可能想问什么样的场景才适合用到作用域插槽，这里我们来看一个 <code><FancyList><code> 组件的例子。它会渲染一个列表，并同时会封装一些加载远端数据的逻辑、使用数据进行列表渲染、或者是像分页或无限滚动这样更进阶的功能。然而我们希望它能够保留足够的灵活性，将对单个列表元素内容和样式的控制权留给使用它的父组件。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 79, "_doc_id": "79_5435478734730536287"}}
{"doc_id": "80_7108243676027170247", "text": "染一个列表，并同时会封装一些加载远端数据的逻辑、使用数据进行列表渲染、或者是像分页或无限滚动这样更进阶的功能。然而我们希望它能够保留足够的灵活性，将对单个列表元素内容和样式的控制权留给使用它的父组件。我们期望的用法可能是这样的：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>FancyList<span><span> :<span><span>api-url<span><span>=<span><span>\"<span><span>url<span><span>\"<span><span> :<span><span>per-page<span><span>=<span><span>\"<span><span>10<span><span>\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 80, "_doc_id": "80_7108243676027170247"}}
{"doc_id": "81_4330204458476711598", "text": ":<span><span>per-page<span><span>=<span><span>\"<span><span>10<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>template<span><span> #<span><span>item<span><span>=<span><span>\"<span><span>{ body, username, likes }<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> class<span><span>=<span><span>\"item\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>{{ body }}</<span><span>p<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 81, "_doc_id": "81_4330204458476711598"}}
{"doc_id": "82_7471379873277379801", "text": "n class=\"line\"><span> <<span><span>p<span><span>>{{ body }}</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>by {{ username }} | {{ likes }} likes</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 82, "_doc_id": "82_7471379873277379801"}}
{"doc_id": "83_4884055315744255187", "text": "<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>template<span><span>><span><span>\n<span class=\"line\"><span></<span><span>FancyList<span><span>><span><span><code><pre><div><p>在 <code><FancyList><code> 之中，我们可以多次渲染 <code><slot><code> 并每次都提供不同的数据 (注意我们这里使用了 <code>v-bind<code> 来传递插槽的 props)：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>ul<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 83, "_doc_id": "83_4884055315744255187"}}
{"doc_id": "84_6507230389206157939", "text": "\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>ul<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>li<span><span> v-for<span><span>=<span><span>\"<span><span>item <span><span>in<span><span> items<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span> name<span><span>=<span><span>\"item\"<span><span> v-bind<span><span>=<span><span>\"<span><span>item<span><span>\"<span><span>></<span><span>slot<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 84, "_doc_id": "84_6507230389206157939"}}
{"doc_id": "85_4120351225051841746", "text": "=<span><span>\"<span><span>item<span><span>\"<span><span>></<span><span>slot<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>li<span><span>><span><span>\n<span class=\"line\"><span></<span><span>ul<span><span>><span><span><code><pre><div><h3 id=\"renderless-components\">无渲染组件 <a class=\"header-anchor\" href=\"#renderless-components\">​<a><h3><p>上面的 <code><FancyList><code> 案例同时封装了可重用的逻辑 (数据获取、分页等) 和视图输出，但也将部分视图输出通过作用域插槽交给了消费者组件来管理。<p><p>如果我们将这个概念拓展一下，可以想象的是，一些组件可能只包括了逻辑而不需要自己渲染内容，视图输出通过作用域插槽全权交给了消费者组件。", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 85, "_doc_id": "85_4120351225051841746"}}
{"doc_id": "86_8165841364465939907", "text": "但也将部分视图输出通过作用域插槽交给了消费者组件来管理。<p><p>如果我们将这个概念拓展一下，可以想象的是，一些组件可能只包括了逻辑而不需要自己渲染内容，视图输出通过作用域插槽全权交给了消费者组件。我们将这种类型的组件称为<strong>无渲染组件<strong>。<p><p>这里有一个无渲染组件的例子，一个封装了追踪当前鼠标位置逻辑的组件：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>MouseTracker<span><span> v-slot<span><span>=<span><span>\"<span><span>{ x, y }<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> Mouse is at: {{ x }}, {{ y }}<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 86, "_doc_id": "86_8165841364465939907"}}
{"doc_id": "87_9165839515917101886", "text": "span>\"<span><span>><span><span>\n<span class=\"line\"><span> Mouse is at: {{ x }}, {{ y }}<span><span>\n<span class=\"line\"><span></<span><span>MouseTracker<span><span>><span><span><code><pre><div><p>虽然这个模式很有趣，但大部分能用无渲染组件实现的功能都可以通过组合式 API 以另一种更高效的方式实现，并且还不会带来额外组件嵌套的开销。之后我们会在<a href=\"/guide/reusability/composables.html\">组合式函数<a>一章中介绍如何更高效地实现追踪鼠标位置的功能。<p><p>尽管如此，作用域插槽在需要<strong>同时<strong>封装逻辑、组合视图界面时还是很有用，就像上面的 <code><FancyList><code> 组件那样。<p><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/components/slots.html", "title": "插槽 Slots", "doc_id": "e39a44095b9349959414fb25ba09a934", "content_type": "web_page", "word_count": 1189, "chunk_index": 87, "_doc_id": "87_9165839515917101886"}}
{"doc_id": "0_4556440867082369321", "text": "<div><div><h1 id=\"provide-inject\">依赖注入 <a class=\"header-anchor\" href=\"#provide-inject\">​<a><h1><blockquote><p>此章节假设你已经看过了<a href=\"/guide/essentials/component-basics.html\">组件基础<a>。若你还不了解组件是什么，请先阅读该章节。<p><blockquote><h2 id=\"prop-drilling\">Prop 逐级透传问题 <a class=\"header-anchor\" href=\"#prop-drilling\">​<a><h2><p>通常情况下，当我们需要从父组件向子组件传递数据时，会使用 <a href=\"/guide/components/props.html\">props<a>。想象一下这样的结构：有一些多层级嵌套的组件，形成了一棵巨大的组件树，而某个深层的子组件需要一个较远的祖先组件中的部分数据。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 0, "_doc_id": "0_4556440867082369321"}}
{"doc_id": "1_6607825997689216660", "text": "/guide/components/props.html\">props<a>。想象一下这样的结构：有一些多层级嵌套的组件，形成了一棵巨大的组件树，而某个深层的子组件需要一个较远的祖先组件中的部分数据。在这种情况下，如果仅使用 props 则必须将其沿着组件链逐级传递下去，这会非常麻烦：<p><p> <p><p>注意，虽然这里的 <code><Footer><code> 组件可能根本不关心这些 props，但为了使 <code><DeepChild><code> 能访问到它们，仍然需要定义并向下传递。如果组件链路非常长，可能会影响到更多这条路上的组件。这一问题被称为“prop 逐级透传”，显然是我们希望尽量避免的情况。<p><p><code>provide<code> 和 <code>inject<code> 可以帮助我们解决这一问题 <a href=\"#footnote-1\">[1]<a> 。一个父组件相对于其所有的后代组件，会作为<strong>依赖提供者<strong>。任何后代的组件树，无论层级有多深，都可以<strong>注入<strong>由父组件提供给整条链路的依赖。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 1, "_doc_id": "1_6607825997689216660"}}
{"doc_id": "2_9115300076605782602", "text": "<a> 。一个父组件相对于其所有的后代组件，会作为<strong>依赖提供者<strong>。任何后代的组件树，无论层级有多深，都可以<strong>注入<strong>由父组件提供给整条链路的依赖。<p><p> <p><h2 id=\"provide\">Provide (提供) <a class=\"header-anchor\" href=\"#provide\">​<a><h2><div class=\"composition-api\"><p>要为组件后代提供数据，需要使用到 <a href=\"/api/composition-api-dependency-injection.html#provide\"><code>provide()<code><a> 函数：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 2, "_doc_id": "2_9115300076605782602"}}
{"doc_id": "3_1321032296179199588", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { provide } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>provide<span><span>(<span><span>/* 注入名 */<span><span> 'message'<span><span>, <span><span>/* 值 */<span><span> 'hello!'<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 3, "_doc_id": "3_1321032296179199588"}}
{"doc_id": "4_1311347232032437842", "text": "pan><span> 'message'<span><span>, <span><span>/* 值 */<span><span> 'hello!'<span><span>)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><p>如果不使用 <code><script setup><code>，请确保 <code>provide()<code> 是在 <code>setup()<code> 同步调用的：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { provide } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 4, "_doc_id": "4_1311347232032437842"}}
{"doc_id": "5_3978944963857970627", "text": "rt<span><span> { provide } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> setup<span><span>() {<span><span>\n<span class=\"line\"><span> provide<span><span>(<span><span>/* 注入名 */<span><span> 'message'<span><span>, <span><span>/* 值 */<span><span> 'hello!'<span><span>)<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 5, "_doc_id": "5_3978944963857970627"}}
{"doc_id": "6_9073210691122351295", "text": "<span>/* 值 */<span><span> 'hello!'<span><span>)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p><code>provide()<code> 函数接收两个参数。第一个参数被称为<strong>注入名<strong>，可以是一个字符串或是一个 <code>Symbol<code>。后代组件会用注入名来查找期望注入的值。一个组件可以多次调用 <code>provide()<code>，使用不同的注入名，注入不同的依赖值。<p><p>第二个参数是提供的值，值可以是任意类型，包括响应式的状态，比如一个 ref：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { ref, provide } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 6, "_doc_id": "6_9073210691122351295"}}
{"doc_id": "7_4049564577826970634", "text": "ass=\"line\"><span>import<span><span> { ref, provide } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> count<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 7, "_doc_id": "7_4049564577826970634"}}
{"doc_id": "8_8568520239705013621", "text": "<span><span> count<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>\n<span class=\"line\"><span>provide<span><span>(<span><span>'key'<span><span>, count)<span><span><code><pre><div><p>提供的响应式状态使后代组件可以由此和提供者建立响应式的联系。<p><div><div class=\"options-api\"><p>要为组件后代提供数据，需要使用到 <a href=\"/api/options-composition.html#provide\"><code>provide<code><a> 选项：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 8, "_doc_id": "8_8568520239705013621"}}
{"doc_id": "9_2470242073759825200", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> provide: {<span><span>\n<span class=\"line\"><span> message: <span><span>'hello!'<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 9, "_doc_id": "9_2470242073759825200"}}
{"doc_id": "10_2871719382001142887", "text": "ass=\"line\"><span> message: <span><span>'hello!'<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>对于 <code>provide<code> 对象上的每一个属性，后代组件会用其 key 为注入名查找期望注入的值，属性的值就是要提供的数据。<p><p>如果我们需要提供依赖当前组件实例的状态 (比如那些由 <code>data()<code> 定义的数据属性)，那么可以以函数形式使用 <code>provide<code>：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 10, "_doc_id": "10_2871719382001142887"}}
{"doc_id": "11_3724530633310163747", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> data<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> message: <span><span>'hello!'<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line highlighted\"><span> provide<span><span>() {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 11, "_doc_id": "11_3724530633310163747"}}
{"doc_id": "12_8709405706441977564", "text": "ne\"><span> },<span><span>\n<span class=\"line highlighted\"><span> provide<span><span>() {<span><span>\n<span class=\"line highlighted\"><span> // 使用函数的形式，可以访问到 `this`<span><span>\n<span class=\"line highlighted\"><span> return<span><span> {<span><span>\n<span class=\"line highlighted\"><span> message: <span><span>this<span><span>.message<span><span>\n<span class=\"line highlighted\"><span> }<span><span>\n<span class=\"line highlighted\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 12, "_doc_id": "12_8709405706441977564"}}
{"doc_id": "13_3214472782456866241", "text": "n class=\"line highlighted\"><span> }<span><span>\n<span class=\"line highlighted\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>然而，请注意这<strong>不会<strong>使注入保持响应性。我们会在后续小节中讨论如何<a href=\"#working-with-reactivity\">让注入转变为响应式<a>。<p><div><h2 id=\"app-level-provide\">应用层 Provide <a class=\"header-anchor\" href=\"#app-level-provide\">​<a><h2><p>除了在一个组件中提供依赖，我们还可以在整个应用层面提供依赖：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { createApp } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 13, "_doc_id": "13_3214472782456866241"}}
{"doc_id": "14_5262679173132022058", "text": "class=\"line\"><span>import<span><span> { createApp } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> app<span><span> =<span><span> createApp<span><span>({})<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>app.<span><span>provide<span><span>(<span><span>/* 注入名 */<span><span> 'message'<span><span>, <span><span>/* 值 */<span><span> 'hello!'<span><span>)<span><span><code><pre><div><p>在应用级别提供的数据在该应用内的所有组件中都可以注入。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 14, "_doc_id": "14_5262679173132022058"}}
{"doc_id": "15_5097924213559876301", "text": ">/* 值 */<span><span> 'hello!'<span><span>)<span><span><code><pre><div><p>在应用级别提供的数据在该应用内的所有组件中都可以注入。这在你编写<a href=\"/guide/reusability/plugins.html\">插件<a>时会特别有用，因为插件一般都不会使用组件形式来提供值。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 15, "_doc_id": "15_5097924213559876301"}}
{"doc_id": "16_5430421675657726960", "text": "供的数据在该应用内的所有组件中都可以注入。这在你编写<a href=\"/guide/reusability/plugins.html\">插件<a>时会特别有用，因为插件一般都不会使用组件形式来提供值。<p><h2 id=\"inject\">Inject (注入) <a class=\"header-anchor\" href=\"#inject\">​<a><h2><div class=\"composition-api\"><p>要注入上层组件提供的数据，需使用 <a href=\"/api/composition-api-dependency-injection.html#inject\"><code>inject()<code><a> 函数：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 16, "_doc_id": "16_5430421675657726960"}}
{"doc_id": "17_3771487207527315157", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { inject } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> message<span><span> =<span><span> inject<span><span>(<span><span>'message'<span><span>)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><p>如果有多个父组件提供了相同键的数据，注入将解析为组件链上最近的父组件所注入的值。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 17, "_doc_id": "17_3771487207527315157"}}
{"doc_id": "18_1396250050635964792", "text": "pan><span>script<span><span>><span><span><code><pre><div><p>如果有多个父组件提供了相同键的数据，注入将解析为组件链上最近的父组件所注入的值。<p><p>如果提供的值是一个 ref，注入进来的会是该 ref 对象，而<strong>不会<strong>自动解包为其内部的值。这使得注入方组件能够通过 ref 对象保持了和供给方的响应性链接。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 18, "_doc_id": "18_1396250050635964792"}}
{"doc_id": "19_8412704328910413941", "text": "。<p><p>如果提供的值是一个 ref，注入进来的会是该 ref 对象，而<strong>不会<strong>自动解包为其内部的值。这使得注入方组件能够通过 ref 对象保持了和供给方的响应性链接。<p><p><a href=\"https://play.vuejs.org/#\" target=\"_blank\">带有响应性的 provide + inject 完整示例<a><p><p>同样的，", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 19, "_doc_id": "19_8412704328910413941"}}
{"doc_id": "20_3974292990184950658", "text": "PLECXa9NKdD/a6QTTtGnP88LgiXJtYv4BaLHhvg==\" target=\"_blank\">带有响应性的 provide + inject 完整示例<a><p><p>同样的，如果没有使用 <code><script setup><code>，<code>inject()<code> 需要在 <code>setup()<code> 内同步调用：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { inject } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 20, "_doc_id": "20_3974292990184950658"}}
{"doc_id": "21_732629801381522126", "text": "n class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> setup<span><span>() {<span><span>\n<span class=\"line\"><span> const<span><span> message<span><span> =<span><span> inject<span><span>(<span><span>'message'<span><span>)<span><span>\n<span class=\"line\"><span> return<span><span> { message }<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 21, "_doc_id": "21_732629801381522126"}}
{"doc_id": "22_8852155093259070232", "text": "ss=\"line\"><span> return<span><span> { message }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><div class=\"options-api\"><p>要注入上层组件提供的数据，需使用 <a href=\"/api/options-composition.html#inject\"><code>inject<code><a> 选项来声明：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 22, "_doc_id": "22_8852155093259070232"}}
{"doc_id": "23_6626201705543152876", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> inject: [<span><span>'message'<span><span>],<span><span>\n<span class=\"line\"><span> created<span><span>() {<span><span>\n<span class=\"line\"><span> console.<span><span>log<span><span>(<span><span>this<span><span>.message) <span><span>// injected value<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 23, "_doc_id": "23_6626201705543152876"}}
{"doc_id": "24_1219134250480382551", "text": "n><span>.message) <span><span>// injected value<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>注入会在组件自身的状态<strong>之前<strong>被解析，因此你可以在 <code>data()<code> 中访问到注入的属性：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> inject: [<span><span>'message'<span><span>],<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 24, "_doc_id": "24_1219134250480382551"}}
{"doc_id": "25_4928278972046649229", "text": "n> {<span><span>\n<span class=\"line\"><span> inject: [<span><span>'message'<span><span>],<span><span>\n<span class=\"line\"><span> data<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> // 基于注入值的初始数据<span><span>\n<span class=\"line\"><span> fullMessage: <span><span>this<span><span>.message<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 25, "_doc_id": "25_4928278972046649229"}}
{"doc_id": "26_4299621919306070629", "text": "message<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>如果有多个父组件提供了相同键的数据，注入将解析为组件链上最近的父组件所注入的值。<p><p><a href=\"https://play.vuejs.", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 26, "_doc_id": "26_4299621919306070629"}}
{"doc_id": "27_3458534550524434605", "text": "><span><code><pre><div><p>如果有多个父组件提供了相同键的数据，注入将解析为组件链上最近的父组件所注入的值。<p><p><a href=\"https://play.vuejs.org/#\" target=\"_blank\">完整的 provide + inject 示例<a><p><h3 id=\"injection-aliasing\">注入别名 <a class=\"header-anchor\" href=\"#injection-aliasing\">​<a><h3><p>当以数组形式使用 <code>inject<code>，", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 27, "_doc_id": "27_3458534550524434605"}}
{"doc_id": "28_6005451827706781644", "text": "ng\">注入别名 <a class=\"header-anchor\" href=\"#injection-aliasing\">​<a><h3><p>当以数组形式使用 <code>inject<code>，注入的属性会以同名的 key 暴露到组件实例上。在上面的例子中，提供的属性名为 <code>\"message\"<code>，注入后以 <code>this.message<code> 的形式暴露。访问的本地属性名和注入名是相同的。<p><p>如果我们想要用一个不同的本地属性名注入该属性，我们需要在 <code>inject<code> 选项的属性上使用对象的形式：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> inject: {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 28, "_doc_id": "28_6005451827706781644"}}
{"doc_id": "29_88300503530919134", "text": "xport<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> inject: {<span><span>\n<span class=\"line\"><span> /* 本地属性名 */<span><span> localMessage: {<span><span>\n<span class=\"line\"><span> from: <span><span>/* 注入来源名 */<span><span> 'message'<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>这里，组件本地化了原注入名 <code>\"message\"<code> 所提供的属性，并将其暴露为 <code>this.localMessage<code>。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 29, "_doc_id": "29_88300503530919134"}}
{"doc_id": "30_6790039255724862007", "text": "><code><pre><div><p>这里，组件本地化了原注入名 <code>\"message\"<code> 所提供的属性，并将其暴露为 <code>this.localMessage<code>。<p><div><h3 id=\"injection-default-values\">注入默认值 <a class=\"header-anchor\" href=\"#injection-default-values\">​<a><h3><p>默认情况下，<code>inject<code> 假设传入的注入名会被某个祖先链上的组件提供。如果该注入名的确没有任何组件提供，则会抛出一个运行时警告。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 30, "_doc_id": "30_6790039255724862007"}}
{"doc_id": "31_3648808778418456906", "text": "ault-values\">​<a><h3><p>默认情况下，<code>inject<code> 假设传入的注入名会被某个祖先链上的组件提供。如果该注入名的确没有任何组件提供，则会抛出一个运行时警告。<p><p>如果在注入一个值时不要求必须有提供者，那么我们应该声明一个默认值，和 props 类似：<p><div class=\"composition-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 如果没有祖先组件提供 \"message\"<span><span>\n<span class=\"line\"><span>// `value` 会是 \"这是默认值\"<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 31, "_doc_id": "31_3648808778418456906"}}
{"doc_id": "32_3315453201895694816", "text": "span>// 如果没有祖先组件提供 \"message\"<span><span>\n<span class=\"line\"><span>// `value` 会是 \"这是默认值\"<span><span>\n<span class=\"line\"><span>const<span><span> value<span><span> =<span><span> inject<span><span>(<span><span>'message'<span><span>, <span><span>'这是默认值'<span><span>)<span><span><code><pre><div><p>在一些场景中，默认值可能需要通过调用一个函数或初始化一个类来取得。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 32, "_doc_id": "32_3315453201895694816"}}
{"doc_id": "33_8767073895124729531", "text": "n>, <span><span>'这是默认值'<span><span>)<span><span><code><pre><div><p>在一些场景中，默认值可能需要通过调用一个函数或初始化一个类来取得。为了避免在用不到默认值的情况下进行不必要的计算或产生副作用，我们可以使用工厂函数来创建默认值：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> value<span><span> =<span><span> inject<span><span>(<span><span>'key'<span><span>, () <span><span>=><span><span> new<span><span> ExpensiveClass<span><span>(), <span><span>true<span><span>)<span><span><code><pre><div><p>第三个参数表示默认值应该被当作一个工厂函数。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 33, "_doc_id": "33_8767073895124729531"}}
{"doc_id": "34_5949059911508260987", "text": "ss<span><span>(), <span><span>true<span><span>)<span><span><code><pre><div><p>第三个参数表示默认值应该被当作一个工厂函数。<p><div><div class=\"options-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> // 当声明注入的默认值时<span><span>\n<span class=\"line\"><span> // 必须使用对象形式<span><span>\n<span class=\"line\"><span> inject: {<span><span>\n<span class=\"line\"><span> message: {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 34, "_doc_id": "34_5949059911508260987"}}
{"doc_id": "35_157602532113718051", "text": "n>\n<span class=\"line\"><span> inject: {<span><span>\n<span class=\"line\"><span> message: {<span><span>\n<span class=\"line\"><span> from: <span><span>'message'<span><span>, <span><span>// 当与原注入名同名时，这个属性是可选的<span><span>\n<span class=\"line\"><span> default: <span><span>'default value'<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> user: {<span><span>\n<span class=\"line\"><span> // 对于非基础类型数据，如果创建开销比较大，或是需要确保每个组件实例<span><span>\n<span class=\"line\"><span> // 需要独立数据的，请使用工厂函数<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 35, "_doc_id": "35_157602532113718051"}}
{"doc_id": "36_739505548221506472", "text": "非基础类型数据，如果创建开销比较大，或是需要确保每个组件实例<span><span>\n<span class=\"line\"><span> // 需要独立数据的，请使用工厂函数<span><span>\n<span class=\"line\"><span> default<span><span>: () <span><span>=><span><span> ({ name: <span><span>'John'<span><span> })<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 36, "_doc_id": "36_739505548221506472"}}
{"doc_id": "37_3084572115727257095", "text": "pan> })<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><h2 id=\"working-with-reactivity\">和响应式数据配合使用 <a class=\"header-anchor\" href=\"#working-with-reactivity\">​<a><h2><div class=\"composition-api\"><p>当提供 / 注入响应式的数据时，<strong>建议尽可能将任何对响应式状态的变更都保持在供给方组件中<strong>。这样可以确保所提供状态的声明和变更操作都内聚在同一个组件内，使其更容易维护。<p><p>有的时候，我们可能需要在注入方组件中更改数据。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 37, "_doc_id": "37_3084572115727257095"}}
{"doc_id": "38_5281260873277670546", "text": "可能将任何对响应式状态的变更都保持在供给方组件中<strong>。这样可以确保所提供状态的声明和变更操作都内聚在同一个组件内，使其更容易维护。<p><p>有的时候，我们可能需要在注入方组件中更改数据。在这种情况下，我们推荐在供给方组件内声明并提供一个更改数据的方法函数：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- 在供给方组件内 --><span><span>\n<span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { provide, ref } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 38, "_doc_id": "38_5281260873277670546"}}
{"doc_id": "39_8810718204573910920", "text": "ass=\"line\"><span>import<span><span> { provide, ref } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> location<span><span> =<span><span> ref<span><span>(<span><span>'North Pole'<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line highlighted\"><span>function<span><span> updateLocation<span><span>() {<span><span>\n<span class=\"line highlighted\"><span> location.value <span><span>=<span><span> 'South Pole'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 39, "_doc_id": "39_8810718204573910920"}}
{"doc_id": "40_3814859609639290327", "text": "n class=\"line highlighted\"><span> location.value <span><span>=<span><span> 'South Pole'<span><span>\n<span class=\"line highlighted\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>provide<span><span>(<span><span>'location'<span><span>, {<span><span>\n<span class=\"line\"><span> location,<span><span>\n<span class=\"line highlighted\"><span> updateLocation<span><span>\n<span class=\"line\"><span>})<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 40, "_doc_id": "40_3814859609639290327"}}
{"doc_id": "41_4148531814564383140", "text": "class=\"line highlighted\"><span> updateLocation<span><span>\n<span class=\"line\"><span>})<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- 在注入方组件 --><span><span>\n<span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 41, "_doc_id": "41_4148531814564383140"}}
{"doc_id": "42_6428307337074781643", "text": "span><span>\n<span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { inject } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line highlighted\"><span>const<span><span> { <span><span>location<span><span>, <span><span>updateLocation<span><span> } <span><span>=<span><span> inject<span><span>(<span><span>'location'<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 42, "_doc_id": "42_6428307337074781643"}}
{"doc_id": "43_5878191223136464716", "text": "pan> } <span><span>=<span><span> inject<span><span>(<span><span>'location'<span><span>)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>button<span><span> @click<span><span>=<span><span>\"updateLocation\"<span><span>>{{ location }}</<span><span>button<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 43, "_doc_id": "43_5878191223136464716"}}
{"doc_id": "44_2289143964759996723", "text": "span><span>\"updateLocation\"<span><span>>{{ location }}</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span><code><pre><div><p>最后，如果你想确保提供的数据不能被注入方的组件更改，你可以使用 <a href=\"/api/reactivity-core.html#readonly\"><code>readonly()<code><a> 来包装提供的值。<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 44, "_doc_id": "44_2289143964759996723"}}
{"doc_id": "45_5259415534938173131", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { ref, provide, readonly } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> count<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 45, "_doc_id": "45_5259415534938173131"}}
{"doc_id": "46_5246698434832030663", "text": "<span><span> count<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>\n<span class=\"line\"><span>provide<span><span>(<span><span>'read-only-count'<span><span>, <span><span>readonly<span><span>(count))<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 46, "_doc_id": "46_5246698434832030663"}}
{"doc_id": "47_3431326965431880885", "text": "an>(<span><span>'read-only-count'<span><span>, <span><span>readonly<span><span>(count))<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><div><div class=\"options-api\"><p>为保证注入方和供给方之间的响应性链接，我们需要使用 <a href=\"/api/reactivity-core.html#computed\">computed()<a> 函数提供一个计算属性：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { computed } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 47, "_doc_id": "47_3431326965431880885"}}
{"doc_id": "48_9178849029443264729", "text": "n class=\"line\"><span>import<span><span> { computed } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> data<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> message: <span><span>'hello!'<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> },<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 48, "_doc_id": "48_9178849029443264729"}}
{"doc_id": "49_8602792018542272202", "text": "ello!'<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> provide<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> // 显式提供一个计算属性<span><span>\n<span class=\"line highlighted\"><span> message: <span><span>computed<span><span>(() <span><span>=><span><span> this<span><span>.message)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 49, "_doc_id": "49_8602792018542272202"}}
{"doc_id": "50_4386275552621247416", "text": "essage)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p><a href=\"https://play.vuejs.", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 50, "_doc_id": "50_4386275552621247416"}}
{"doc_id": "51_4693897432114759619", "text": "}<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p><a href=\"https://play.vuejs.org/#\" target=\"_blank\">带有响应性的 provide + inject 完整示例<a><p><p><code>computed()<code> 函数常用于组合式 API 风格的组件中，", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 51, "_doc_id": "51_4693897432114759619"}}
{"doc_id": "52_6206346323614652736", "text": "==\" target=\"_blank\">带有响应性的 provide + inject 完整示例<a><p><p><code>computed()<code> 函数常用于组合式 API 风格的组件中，但它同样还可以用于补充选项式 API 风格的某些用例。你可以通过阅读<a href=\"/guide/essentials/reactivity-fundamentals.html\">响应式系统基础<a>和<a href=\"/guide/essentials/computed.html\">计算属性<a>两个章节了解更多组合式的 API 风格。<p><div><h2 id=\"working-with-symbol-keys\">使用 Symbol 作注入名 <a class=\"header-anchor\" href=\"#working-with-symbol-keys\">​<a><h2><p>至此，我们已经了解了如何使用字符串作为注入名。", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 52, "_doc_id": "52_6206346323614652736"}}
{"doc_id": "53_5018960733618776890", "text": "ol 作注入名 <a class=\"header-anchor\" href=\"#working-with-symbol-keys\">​<a><h2><p>至此，我们已经了解了如何使用字符串作为注入名。但如果你正在构建大型的应用，包含非常多的依赖提供，或者你正在编写提供给其他开发者使用的组件库，建议最好使用 <a href=\"https://developer.mozilla.org/zh-CN/docs/Web/JavaScript/Reference/Global_Objects/Symbol\" target=\"_blank\">Symbol<a> 来作为注入名以避免潜在的冲突。<p><p>我们通常推荐在一个单独的文件中导出这些注入名 Symbol：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">keys.", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 53, "_doc_id": "53_5018960733618776890"}}
{"doc_id": "54_5781269610029535337", "text": "vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">keys.js<span><p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> const<span><span> myInjectionKey<span><span> =<span><span> Symbol<span><span>()<span><span><code><pre><div><div><div class=\"composition-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 在供给方组件中<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 54, "_doc_id": "54_5781269610029535337"}}
{"doc_id": "55_5939687222374693748", "text": "s<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 在供给方组件中<span><span>\n<span class=\"line\"><span>import<span><span> { provide } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>import<span><span> { myInjectionKey } <span><span>from<span><span> './keys.js'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>provide<span><span>(myInjectionKey, { <span><span>\n<span class=\"line\"><span> /* 要提供的数据 */<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 55, "_doc_id": "55_5939687222374693748"}}
{"doc_id": "56_5324284834900174308", "text": "ovide<span><span>(myInjectionKey, { <span><span>\n<span class=\"line\"><span> /* 要提供的数据 */<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 注入方组件<span><span>\n<span class=\"line\"><span>import<span><span> { inject } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 56, "_doc_id": "56_5324284834900174308"}}
{"doc_id": "57_7830396158627303272", "text": "pan class=\"line\"><span>import<span><span> { inject } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>import<span><span> { myInjectionKey } <span><span>from<span><span> './keys.js'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 57, "_doc_id": "57_7830396158627303272"}}
{"doc_id": "58_7279878486791890139", "text": "> { myInjectionKey } <span><span>from<span><span> './keys.js'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> injected<span><span> =<span><span> inject<span><span>(myInjectionKey)<span><span><code><pre><div><p>TypeScript 用户请参考：<a href=\"/guide/typescript/composition-api.html#typing-provide-inject\">为 Provide / Inject 标注类型<a> <p><div><div class=\"options-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 在供给方组件中<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 58, "_doc_id": "58_7279878486791890139"}}
{"doc_id": "59_1401697421817419671", "text": "s<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 在供给方组件中<span><span>\n<span class=\"line\"><span>import<span><span> { myInjectionKey } <span><span>from<span><span> './keys.js'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> provide<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> [myInjectionKey]: {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 59, "_doc_id": "59_1401697421817419671"}}
{"doc_id": "60_2282470967772867771", "text": "\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> [myInjectionKey]: {<span><span>\n<span class=\"line\"><span> /* 要提供的数据 */<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 注入方组件<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 60, "_doc_id": "60_2282470967772867771"}}
{"doc_id": "61_8645739802729222650", "text": ">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 注入方组件<span><span>\n<span class=\"line\"><span>import<span><span> { myInjectionKey } <span><span>from<span><span> './keys.js'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> inject: {<span><span>\n<span class=\"line\"><span> injected: { from: myInjectionKey }<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 61, "_doc_id": "61_8645739802729222650"}}
{"doc_id": "62_1233900771983568542", "text": "line\"><span> injected: { from: myInjectionKey }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div> <p><strong>译者注<strong><p><p><a id=\"footnote-1\"><a>[1] 在本章及后续章节中，“<strong>提供<strong>”将成为对应 Provide 的一个专有概念<p><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/components/provide-inject.html", "title": "依赖注入", "doc_id": "a85562a14ea447b49e7d27543c29c2a3", "content_type": "web_page", "word_count": 1007, "chunk_index": 62, "_doc_id": "62_1233900771983568542"}}
{"doc_id": "0_1969936741880072315", "text": "<div><div><h1 id=\"async-components\">异步组件 <a class=\"header-anchor\" href=\"#async-components\">​<a><h1><h2 id=\"basic-usage\">基本用法 <a class=\"header-anchor\" href=\"#basic-usage\">​<a><h2><p>在大型项目中，我们可能需要拆分应用为更小的块，并仅在需要时再从服务器加载相关组件。", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 0, "_doc_id": "0_1969936741880072315"}}
{"doc_id": "1_984807678331797409", "text": "用法 <a class=\"header-anchor\" href=\"#basic-usage\">​<a><h2><p>在大型项目中，我们可能需要拆分应用为更小的块，并仅在需要时再从服务器加载相关组件。Vue 提供了 <a href=\"/api/general.html#defineasynccomponent\"><code>defineAsyncComponent<code><a> 方法来实现此功能：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { defineAsyncComponent } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 1, "_doc_id": "1_984807678331797409"}}
{"doc_id": "2_6238201894731450304", "text": "> { defineAsyncComponent } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>(() <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> return<span><span> new<span><span> Promise<span><span>((<span><span>resolve<span><span>, <span><span>reject<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> // ...从服务器获取组件<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 2, "_doc_id": "2_6238201894731450304"}}
{"doc_id": "3_1806788844694558208", "text": "pan>) <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> // ...从服务器获取组件<span><span>\n<span class=\"line\"><span> resolve<span><span>(<span><span>/* 获取到的组件 */<span><span>)<span><span>\n<span class=\"line\"><span> })<span><span>\n<span class=\"line\"><span>})<span><span>\n<span class=\"line\"><span>// ... 像使用其他一般组件一样使用 `AsyncComp`<span><span><code><pre><div><p>如你所见，<code>defineAsyncComponent<code> 方法接收一个返回 Promise 的加载函数。这个 Promise 的 <code>resolve<code> 回调方法应该在从服务器获得组件定义时调用。", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 3, "_doc_id": "3_1806788844694558208"}}
{"doc_id": "4_8069452222285977201", "text": "neAsyncComponent<code> 方法接收一个返回 Promise 的加载函数。这个 Promise 的 <code>resolve<code> 回调方法应该在从服务器获得组件定义时调用。你也可以调用 <code>reject(reason)<code> 表明加载失败。<p><p><a href=\"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/import\" target=\"_blank\">ES 模块动态导入<a>也会返回一个 Promise，所以多数情况下我们会将它和 <code>defineAsyncComponent<code> 搭配使用。", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 4, "_doc_id": "4_8069452222285977201"}}
{"doc_id": "5_6671841207802540603", "text": "ort\" target=\"_blank\">ES 模块动态导入<a>也会返回一个 Promise，所以多数情况下我们会将它和 <code>defineAsyncComponent<code> 搭配使用。类似 Vite 和 Webpack 这样的构建工具也支持此语法 (并且会将它们作为打包时的代码分割点)，因此我们也可以用它来导入 Vue 单文件组件：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { defineAsyncComponent } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 5, "_doc_id": "5_6671841207802540603"}}
{"doc_id": "6_6592429422233407430", "text": "> { defineAsyncComponent } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>(() <span><span>=><span><span>\n<span class=\"line\"><span> import<span><span>(<span><span>'./components/MyComponent.vue'<span><span>)<span><span>\n<span class=\"line\"><span>)<span><span><code><pre><div><p>最后得到的 <code>AsyncComp<code> 是一个外层包装过的组件，仅在页面需要它渲染时才会调用加载内部实际组件的函数。", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 6, "_doc_id": "6_6592429422233407430"}}
{"doc_id": "7_5611824015759879734", "text": "n>)<span><span><code><pre><div><p>最后得到的 <code>AsyncComp<code> 是一个外层包装过的组件，仅在页面需要它渲染时才会调用加载内部实际组件的函数。它会将接收到的 props 和插槽传给内部组件，所以你可以使用这个异步的包装组件无缝地替换原始组件，同时实现延迟加载。", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 7, "_doc_id": "7_5611824015759879734"}}
{"doc_id": "8_5162095910960041318", "text": "e> 是一个外层包装过的组件，仅在页面需要它渲染时才会调用加载内部实际组件的函数。它会将接收到的 props 和插槽传给内部组件，所以你可以使用这个异步的包装组件无缝地替换原始组件，同时实现延迟加载。<p><p>与普通组件一样，异步组件可以使用 <code>app.component()<code> <a href=\"/guide/components/registration.html#global-registration\">全局注册<a>：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>app.<span><span>component<span><span>(<span><span>'MyComponent'<span><span>, <span><span>defineAsyncComponent<span><span>(() <span><span>=><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 8, "_doc_id": "8_5162095910960041318"}}
{"doc_id": "9_546855582751972947", "text": "yComponent'<span><span>, <span><span>defineAsyncComponent<span><span>(() <span><span>=><span><span>\n<span class=\"line\"><span> import<span><span>(<span><span>'./components/MyComponent.vue'<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 9, "_doc_id": "9_546855582751972947"}}
{"doc_id": "10_316867596798766012", "text": "line\"><span> import<span><span>(<span><span>'./components/MyComponent.vue'<span><span>)<span><span>\n<span class=\"line\"><span>))<span><span><code><pre><div><div class=\"options-api\"><p>你也可以在<a href=\"/guide/components/registration.html#local-registration\">局部注册组件<a>时使用 <code>defineAsyncComponent<code>：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 10, "_doc_id": "10_316867596798766012"}}
{"doc_id": "11_7549813908242681584", "text": "ki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { defineAsyncComponent } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> components: {<span><span>\n<span class=\"line\"><span> AdminPage: <span><span>defineAsyncComponent<span><span>(() <span><span>=><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 11, "_doc_id": "11_7549813908242681584"}}
{"doc_id": "12_4184945416539855455", "text": "\"line\"><span> AdminPage: <span><span>defineAsyncComponent<span><span>(() <span><span>=><span><span>\n<span class=\"line\"><span> import<span><span>(<span><span>'./components/AdminPageComponent.vue'<span><span>)<span><span>\n<span class=\"line\"><span> )<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 12, "_doc_id": "12_4184945416539855455"}}
{"doc_id": "13_3256889195307910329", "text": ">\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>AdminPage<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span><code><pre><div><div><div class=\"composition-api\"><p>也可以直接在父组件中定义它们：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 13, "_doc_id": "13_3256889195307910329"}}
{"doc_id": "14_1247083694481146005", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { defineAsyncComponent } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> AdminPage<span><span> =<span><span> defineAsyncComponent<span><span>(() <span><span>=><span><span>\n<span class=\"line\"><span> import<span><span>(<span><span>'./components/AdminPageComponent.vue'<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 14, "_doc_id": "14_1247083694481146005"}}
{"doc_id": "15_3346848428176805625", "text": "span> import<span><span>(<span><span>'./components/AdminPageComponent.vue'<span><span>)<span><span>\n<span class=\"line\"><span>)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>AdminPage<span><span> /><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 15, "_doc_id": "15_3346848428176805625"}}
{"doc_id": "16_7194985206163469938", "text": "pan><span>><span><span>\n<span class=\"line\"><span> <<span><span>AdminPage<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span><code><pre><div><div><h2 id=\"loading-and-error-states\">加载与错误状态 <a class=\"header-anchor\" href=\"#loading-and-error-states\">​<a><h2><p>异步操作不可避免地会涉及到加载和错误状态，因此 <code>defineAsyncComponent()<code> 也支持在高级选项中处理这些状态：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>({<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 16, "_doc_id": "16_7194985206163469938"}}
{"doc_id": "17_1787657044172563312", "text": "onst<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>({<span><span>\n<span class=\"line\"><span> // 加载函数<span><span>\n<span class=\"line\"><span> loader<span><span>: () <span><span>=><span><span> import<span><span>(<span><span>'./Foo.vue'<span><span>),<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 加载异步组件时使用的组件<span><span>\n<span class=\"line\"><span> loadingComponent: LoadingComponent,<span><span>\n<span class=\"line\"><span> // 展示加载组件前的延迟时间，默认为 200ms<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 17, "_doc_id": "17_1787657044172563312"}}
{"doc_id": "18_7099918119423038387", "text": "nent: LoadingComponent,<span><span>\n<span class=\"line\"><span> // 展示加载组件前的延迟时间，默认为 200ms<span><span>\n<span class=\"line\"><span> delay: <span><span>200<span><span>,<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 加载失败后展示的组件<span><span>\n<span class=\"line\"><span> errorComponent: ErrorComponent,<span><span>\n<span class=\"line\"><span> // 如果提供了一个 timeout 时间限制，并超时了<span><span>\n<span class=\"line\"><span> // 也会显示这里配置的报错组件，默认值是：Infinity<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 18, "_doc_id": "18_7099918119423038387"}}
{"doc_id": "19_4631692882998379268", "text": "timeout 时间限制，并超时了<span><span>\n<span class=\"line\"><span> // 也会显示这里配置的报错组件，默认值是：Infinity<span><span>\n<span class=\"line\"><span> timeout: <span><span>3000<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><p>如果提供了一个加载组件，它将在内部组件加载时先行显示。在加载组件显示之前有一个默认的 200ms 延迟——这是因为在网络状况较好时，加载完成得很快，加载组件和最终组件之间的替换太快可能产生闪烁，反而影响用户感受。<p><p>如果提供了一个报错组件，则它会在加载器函数返回的 Promise 抛错时被渲染。你还可以指定一个超时时间，在请求耗时超过指定时间时也会渲染报错组件。", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 19, "_doc_id": "19_4631692882998379268"}}
{"doc_id": "20_2321041359925837916", "text": "替换太快可能产生闪烁，反而影响用户感受。<p><p>如果提供了一个报错组件，则它会在加载器函数返回的 Promise 抛错时被渲染。你还可以指定一个超时时间，在请求耗时超过指定时间时也会渲染报错组件。<p><h2 id=\"lazy-hydration\">惰性激活 <a class=\"header-anchor\" href=\"#lazy-hydration\" class=\"vt-badge\">​<a><h2><blockquote><p>如果你正在使用<a href=\"/guide/scaling-up/ssr.html\">服务器端渲染<a>，这一部分才会适用。<p><blockquote><p>在 Vue 3.5+ 中，异步组件可以通过提供激活策略来控制何时进行激活。", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 20, "_doc_id": "20_2321041359925837916"}}
{"doc_id": "21_6218002547465597392", "text": "uide/scaling-up/ssr.html\">服务器端渲染<a>，这一部分才会适用。<p><blockquote><p>在 Vue 3.5+ 中，异步组件可以通过提供激活策略来控制何时进行激活。<p><h3 id=\"hydrate-on-idle\">在空闲时进行激活 <a class=\"header-anchor\" href=\"#hydrate-on-idle\">​<a><h3><p>通过 <code>requestIdleCallback<code> 进行激活：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { defineAsyncComponent, hydrateOnIdle } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 21, "_doc_id": "21_6218002547465597392"}}
{"doc_id": "22_6389481957173886323", "text": "Component, hydrateOnIdle } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>({<span><span>\n<span class=\"line\"><span> loader<span><span>: () <span><span>=><span><span> import<span><span>(<span><span>'./Comp.vue'<span><span>),<span><span>\n<span class=\"line\"><span> hydrate: <span><span>hydrateOnIdle<span><span>(<span><span>/* 传递可选的最大超时 */<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 22, "_doc_id": "22_6389481957173886323"}}
{"doc_id": "23_4813384932142075700", "text": "hydrate: <span><span>hydrateOnIdle<span><span>(<span><span>/* 传递可选的最大超时 */<span><span>)<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><h3 id=\"hydrate-on-visible\">在可见时激活 <a class=\"header-anchor\" href=\"#hydrate-on-visible\">​<a><h3><p>通过 <code>IntersectionObserver<code> 在元素变为可见时进行激活。<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { defineAsyncComponent, hydrateOnVisible } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 23, "_doc_id": "23_4813384932142075700"}}
{"doc_id": "24_8941994296404670678", "text": "an><span> { defineAsyncComponent, hydrateOnVisible } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>({<span><span>\n<span class=\"line\"><span> loader<span><span>: () <span><span>=><span><span> import<span><span>(<span><span>'./Comp.vue'<span><span>),<span><span>\n<span class=\"line\"><span> hydrate: <span><span>hydrateOnVisible<span><span>()<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 24, "_doc_id": "24_8941994296404670678"}}
{"doc_id": "25_7184934600613381527", "text": "an><span>\n<span class=\"line\"><span> hydrate: <span><span>hydrateOnVisible<span><span>()<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><p>可以选择传递一个侦听器的选项对象值：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>hydrateOnVisible<span><span>({ rootMargin: <span><span>'100px'<span><span> })<span><span><code><pre><div><p>当指定的媒体查询匹配时进行激活。", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 25, "_doc_id": "25_7184934600613381527"}}
{"doc_id": "26_1690958253585381531", "text": "pan>({ rootMargin: <span><span>'100px'<span><span> })<span><span><code><pre><div><p>当指定的媒体查询匹配时进行激活。<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { defineAsyncComponent, hydrateOnMediaQuery } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>({<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 26, "_doc_id": "26_1690958253585381531"}}
{"doc_id": "27_8572833992986550340", "text": "onst<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>({<span><span>\n<span class=\"line\"><span> loader<span><span>: () <span><span>=><span><span> import<span><span>(<span><span>'./Comp.vue'<span><span>),<span><span>\n<span class=\"line\"><span> hydrate: <span><span>hydrateOnMediaQuery<span><span>(<span><span>'(max-width:500px)'<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 27, "_doc_id": "27_8572833992986550340"}}
{"doc_id": "28_3519811941850580036", "text": "span><span>hydrateOnMediaQuery<span><span>(<span><span>'(max-width:500px)'<span><span>)<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><h3 id=\"hydrate-on-interaction\">交互时激活 <a class=\"header-anchor\" href=\"#hydrate-on-interaction\">​<a><h3><p>当组件元素上触发指定事件时进行激活。完成激活后，触发激活的事件也将被重放。<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { defineAsyncComponent, hydrateOnInteraction } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 28, "_doc_id": "28_3519811941850580036"}}
{"doc_id": "29_6381053991299095595", "text": "span> { defineAsyncComponent, hydrateOnInteraction } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>({<span><span>\n<span class=\"line\"><span> loader<span><span>: () <span><span>=><span><span> import<span><span>(<span><span>'./Comp.vue'<span><span>),<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 29, "_doc_id": "29_6381053991299095595"}}
{"doc_id": "30_6235223752337554727", "text": "() <span><span>=><span><span> import<span><span>(<span><span>'./Comp.vue'<span><span>),<span><span>\n<span class=\"line\"><span> hydrate: <span><span>hydrateOnInteraction<span><span>(<span><span>'click'<span><span>)<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><p>也可以是多个事件类型的列表：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>hydrateOnInteraction<span><span>([<span><span>'wheel'<span><span>,", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 30, "_doc_id": "30_6235223752337554727"}}
{"doc_id": "31_1053643826930618168", "text": "\"><code><span class=\"line\"><span>hydrateOnInteraction<span><span>([<span><span>'wheel'<span><span>, <span><span>'mouseover'<span><span>])<span><span><code><pre><div><h3 id=\"custom-strategy\">自定义策略 <a class=\"header-anchor\" href=\"#custom-strategy\">​<a><h3><div class=\"language-ts\"> <span class=\"lang\">ts<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { defineAsyncComponent,", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 31, "_doc_id": "31_1053643826930618168"}}
{"doc_id": "32_8042071455179106774", "text": "hiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { defineAsyncComponent, <span><span>type<span><span> HydrationStrategy } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> myStrategy<span><span>:<span><span> HydrationStrategy<span><span> =<span><span> (<span><span>hydrate<span><span>, <span><span>forEachElement<span><span>) <span><span>=><span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 32, "_doc_id": "32_8042071455179106774"}}
{"doc_id": "33_301825415560836359", "text": "drate<span><span>, <span><span>forEachElement<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> // forEachElement 是一个遍历组件未激活的 DOM 中所有根元素的辅助函数，<span><span>\n<span class=\"line\"><span> // 因为根元素可能是一个片段而非单个元素<span><span>\n<span class=\"line\"><span> forEachElement<span><span>(<span><span>el<span><span> =><span><span> {<span><span>\n<span class=\"line\"><span> // ...<span><span>\n<span class=\"line\"><span> })<span><span>\n<span class=\"line\"><span> // 准备好时调用 `hydrate`<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 33, "_doc_id": "33_301825415560836359"}}
{"doc_id": "34_5657911031742829856", "text": "<span class=\"line\"><span> })<span><span>\n<span class=\"line\"><span> // 准备好时调用 `hydrate`<span><span>\n<span class=\"line\"><span> hydrate<span><span>()<span><span>\n<span class=\"line\"><span> return<span><span> () <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> // 如必要，返回一个销毁函数<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 34, "_doc_id": "34_5657911031742829856"}}
{"doc_id": "35_4597116728225034005", "text": "class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> AsyncComp<span><span> =<span><span> defineAsyncComponent<span><span>({<span><span>\n<span class=\"line\"><span> loader<span><span>: () <span><span>=><span><span> import<span><span>(<span><span>'./Comp.vue'<span><span>),<span><span>\n<span class=\"line\"><span> hydrate: myStrategy<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 35, "_doc_id": "35_4597116728225034005"}}
{"doc_id": "36_2395395866444149657", "text": "an>'./Comp.vue'<span><span>),<span><span>\n<span class=\"line\"><span> hydrate: myStrategy<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><h2 id=\"using-with-suspense\">搭配 Suspense 使用 <a class=\"header-anchor\" href=\"#using-with-suspense\">​<a><h2><p>异步组件可以搭配内置的 <code><Suspense><code> 组件一起使用，若想了解 <code><Suspense><code> 和异步组件之间交互，请参阅 <a href=\"/guide/built-ins/suspense.html\"><code><Suspense><code><a> 章节。<p><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/components/async.html", "title": "异步组件", "doc_id": "b058fdf044cd4837b71b4b59a96a9acb", "content_type": "web_page", "word_count": 580, "chunk_index": 36, "_doc_id": "36_2395395866444149657"}}
{"doc_id": "0_5930693022822569690", "text": "<div><div><h1 id=\"composables\">组合式函数 <a class=\"header-anchor\" href=\"#composables\">​<a><h1><div class=\"tip custom-block\"><p class=\"custom-block-title\">TIP<p><p>此章节假设你已经对组合式 API 有了基本的了解。如果你只学习过选项式 API，你可以使用左侧边栏上方的切换按钮将 API 风格切换为组合式 API 后，重新阅读<a href=\"/guide/essentials/reactivity-fundamentals.html\">响应性基础<a>和<a href=\"/guide/essentials/lifecycle.html\">生命周期钩子<a>两个章节。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 0, "_doc_id": "0_5930693022822569690"}}
{"doc_id": "1_8300494895423891949", "text": "als/reactivity-fundamentals.html\">响应性基础<a>和<a href=\"/guide/essentials/lifecycle.html\">生命周期钩子<a>两个章节。<p><div><h2 id=\"what-is-a-composable\">什么是“组合式函数”？ <a class=\"header-anchor\" href=\"#what-is-a-composable\">​<a><h2><p>在 Vue 应用的概念中，“组合式函数”(Composables) 是一个利用 Vue 的组合式 API 来封装和复用<strong>有状态逻辑<strong>的函数。<p><p>当构建前端应用时，我们常常需要复用公共任务的逻辑。例如为了在不同地方格式化时间，我们可能会抽取一个可复用的日期格式化函数。这个函数封装了<strong>无状态的逻辑<strong>：它在接收一些输入后立刻返回所期望的输出。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 1, "_doc_id": "1_8300494895423891949"}}
{"doc_id": "2_7104429178137707608", "text": "常常需要复用公共任务的逻辑。例如为了在不同地方格式化时间，我们可能会抽取一个可复用的日期格式化函数。这个函数封装了<strong>无状态的逻辑<strong>：它在接收一些输入后立刻返回所期望的输出。复用无状态逻辑的库有很多，比如你可能已经用过的 <a href=\"https://lodash.com/\" target=\"_blank\">lodash<a> 或是 <a href=\"https://date-fns.org/\" target=\"_blank\">date-fns<a>。<p><p>相比之下，有状态逻辑负责管理会随时间而变化的状态。一个简单的例子是跟踪当前鼠标在页面中的位置。在实际应用中，也可能是像触摸手势或与数据库的连接状态这样的更复杂的逻辑。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 2, "_doc_id": "2_7104429178137707608"}}
{"doc_id": "3_699266774475478755", "text": "ate-fns<a>。<p><p>相比之下，有状态逻辑负责管理会随时间而变化的状态。一个简单的例子是跟踪当前鼠标在页面中的位置。在实际应用中，也可能是像触摸手势或与数据库的连接状态这样的更复杂的逻辑。<p><h2 id=\"mouse-tracker-example\">鼠标跟踪器示例 <a class=\"header-anchor\" href=\"#mouse-tracker-example\">​<a><h2><p>如果我们要直接在组件中使用组合式 API 实现鼠标跟踪功能，它会是这样的：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">MouseComponent.vue<span><p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 3, "_doc_id": "3_699266774475478755"}}
{"doc_id": "4_8658540025614466989", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { ref, onMounted, onUnmounted } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> x<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>\n<span class=\"line\"><span>const<span><span> y<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 4, "_doc_id": "4_8658540025614466989"}}
{"doc_id": "5_3237110903005723024", "text": "onst<span><span> y<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>function<span><span> update<span><span>(<span><span>event<span><span>) {<span><span>\n<span class=\"line\"><span> x.value <span><span>=<span><span> event.pageX<span><span>\n<span class=\"line\"><span> y.value <span><span>=<span><span> event.pageY<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 5, "_doc_id": "5_3237110903005723024"}}
{"doc_id": "6_7564593860135505209", "text": "pan><span> event.pageY<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>onMounted<span><span>(() <span><span>=><span><span> window.<span><span>addEventListener<span><span>(<span><span>'mousemove'<span><span>, update))<span><span>\n<span class=\"line\"><span>onUnmounted<span><span>(() <span><span>=><span><span> window.<span><span>removeEventListener<span><span>(<span><span>'mousemove'<span><span>, update))<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 6, "_doc_id": "6_7564593860135505209"}}
{"doc_id": "7_8154307333830857410", "text": "pan><span>removeEventListener<span><span>(<span><span>'mousemove'<span><span>, update))<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>>Mouse position is at: {{ x }}, {{ y }}</<span><span>template<span><span>><span><span><code><pre><div><div><p>但是，如果我们想在多个组件中复用这个相同的逻辑呢？", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 7, "_doc_id": "7_8154307333830857410"}}
{"doc_id": "8_8261816011225153289", "text": "y }}</<span><span>template<span><span>><span><span><code><pre><div><div><p>但是，如果我们想在多个组件中复用这个相同的逻辑呢？我们可以把这个逻辑以一个组合式函数的形式提取到外部文件中：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">mouse.js<span><p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { ref, onMounted, onUnmounted } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 8, "_doc_id": "8_8261816011225153289"}}
{"doc_id": "9_7487559153795177610", "text": ", onMounted, onUnmounted } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 按照惯例，组合式函数名以“use”开头<span><span>\n<span class=\"line\"><span>export<span><span> function<span><span> useMouse<span><span>() {<span><span>\n<span class=\"line\"><span> // 被组合式函数封装和管理的状态<span><span>\n<span class=\"line\"><span> const<span><span> x<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 9, "_doc_id": "9_7487559153795177610"}}
{"doc_id": "10_3298029768640642935", "text": "onst<span><span> x<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>\n<span class=\"line\"><span> const<span><span> y<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 组合式函数可以随时更改其状态。<span><span>\n<span class=\"line\"><span> function<span><span> update<span><span>(<span><span>event<span><span>) {<span><span>\n<span class=\"line\"><span> x.value <span><span>=<span><span> event.pageX<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 10, "_doc_id": "10_3298029768640642935"}}
{"doc_id": "11_2132808474300484907", "text": ") {<span><span>\n<span class=\"line\"><span> x.value <span><span>=<span><span> event.pageX<span><span>\n<span class=\"line\"><span> y.value <span><span>=<span><span> event.pageY<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 一个组合式函数也可以挂靠在所属组件的生命周期上<span><span>\n<span class=\"line\"><span> // 来启动和卸载副作用<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 11, "_doc_id": "11_2132808474300484907"}}
{"doc_id": "12_8847368680818751296", "text": "e\"><span> // 一个组合式函数也可以挂靠在所属组件的生命周期上<span><span>\n<span class=\"line\"><span> // 来启动和卸载副作用<span><span>\n<span class=\"line\"><span> onMounted<span><span>(() <span><span>=><span><span> window.<span><span>addEventListener<span><span>(<span><span>'mousemove'<span><span>, update))<span><span>\n<span class=\"line\"><span> onUnmounted<span><span>(() <span><span>=><span><span> window.<span><span>removeEventListener<span><span>(<span><span>'mousemove'<span><span>, update))<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 12, "_doc_id": "12_8847368680818751296"}}
{"doc_id": "13_8741406010009240757", "text": "ner<span><span>(<span><span>'mousemove'<span><span>, update))<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 通过返回值暴露所管理的状态<span><span>\n<span class=\"line\"><span> return<span><span> { x, y }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 13, "_doc_id": "13_8741406010009240757"}}
{"doc_id": "14_4303720393146406975", "text": "pan> // 通过返回值暴露所管理的状态<span><span>\n<span class=\"line\"><span> return<span><span> { x, y }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p>下面是它在组件中使用的方式：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">MouseComponent.vue<span><p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 14, "_doc_id": "14_4303720393146406975"}}
{"doc_id": "15_6247734200711445435", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { useMouse } <span><span>from<span><span> './mouse.js'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> { <span><span>x<span><span>, <span><span>y<span><span> } <span><span>=<span><span> useMouse<span><span>()<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 15, "_doc_id": "15_6247734200711445435"}}
{"doc_id": "16_5167433084987716563", "text": "n>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>>Mouse position is at: {{ x }}, {{ y }}</<span><span>template<span><span>><span><span><code><pre><div><div><p class=\"demo\"> Mouse position is at: 0,", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 16, "_doc_id": "16_5167433084987716563"}}
{"doc_id": "17_2798833982411316188", "text": "pan>template<span><span>><span><span><code><pre><div><div><p class=\"demo\"> Mouse position is at: 0, 0<p><p><a href=\"https://play.vuejs.org/#\" target=\"_blank\">在演练场中尝试一下<a><p><p>如你所见，", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 17, "_doc_id": "17_2798833982411316188"}}
{"doc_id": "18_5626360320772398922", "text": "f9VOY+EtizSWfR6xKK6itgkvQ/+fyNs6v4XJXIsPwVL+WprCiL8AEUxw5s=\" target=\"_blank\">在演练场中尝试一下<a><p><p>如你所见，核心逻辑完全一致，我们做的只是把它移到一个外部函数中去，并返回需要暴露的状态。和在组件中一样，你也可以在组合式函数中使用所有的<a href=\"/api/#composition-api\">组合式 API<a>。现在，<code>useMouse()<code> 的功能可以在任何组件中轻易复用了。<p><p>更酷的是，你还可以嵌套多个组合式函数：一个组合式函数可以调用一个或多个其他的组合式函数。这使得我们可以像使用多个组件组合成整个应用一样，用多个较小且逻辑独立的单元来组合形成复杂的逻辑。实际上，这正是为什么我们决定将实现了这一设计模式的 API 集合命名为组合式 API。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 18, "_doc_id": "18_5626360320772398922"}}
{"doc_id": "19_6162314156964341256", "text": "其他的组合式函数。这使得我们可以像使用多个组件组合成整个应用一样，用多个较小且逻辑独立的单元来组合形成复杂的逻辑。实际上，这正是为什么我们决定将实现了这一设计模式的 API 集合命名为组合式 API。<p><p>举例来说，我们可以将添加和清除 DOM 事件监听器的逻辑也封装进一个组合式函数中：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">event.js<span><p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { onMounted, onUnmounted } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 19, "_doc_id": "19_6162314156964341256"}}
{"doc_id": "20_3097985034339481056", "text": "><span>import<span><span> { onMounted, onUnmounted } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> function<span><span> useEventListener<span><span>(<span><span>target<span><span>, <span><span>event<span><span>, <span><span>callback<span><span>) {<span><span>\n<span class=\"line\"><span> // 如果你想的话，<span><span>\n<span class=\"line\"><span> // 也可以用字符串形式的 CSS 选择器来寻找目标 DOM 元素<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 20, "_doc_id": "20_3097985034339481056"}}
{"doc_id": "21_2524796796479756718", "text": "pan> // 如果你想的话，<span><span>\n<span class=\"line\"><span> // 也可以用字符串形式的 CSS 选择器来寻找目标 DOM 元素<span><span>\n<span class=\"line\"><span> onMounted<span><span>(() <span><span>=><span><span> target.<span><span>addEventListener<span><span>(event, callback))<span><span>\n<span class=\"line\"><span> onUnmounted<span><span>(() <span><span>=><span><span> target.<span><span>removeEventListener<span><span>(event, callback))<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 21, "_doc_id": "21_2524796796479756718"}}
{"doc_id": "22_1594024008487044451", "text": "pan>=><span><span> target.<span><span>removeEventListener<span><span>(event, callback))<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p>有了它，之前的 <code>useMouse()<code> 组合式函数可以被简化为：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">mouse.js<span><p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { ref } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 22, "_doc_id": "22_1594024008487044451"}}
{"doc_id": "23_8671535507407710299", "text": "><span class=\"line\"><span>import<span><span> { ref } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line highlighted\"><span>import<span><span> { useEventListener } <span><span>from<span><span> './event'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> function<span><span> useMouse<span><span>() {<span><span>\n<span class=\"line\"><span> const<span><span> x<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 23, "_doc_id": "23_8671535507407710299"}}
{"doc_id": "24_566508795536774965", "text": "onst<span><span> x<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>\n<span class=\"line\"><span> const<span><span> y<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line highlighted\"><span> useEventListener<span><span>(window, <span><span>'mousemove'<span><span>, (<span><span>event<span><span>) <span><span>=><span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 24, "_doc_id": "24_566508795536774965"}}
{"doc_id": "25_2313438240796809633", "text": "n>'mousemove'<span><span>, (<span><span>event<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line highlighted\"><span> x.value <span><span>=<span><span> event.pageX<span><span>\n<span class=\"line highlighted\"><span> y.value <span><span>=<span><span> event.pageY<span><span>\n<span class=\"line highlighted\"><span> })<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> return<span><span> { x, y }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 25, "_doc_id": "25_2313438240796809633"}}
{"doc_id": "26_4007485858367681583", "text": "><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> return<span><span> { x, y }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><div class=\"tip custom-block\"><p class=\"custom-block-title\">TIP<p><p>每一个调用 <code>useMouse()<code> 的组件实例会创建其独有的 <code>x<code>、<code>y<code> 状态拷贝，因此他们不会互相影响。如果你想要在组件之间共享状态，请阅读<a href=\"/guide/scaling-up/state-management.html\">状态管理<a>这一章。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 26, "_doc_id": "26_4007485858367681583"}}
{"doc_id": "27_6200545864373760724", "text": "ode> 状态拷贝，因此他们不会互相影响。如果你想要在组件之间共享状态，请阅读<a href=\"/guide/scaling-up/state-management.html\">状态管理<a>这一章。<p><div><h2 id=\"async-state-example\">异步状态示例 <a class=\"header-anchor\" href=\"#async-state-example\">​<a><h2><p><code>useMouse()<code> 组合式函数没有接收任何参数，因此让我们再来看一个需要接收一个参数的组合式函数示例。在做异步数据请求时，我们常常需要处理不同的状态：加载中、加载成功和加载失败。<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 27, "_doc_id": "27_6200545864373760724"}}
{"doc_id": "28_1858743436020847114", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { ref } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> data<span><span> =<span><span> ref<span><span>(<span><span>null<span><span>)<span><span>\n<span class=\"line\"><span>const<span><span> error<span><span> =<span><span> ref<span><span>(<span><span>null<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 28, "_doc_id": "28_1858743436020847114"}}
{"doc_id": "29_7802778461109704674", "text": "an><span> error<span><span> =<span><span> ref<span><span>(<span><span>null<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>fetch<span><span>(<span><span>'...'<span><span>)<span><span>\n<span class=\"line\"><span> .<span><span>then<span><span>((<span><span>res<span><span>) <span><span>=><span><span> res.<span><span>json<span><span>())<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 29, "_doc_id": "29_7802778461109704674"}}
{"doc_id": "30_8709862956124504733", "text": "n><span>res<span><span>) <span><span>=><span><span> res.<span><span>json<span><span>())<span><span>\n<span class=\"line\"><span> .<span><span>then<span><span>((<span><span>json<span><span>) <span><span>=><span><span> (data.value <span><span>=<span><span> json))<span><span>\n<span class=\"line\"><span> .<span><span>catch<span><span>((<span><span>err<span><span>) <span><span>=><span><span> (error.value <span><span>=<span><span> err))<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 30, "_doc_id": "30_8709862956124504733"}}
{"doc_id": "31_6315820468744342648", "text": "rr<span><span>) <span><span>=><span><span> (error.value <span><span>=<span><span> err))<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> v-if<span><span>=<span><span>\"error\"<span><span>>Oops! Error encountered: {{ error.message }}</<span><span>div<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 31, "_doc_id": "31_6315820468744342648"}}
{"doc_id": "32_6427684991985213926", "text": "<span><span>>Oops! Error encountered: {{ error.message }}</<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> v-else-if<span><span>=<span><span>\"data\"<span><span>><span><span>\n<span class=\"line\"><span> Data loaded:<span><span>\n<span class=\"line\"><span> <<span><span>pre<span><span>>{{ data }}</<span><span>pre<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 32, "_doc_id": "32_6427684991985213926"}}
{"doc_id": "33_3511140809031137398", "text": "n>pre<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> v-else<span><span>>Loading...</<span><span>div<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 33, "_doc_id": "33_3511140809031137398"}}
{"doc_id": "34_3696558525294584008", "text": "<span><span>div<span><span> v-else<span><span>>Loading...</<span><span>div<span><span>><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span><code><pre><div><p>如果在每个需要获取数据的组件中都要重复这种模式，那就太繁琐了。让我们把它抽取成一个组合式函数：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">fetch.js<span><p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { ref } <span><span>from<span><span> 'vue'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 34, "_doc_id": "34_3696558525294584008"}}
{"doc_id": "35_4894801485642030070", "text": "><span class=\"line\"><span>import<span><span> { ref } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> function<span><span> useFetch<span><span>(<span><span>url<span><span>) {<span><span>\n<span class=\"line\"><span> const<span><span> data<span><span> =<span><span> ref<span><span>(<span><span>null<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 35, "_doc_id": "35_4894801485642030070"}}
{"doc_id": "36_536465451691253714", "text": "pan><span> data<span><span> =<span><span> ref<span><span>(<span><span>null<span><span>)<span><span>\n<span class=\"line\"><span> const<span><span> error<span><span> =<span><span> ref<span><span>(<span><span>null<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> fetch<span><span>(url)<span><span>\n<span class=\"line\"><span> .<span><span>then<span><span>((<span><span>res<span><span>) <span><span>=><span><span> res.<span><span>json<span><span>())<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 36, "_doc_id": "36_536465451691253714"}}
{"doc_id": "37_5899800954868199532", "text": "n><span>res<span><span>) <span><span>=><span><span> res.<span><span>json<span><span>())<span><span>\n<span class=\"line\"><span> .<span><span>then<span><span>((<span><span>json<span><span>) <span><span>=><span><span> (data.value <span><span>=<span><span> json))<span><span>\n<span class=\"line\"><span> .<span><span>catch<span><span>((<span><span>err<span><span>) <span><span>=><span><span> (error.value <span><span>=<span><span> err))<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 37, "_doc_id": "37_5899800954868199532"}}
{"doc_id": "38_3883703918587624374", "text": "n>=><span><span> (error.value <span><span>=<span><span> err))<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> return<span><span> { data, error }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p>现在我们在组件里只需要：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 38, "_doc_id": "38_3883703918587624374"}}
{"doc_id": "39_5454289543945816451", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { useFetch } <span><span>from<span><span> './fetch.js'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> { <span><span>data<span><span>, <span><span>error<span><span> } <span><span>=<span><span> useFetch<span><span>(<span><span>'...'<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 39, "_doc_id": "39_5454289543945816451"}}
{"doc_id": "40_1441523871573970120", "text": "><span> } <span><span>=<span><span> useFetch<span><span>(<span><span>'...'<span><span>)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><h3 id=\"accepting-reactive-state\">接收响应式状态 <a class=\"header-anchor\" href=\"#accepting-reactive-state\">​<a><h3><p><code>useFetch()<code> 接收一个静态 URL 字符串作为输入——因此它只会执行一次 fetch 并且就此结束。如果我们想要在 URL 改变时重新 fetch 呢？为了实现这一点，我们需要将响应式状态传入组合式函数，并让它基于传入的状态来创建执行操作的侦听器。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 40, "_doc_id": "40_1441523871573970120"}}
{"doc_id": "41_2964937317425989972", "text": "入——因此它只会执行一次 fetch 并且就此结束。如果我们想要在 URL 改变时重新 fetch 呢？为了实现这一点，我们需要将响应式状态传入组合式函数，并让它基于传入的状态来创建执行操作的侦听器。<p><p>举例来说，<code>useFetch()<code> 应该能够接收一个 ref：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> url<span><span> =<span><span> ref<span><span>(<span><span>'/initial-url'<span><span>)<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 41, "_doc_id": "41_2964937317425989972"}}
{"doc_id": "42_7749112327368586537", "text": "span> ref<span><span>(<span><span>'/initial-url'<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> { <span><span>data<span><span>, <span><span>error<span><span> } <span><span>=<span><span> useFetch<span><span>(url)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 这将会重新触发 fetch<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 42, "_doc_id": "42_7749112327368586537"}}
{"doc_id": "43_1839466148303137266", "text": "n>(url)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 这将会重新触发 fetch<span><span>\n<span class=\"line\"><span>url.value <span><span>=<span><span> '/new-url'<span><span><code><pre><div><p>或者接收一个 <a href=\"https://developer.mozilla.org/zh-CN/docs/Web/JavaScript/Reference/Functions/get#description\" target=\"_blank\">getter 函数<a>：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 当 props.id 改变时重新 fetch<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 43, "_doc_id": "43_1839466148303137266"}}
{"doc_id": "44_3591558657743901899", "text": "ss=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 当 props.id 改变时重新 fetch<span><span>\n<span class=\"line\"><span>const<span><span> { <span><span>data<span><span>, <span><span>error<span><span> } <span><span>=<span><span> useFetch<span><span>(() <span><span>=><span><span> `/posts/${<span><span>props<span><span>.<span><span>id<span><span>}`<span><span>)<span><span><code><pre><div><p>我们可以用 <a href=\"/api/reactivity-core.", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 44, "_doc_id": "44_3591558657743901899"}}
{"doc_id": "45_687725853132639836", "text": "pan>id<span><span>}`<span><span>)<span><span><code><pre><div><p>我们可以用 <a href=\"/api/reactivity-core.html#watcheffect\"><code>watchEffect()<code><a> 和 <a href=\"/api/reactivity-utilities.html#tovalue\"><code>toValue()<code><a> API 来重构我们现有的实现：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">fetch.", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 45, "_doc_id": "45_687725853132639836"}}
{"doc_id": "46_430605421353036873", "text": "p-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">fetch.js<span><p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { ref, watchEffect, toValue } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> function<span><span> useFetch<span><span>(<span><span>url<span><span>) {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 46, "_doc_id": "46_430605421353036873"}}
{"doc_id": "47_833256414604089420", "text": "rt<span><span> function<span><span> useFetch<span><span>(<span><span>url<span><span>) {<span><span>\n<span class=\"line\"><span> const<span><span> data<span><span> =<span><span> ref<span><span>(<span><span>null<span><span>)<span><span>\n<span class=\"line\"><span> const<span><span> error<span><span> =<span><span> ref<span><span>(<span><span>null<span><span>)<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 47, "_doc_id": "47_833256414604089420"}}
{"doc_id": "48_6532499675383463527", "text": "> =<span><span> ref<span><span>(<span><span>null<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line highlighted\"><span> const<span><span> fetchData<span><span> =<span><span> () <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> // reset state before fetching..<span><span>\n<span class=\"line\"><span> data.value <span><span>=<span><span> null<span><span>\n<span class=\"line\"><span> error.value <span><span>=<span><span> null<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 48, "_doc_id": "48_6532499675383463527"}}
{"doc_id": "49_7836961692675498431", "text": "lass=\"line\"><span> error.value <span><span>=<span><span> null<span><span>\n<span class=\"line\"><span>\n<span class=\"line highlighted\"><span> fetch<span><span>(<span><span>toValue<span><span>(url))<span><span>\n<span class=\"line\"><span> .<span><span>then<span><span>((<span><span>res<span><span>) <span><span>=><span><span> res.<span><span>json<span><span>())<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 49, "_doc_id": "49_7836961692675498431"}}
{"doc_id": "50_5307774176487255235", "text": "n><span>res<span><span>) <span><span>=><span><span> res.<span><span>json<span><span>())<span><span>\n<span class=\"line\"><span> .<span><span>then<span><span>((<span><span>json<span><span>) <span><span>=><span><span> (data.value <span><span>=<span><span> json))<span><span>\n<span class=\"line\"><span> .<span><span>catch<span><span>((<span><span>err<span><span>) <span><span>=><span><span> (error.value <span><span>=<span><span> err))<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 50, "_doc_id": "50_5307774176487255235"}}
{"doc_id": "51_9047596840494910470", "text": "n>=<span><span> err))<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> watchEffect<span><span>(() <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> fetchData<span><span>()<span><span>\n<span class=\"line\"><span> })<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> return<span><span> { data, error }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p><code>toValue()<code> 是一个在 3.3 版本中新增的 API。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 51, "_doc_id": "51_9047596840494910470"}}
{"doc_id": "52_3201825017226479740", "text": "n class=\"line\"><span>}<span><span><code><pre><div><div><p><code>toValue()<code> 是一个在 3.3 版本中新增的 API。它的设计目的是将 ref 或 getter 规范化为值。如果参数是 ref，它会返回 ref 的值；如果参数是函数，它会调用函数并返回其返回值。否则，它会原样返回参数。它的工作方式类似于 <a href=\"/api/reactivity-utilities.html#unref\"><code>unref()<code><a>，但对函数有特殊处理。<p><p>注意 <code>toValue(url)<code> 是在 <code>watchEffect<code> 回调函数的<strong>内部<strong>调用的。这确保了在 <code>toValue()<code> 规范化期间访问的任何响应式依赖项都会被侦听器跟踪。<p><p>这个版本的 <code>useFetch()<code> 现在能接收静态 URL 字符串、ref 和 getter，使其更加灵活。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 52, "_doc_id": "52_3201825017226479740"}}
{"doc_id": "53_7981095457476285452", "text": "de> 规范化期间访问的任何响应式依赖项都会被侦听器跟踪。<p><p>这个版本的 <code>useFetch()<code> 现在能接收静态 URL 字符串、ref 和 getter，使其更加灵活。watch effect 会立即运行，并且会跟踪 <code>toValue(url)<code> 期间访问的任何依赖项。如果没有跟踪到依赖项 (例如 url 已经是字符串)，则 effect 只会运行一次；否则，它将在跟踪到的任何依赖项更改时重新运行。<p><p>这是<a href=\"https://play.vuejs.org/#eNp9Vdtu20YQ/ZUpUUA0qpAOjL4YktCbC7Rom8BN8sSHrMihtfZql9iLZEHgv2dml6SpxMiDIWkuZ+acmR2fs1+7rjgEzG6zlaut7Dw49KHbVFruO2M9nMFiu4Ta7LvgsYEeWmv2sKCkxSwoOPwTfb2b/EU5mopHR5GVro12HrbC4UerYA2Lnfeduy3LR2d0p0SNO6MatIU/dbI2DRZUtPSmMa4kgJQuG8qkjvLF28XVaAwRb2wx", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 53, "_doc_id": "53_7981095457476285452"}}
{"doc_id": "54_2674048546848608730", "text": "", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 54, "_doc_id": "54_2674048546848608730"}}
{"doc_id": "55_411911089811691074", "text": "", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 55, "_doc_id": "55_411911089811691074"}}
{"doc_id": "56_2262418578848554976", "text": "JOcjTXe+obScHwaAi82lo9dC/q/wuyINjrwbuC5uZrS4WAQeyTN9ftOXIVwy537iecoX92kR4q/F1UvqIMsSbq6vo5XF6ekCeEcTauVDFJpuQESvMv53IBXadx3r4KqMrt0w0kwoZY5/R5u3AZejvd5h/fSK/dE9s63K3vN7tQesssnnhX1An9x3//+Hz/R9cu5NExRFf8d5zyIF7jGF/RZ0Q23P4mK3f8XLRmfhg7t79qjdSIobjXLE+Cqju/b7d6i/tHtT3MQ8VrH/Ahstp5A=\" target=\"_blank\">更新后的 <code>useFetch()<code><a>，为了便于演示，添加了人为延迟和随机错误。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 56, "_doc_id": "56_2262418578848554976"}}
{"doc_id": "57_2469967445909762540", "text": "Cqju/b7d6i/tHtT3MQ8VrH/Ahstp5A=\" target=\"_blank\">更新后的 <code>useFetch()<code><a>，为了便于演示，添加了人为延迟和随机错误。<p><h2 id=\"conventions-and-best-practices\">约定和最佳实践 <a class=\"header-anchor\" href=\"#conventions-and-best-practices\">​<a><h2><h3 id=\"naming\">命名 <a class=\"header-anchor\" href=\"#naming\">​<a><h3><p>组合式函数约定用驼峰命名法命名，并以“use”作为开头。<p><h3 id=\"input-arguments\">输入参数 <a class=\"header-anchor\" href=\"#input-arguments\">​<a><h3><p>即便不依赖于 ref 或 getter 的响应性，组合式函数也可以接收它们作为参数。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 57, "_doc_id": "57_2469967445909762540"}}
{"doc_id": "58_5131283951938799070", "text": "class=\"header-anchor\" href=\"#input-arguments\">​<a><h3><p>即便不依赖于 ref 或 getter 的响应性，组合式函数也可以接收它们作为参数。如果你正在编写一个可能被其他开发者使用的组合式函数，最好处理一下输入参数是 ref 或 getter 而非原始值的情况。可以利用 <a href=\"/api/reactivity-utilities.html#tovalue\"><code>toValue()<code><a> 工具函数来实现：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { toValue } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 58, "_doc_id": "58_5131283951938799070"}}
{"doc_id": "59_2395215089892064427", "text": "rt<span><span> { toValue } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>function<span><span> useFeature<span><span>(<span><span>maybeRefOrGetter<span><span>) {<span><span>\n<span class=\"line\"><span> // 如果 maybeRefOrGetter 是一个 ref 或 getter，<span><span>\n<span class=\"line\"><span> // 将返回它的规范化值。<span><span>\n<span class=\"line\"><span> // 否则原样返回。<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 59, "_doc_id": "59_2395215089892064427"}}
{"doc_id": "60_3919981922212827771", "text": "span class=\"line\"><span> // 将返回它的规范化值。<span><span>\n<span class=\"line\"><span> // 否则原样返回。<span><span>\n<span class=\"line\"><span> const<span><span> value<span><span> =<span><span> toValue<span><span>(maybeRefOrGetter)<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>如果你的组合式函数在输入参数是 ref 或 getter 的情况下创建了响应式 effect，为了让它能够被正确追踪，请确保要么使用 <code>watch()<code> 显式地监视 ref 或 getter，要么在 <code>watchEffect()<code> 中调用 <code>toValue()<code>。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 60, "_doc_id": "60_3919981922212827771"}}
{"doc_id": "61_5982222763182358611", "text": "要么使用 <code>watch()<code> 显式地监视 ref 或 getter，要么在 <code>watchEffect()<code> 中调用 <code>toValue()<code>。<p><p><a href=\"#accepting-reactive-state\">前面讨论过的 useFetch() 实现<a>提供了一个接受 ref、getter 或普通值作为输入参数的组合式函数的具体示例。<p><h3 id=\"return-values\">返回值 <a class=\"header-anchor\" href=\"#return-values\">​<a><h3><p>你可能已经注意到了，我们一直在组合式函数中使用 <code>ref()<code> 而不是 <code>reactive()<code>。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 61, "_doc_id": "61_5982222763182358611"}}
{"doc_id": "62_273390955220886806", "text": "ef=\"#return-values\">​<a><h3><p>你可能已经注意到了，我们一直在组合式函数中使用 <code>ref()<code> 而不是 <code>reactive()<code>。我们推荐的约定是组合式函数始终返回一个包含多个 ref 的普通的非响应式对象，这样该对象在组件中被解构为 ref 之后仍可以保持响应性：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// x 和 y 是两个 ref<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 62, "_doc_id": "62_273390955220886806"}}
{"doc_id": "63_1330107100301496429", "text": "><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// x 和 y 是两个 ref<span><span>\n<span class=\"line\"><span>const<span><span> { <span><span>x<span><span>, <span><span>y<span><span> } <span><span>=<span><span> useMouse<span><span>()<span><span><code><pre><div><p>从组合式函数返回一个响应式对象会导致在对象解构过程中丢失与组合式函数内状态的响应性连接。与之相反，ref 则可以维持这一响应性连接。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 63, "_doc_id": "63_1330107100301496429"}}
{"doc_id": "64_2546825558767937527", "text": ">()<span><span><code><pre><div><p>从组合式函数返回一个响应式对象会导致在对象解构过程中丢失与组合式函数内状态的响应性连接。与之相反，ref 则可以维持这一响应性连接。<p><p>如果你更希望以对象属性的形式来使用组合式函数中返回的状态，你可以将返回的对象用 <code>reactive()<code> 包装一次，这样其中的 ref 会被自动解包，例如：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> mouse<span><span> =<span><span> reactive<span><span>(<span><span>useMouse<span><span>())<span><span>\n<span class=\"line\"><span>// mouse.x 链接到了原来的 x ref<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 64, "_doc_id": "64_2546825558767937527"}}
{"doc_id": "65_7746980827904477513", "text": "n>useMouse<span><span>())<span><span>\n<span class=\"line\"><span>// mouse.x 链接到了原来的 x ref<span><span>\n<span class=\"line\"><span>console.<span><span>log<span><span>(mouse.x)<span><span><code><pre><div><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>Mouse position is at: {{ mouse.x }}, {{ mouse.y }}<span><span><code><pre><div><h3 id=\"side-effects\">副作用 <a class=\"header-anchor\" href=\"#side-effects\">​<a><h3><p>在组合式函数中的确可以执行副作用 (例如：添加 DOM 事件监听器或者请求数据)，", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 65, "_doc_id": "65_7746980827904477513"}}
{"doc_id": "66_6343510775512791048", "text": "用 <a class=\"header-anchor\" href=\"#side-effects\">​<a><h3><p>在组合式函数中的确可以执行副作用 (例如：添加 DOM 事件监听器或者请求数据)，但请注意以下规则：<p><ul><li><p>如果你的应用用到了<a href=\"/guide/scaling-up/ssr.html\">服务端渲染<a> (SSR)，请确保在组件挂载后才调用的生命周期钩子中执行 DOM 相关的副作用，例如：<code>onMounted()<code>。这些钩子仅会在浏览器中被调用，因此可以确保能访问到 DOM。<p><li><li><p>确保在 <code>onUnmounted()<code> 时清理副作用。举例来说，如果一个组合式函数设置了一个事件监听器，它就应该在 <code>onUnmounted()<code> 中被移除 (就像我们在 <code>useMouse()<code> 示例中看到的一样)。当然也可以像之前的 <code>useEventListener()<code> 示例那样，使用一个组合式函数来自动帮你做这些事。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 66, "_doc_id": "66_6343510775512791048"}}
{"doc_id": "67_3692173275816274969", "text": "在 <code>useMouse()<code> 示例中看到的一样)。当然也可以像之前的 <code>useEventListener()<code> 示例那样，使用一个组合式函数来自动帮你做这些事。<p><li><ul><h3 id=\"usage-restrictions\">使用限制 <a class=\"header-anchor\" href=\"#usage-restrictions\">​<a><h3><p>组合式函数只能在 <code><script setup><code> 或 <code>setup()<code> 钩子中被调用。在这些上下文中，它们也只能被<strong>同步<strong>调用。在某些情况下，你也可以在像 <code>onMounted()<code> 这样的生命周期钩子中调用它们。<p><p>这些限制很重要，因为这些是 Vue 用于确定当前活跃的组件实例的上下文。访问活跃的组件实例很有必要，这样才能：<p><ol><li><p>将生命周期钩子注册到该组件实例上<p><li><li><p>将计算属性和监听器注册到该组件实例上，以便在该组件被卸载时停止监听，避免内存泄漏。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 67, "_doc_id": "67_3692173275816274969"}}
{"doc_id": "68_5882736219967426741", "text": "的组件实例很有必要，这样才能：<p><ol><li><p>将生命周期钩子注册到该组件实例上<p><li><li><p>将计算属性和监听器注册到该组件实例上，以便在该组件被卸载时停止监听，避免内存泄漏。<p><li><ol><div class=\"tip custom-block\"><p class=\"custom-block-title\">TIP<p><p><code><script setup><code> 是唯一在调用 <code>await<code> <strong>之后<strong>仍可调用组合式函数的地方。编译器会在异步操作之后自动为你恢复当前的组件实例。<p><div><h2 id=\"extracting-composables-for-code-organization\">通过抽取组合式函数改善代码结构 <a class=\"header-anchor\" href=\"#extracting-composables-for-code-organization\">​<a><h2><p>抽取组合式函数不仅是为了复用，也是为了代码组织。随着组件复杂度的增高，你可能会最终发现组件多得难以查询和理解。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 68, "_doc_id": "68_5882736219967426741"}}
{"doc_id": "69_1775578702472373271", "text": "omposables-for-code-organization\">​<a><h2><p>抽取组合式函数不仅是为了复用，也是为了代码组织。随着组件复杂度的增高，你可能会最终发现组件多得难以查询和理解。组合式 API 会给予你足够的灵活性，让你可以基于逻辑问题将组件代码拆分成更小的函数：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { useFeatureA } <span><span>from<span><span> './featureA.js'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 69, "_doc_id": "69_1775578702472373271"}}
{"doc_id": "70_6269961318611715010", "text": "\"><span>import<span><span> { useFeatureA } <span><span>from<span><span> './featureA.js'<span><span>\n<span class=\"line\"><span>import<span><span> { useFeatureB } <span><span>from<span><span> './featureB.js'<span><span>\n<span class=\"line\"><span>import<span><span> { useFeatureC } <span><span>from<span><span> './featureC.js'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 70, "_doc_id": "70_6269961318611715010"}}
{"doc_id": "71_4611284842490079050", "text": "{ useFeatureC } <span><span>from<span><span> './featureC.js'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> { <span><span>foo<span><span>, <span><span>bar<span><span> } <span><span>=<span><span> useFeatureA<span><span>()<span><span>\n<span class=\"line\"><span>const<span><span> { <span><span>baz<span><span> } <span><span>=<span><span> useFeatureB<span><span>(foo)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 71, "_doc_id": "71_4611284842490079050"}}
{"doc_id": "72_3625886597960807421", "text": "{ <span><span>baz<span><span> } <span><span>=<span><span> useFeatureB<span><span>(foo)<span><span>\n<span class=\"line\"><span>const<span><span> { <span><span>qux<span><span> } <span><span>=<span><span> useFeatureC<span><span>(baz)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><p>在某种程度上，你可以将这些提取出的组合式函数看作是可以相互通信的组件范围内的服务。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 72, "_doc_id": "72_3625886597960807421"}}
{"doc_id": "73_2888896990343657556", "text": "an><span>script<span><span>><span><span><code><pre><div><p>在某种程度上，你可以将这些提取出的组合式函数看作是可以相互通信的组件范围内的服务。<p><h2 id=\"using-composables-in-options-api\">在选项式 API 中使用组合式函数 <a class=\"header-anchor\" href=\"#using-composables-in-options-api\">​<a><h2><p>如果你正在使用选项式 API，组合式函数必须在 <code>setup()<code> 中调用。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 73, "_doc_id": "73_2888896990343657556"}}
{"doc_id": "74_9175962782806008139", "text": "href=\"#using-composables-in-options-api\">​<a><h2><p>如果你正在使用选项式 API，组合式函数必须在 <code>setup()<code> 中调用。且其返回的绑定必须在 <code>setup()<code> 中返回，以便暴露给 <code>this<code> 及其模板：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { useMouse } <span><span>from<span><span> './mouse.js'<span><span>\n<span class=\"line\"><span>import<span><span> { useFetch } <span><span>from<span><span> './fetch.js'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 74, "_doc_id": "74_9175962782806008139"}}
{"doc_id": "75_6864817038471051148", "text": "<span> { useFetch } <span><span>from<span><span> './fetch.js'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> setup<span><span>() {<span><span>\n<span class=\"line\"><span> const<span><span> { <span><span>x<span><span>, <span><span>y<span><span> } <span><span>=<span><span> useMouse<span><span>()<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 75, "_doc_id": "75_6864817038471051148"}}
{"doc_id": "76_4099952000819616056", "text": "an><span>, <span><span>y<span><span> } <span><span>=<span><span> useMouse<span><span>()<span><span>\n<span class=\"line\"><span> const<span><span> { <span><span>data<span><span>, <span><span>error<span><span> } <span><span>=<span><span> useFetch<span><span>(<span><span>'...'<span><span>)<span><span>\n<span class=\"line\"><span> return<span><span> { x, y, data, error }<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> mounted<span><span>() {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 76, "_doc_id": "76_4099952000819616056"}}
{"doc_id": "77_38320362631925842", "text": "an class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> mounted<span><span>() {<span><span>\n<span class=\"line\"><span> // setup() 暴露的属性可以在通过 `this` 访问到<span><span>\n<span class=\"line\"><span> console.<span><span>log<span><span>(<span><span>this<span><span>.x)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> // ...其他选项<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 77, "_doc_id": "77_38320362631925842"}}
{"doc_id": "78_5700109037037057365", "text": "pan><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> // ...其他选项<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><h2 id=\"comparisons-with-other-techniques\">与其他模式的比较 <a class=\"header-anchor\" href=\"#comparisons-with-other-techniques\">​<a><h2><h3 id=\"vs-mixins\">和 Mixin 的对比 <a class=\"header-anchor\" href=\"#vs-mixins\">​<a><h3><p>Vue 2 的用户可能会对 <a href=\"/api/options-composition.html#mixins\">mixins<a> 选项比较熟悉。它也让我们能够把组件逻辑提取到可复用的单元里。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 78, "_doc_id": "78_5700109037037057365"}}
{"doc_id": "79_5080123897646010684", "text": "ue 2 的用户可能会对 <a href=\"/api/options-composition.html#mixins\">mixins<a> 选项比较熟悉。它也让我们能够把组件逻辑提取到可复用的单元里。然而 mixins 有三个主要的短板：<p><ol><li><p><strong>不清晰的数据来源<strong>：当使用了多个 mixin 时，实例上的数据属性来自哪个 mixin 变得不清晰，这使追溯实现和理解组件行为变得困难。这也是我们推荐在组合式函数中使用 ref + 解构模式的理由：让属性的来源在消费组件时一目了然。<p><li><li><p><strong>命名空间冲突<strong>：多个来自不同作者的 mixin 可能会注册相同的属性名，造成命名冲突。若使用组合式函数，你可以通过在解构变量时对变量进行重命名来避免相同的键名。<p><li><li><p><strong>隐式的跨 mixin 交流<strong>：多个 mixin 需要依赖共享的属性名来进行相互作用，这使得它们隐性地耦合在一起。而一个组合式函数的返回值可以作为另一个组合式函数的参数被传入，像普通函数那样。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 79, "_doc_id": "79_5080123897646010684"}}
{"doc_id": "80_4821228682190819331", "text": "的跨 mixin 交流<strong>：多个 mixin 需要依赖共享的属性名来进行相互作用，这使得它们隐性地耦合在一起。而一个组合式函数的返回值可以作为另一个组合式函数的参数被传入，像普通函数那样。<p><li><ol><p>基于上述理由，我们不再推荐在 Vue 3 中继续使用 mixin。保留该功能只是为了项目迁移的需求和照顾熟悉它的用户。<p><h3 id=\"vs-renderless-components\">和无渲染组件的对比 <a class=\"header-anchor\" href=\"#vs-renderless-components\">​<a><h3><p>在组件插槽一章中，我们讨论过了基于作用域插槽的<a href=\"/guide/components/slots.html#renderless-components\">无渲染组件<a>。我们甚至用它实现了一样的鼠标追踪器示例。<p><p>组合式函数相对于无渲染组件的主要优势是：组合式函数不会产生额外的组件实例开销。当在整个应用中使用时，由无渲染组件产生的额外组件实例会带来无法忽视的性能开销。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 80, "_doc_id": "80_4821228682190819331"}}
{"doc_id": "81_1043122677701176133", "text": "用它实现了一样的鼠标追踪器示例。<p><p>组合式函数相对于无渲染组件的主要优势是：组合式函数不会产生额外的组件实例开销。当在整个应用中使用时，由无渲染组件产生的额外组件实例会带来无法忽视的性能开销。<p><p>我们推荐在纯逻辑复用时使用组合式函数，在需要同时复用逻辑和视图布局时使用无渲染组件。<p><h3 id=\"vs-react-hooks\">和 React Hooks 的对比 <a class=\"header-anchor\" href=\"#vs-react-hooks\">​<a><h3><p>如果你有 React 的开发经验，你可能注意到组合式函数和自定义 React hooks 非常相似。组合式 API 的一部分灵感正来自于 React hooks，Vue 的组合式函数也的确在逻辑组合能力上与 React hooks 相近。然而，Vue 的组合式函数是基于 Vue 细粒度的响应性系统，这和 React hooks 的执行模型有本质上的不同。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 81, "_doc_id": "81_1043122677701176133"}}
{"doc_id": "82_8622037736974326919", "text": "ks，Vue 的组合式函数也的确在逻辑组合能力上与 React hooks 相近。然而，Vue 的组合式函数是基于 Vue 细粒度的响应性系统，这和 React hooks 的执行模型有本质上的不同。这一话题在<a href=\"/guide/extras/composition-api-faq.html#comparison-with-react-hooks\">组合式 API 的常见问题<a>中有更细致的讨论。<p><h2 id=\"further-reading\">延伸阅读 <a class=\"header-anchor\" href=\"#further-reading\">​<a><h2><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/composables.html", "title": "组合式函数", "doc_id": "4c7bb0df1de44503989fedfdc6ece2dd", "content_type": "web_page", "word_count": 1263, "chunk_index": 82, "_doc_id": "82_8622037736974326919"}}
{"doc_id": "0_4936996115793506973", "text": "<div><div><h1 id=\"custom-directives\">自定义指令 <a class=\"header-anchor\" href=\"#custom-directives\">​<a><h1><h2 id=\"introduction\">介绍 <a class=\"header-anchor\" href=\"#introduction\">​<a><h2><p>除了 Vue 内置的一系列指令 (比如 <code>v-model<code> 或 <code>v-show<code>) 之外，Vue 还允许你注册自定义的指令 (Custom Directives)。<p><p>我们已经介绍了两种在 Vue 中重用代码的方式：<a href=\"/guide/essentials/component-basics.html\">组件<a>和<a href=\"./composables.html\">组合式函数<a>。组件是主要的构建模块，而组合式函数则侧重于有状态的逻辑。另一方面，自定义指令主要是为了重用涉及普通元素的底层 DOM 访问的逻辑。<p><p>一个自定义指令由一个包含类似组件生命周期钩子的对象来定义。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 0, "_doc_id": "0_4936996115793506973"}}
{"doc_id": "1_4576225682316773330", "text": "组件是主要的构建模块，而组合式函数则侧重于有状态的逻辑。另一方面，自定义指令主要是为了重用涉及普通元素的底层 DOM 访问的逻辑。<p><p>一个自定义指令由一个包含类似组件生命周期钩子的对象来定义。钩子函数会接收到指令所绑定元素作为其参数。下面是一个自定义指令的例子，当 Vue 将元素插入到 DOM 中后，该指令会将一个 class 添加到元素中：<p><div class=\"composition-api\"><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>// 在模板中启用 v-highlight<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 1, "_doc_id": "1_4576225682316773330"}}
{"doc_id": "2_2265665949377366890", "text": "an><span> setup<span><span>><span><span>\n<span class=\"line\"><span>// 在模板中启用 v-highlight<span><span>\n<span class=\"line\"><span>const<span><span> vHighlight<span><span> =<span><span> {<span><span>\n<span class=\"line\"><span> mounted<span><span>: (<span><span>el<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> el.classList.<span><span>add<span><span>(<span><span>'is-highlight'<span><span>)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 2, "_doc_id": "2_2265665949377366890"}}
{"doc_id": "3_3793479932205133206", "text": "><span>)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span> v-highlight<span><span>>This sentence is important!</<span><span>p<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 3, "_doc_id": "3_3793479932205133206"}}
{"doc_id": "4_4326071410793857437", "text": "><span> v-highlight<span><span>>This sentence is important!</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span><code><pre><div><div><div class=\"options-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> highlight<span><span> =<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 4, "_doc_id": "4_4326071410793857437"}}
{"doc_id": "5_300359654357300350", "text": "><code><span class=\"line\"><span>const<span><span> highlight<span><span> =<span><span> {<span><span>\n<span class=\"line\"><span> mounted<span><span>: (<span><span>el<span><span>) <span><span>=><span><span> el.classList.<span><span>add<span><span>(<span><span>'is-highlight'<span><span>)<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> directives: {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 5, "_doc_id": "5_300359654357300350"}}
{"doc_id": "6_1397375880177926015", "text": "t<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> directives: {<span><span>\n<span class=\"line\"><span> // 在模板中启用 v-highlight<span><span>\n<span class=\"line\"><span> highlight<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 6, "_doc_id": "6_1397375880177926015"}}
{"doc_id": "7_4471367492866326138", "text": "span><span>\n<span class=\"line\"><span> highlight<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>p<span><span> v-highlight<span><span>>This sentence is important!</<span><span>p<span><span>><span><span><code><pre><div><div><div class=\"demo\"><p>This sentence is important!<p><div><div class=\"composition-api\"><p>在 <code><script setup><code> 中，任何以 <code>v<code> 开头的驼峰式命名的变量都可以当作自定义指令使用。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 7, "_doc_id": "7_4471367492866326138"}}
{"doc_id": "8_3806090618611181558", "text": "class=\"composition-api\"><p>在 <code><script setup><code> 中，任何以 <code>v<code> 开头的驼峰式命名的变量都可以当作自定义指令使用。在上述例子中，<code>vHighlight<code> 可以在模板中以 <code>v-highlight<code> 的形式使用。<p><p>在不使用 <code><script setup><code> 的情况下，自定义指令需要通过 <code>directives<code> 选项注册：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> setup<span><span>() {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 8, "_doc_id": "8_3806090618611181558"}}
{"doc_id": "9_3864125965280497274", "text": "span> default<span><span> {<span><span>\n<span class=\"line\"><span> setup<span><span>() {<span><span>\n<span class=\"line\"><span> /*...*/<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> directives: {<span><span>\n<span class=\"line\"><span> // 在模板中启用 v-highlight<span><span>\n<span class=\"line\"><span> highlight: {<span><span>\n<span class=\"line\"><span> /* ... */<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 9, "_doc_id": "9_3864125965280497274"}}
{"doc_id": "10_4571149499379582031", "text": "... */<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><div class=\"options-api\"><p>和组件类似，自定义指令在模板中使用前必须先注册。在上面的例子中，我们使用 <code>directives<code> 选项完成了指令的局部注册。<p><div><p>将一个自定义指令全局注册到应用层级也是一种常见的做法：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> app<span><span> =<span><span> createApp<span><span>({})<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 10, "_doc_id": "10_4571149499379582031"}}
{"doc_id": "11_305538269856170579", "text": "=\"line\"><span>const<span><span> app<span><span> =<span><span> createApp<span><span>({})<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 使 v-highlight 在所有组件中都可用<span><span>\n<span class=\"line\"><span>app.<span><span>directive<span><span>(<span><span>'highlight'<span><span>, {<span><span>\n<span class=\"line\"><span> /* ... */<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><p>通过扩展 <code>vue<code> 中的 <code>ComponentCustomProperties<code> 接口，可以为自定义的全局指令添加类型。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 11, "_doc_id": "11_305538269856170579"}}
{"doc_id": "12_1802672745088788783", "text": "<code><pre><div><p>通过扩展 <code>vue<code> 中的 <code>ComponentCustomProperties<code> 接口，可以为自定义的全局指令添加类型。<p><p>更多细节参考：<a href=\"/guide/typescript/composition-api.html#typing-global-custom-directives\">为自定义全局指令添加类型<a> <p><h2 id=\"when-to-use\">自定义指令的使用时机 <a class=\"header-anchor\" href=\"#when-to-use\">​<a><h2><p>只有当所需功能只能通过直接的 DOM 操作来实现时，才应该使用自定义指令。<p><p>一个常见例子是使元素获取焦点的 <code>v-focus<code> 指令。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 12, "_doc_id": "12_1802672745088788783"}}
{"doc_id": "13_4595826270812293981", "text": "o-use\">​<a><h2><p>只有当所需功能只能通过直接的 DOM 操作来实现时，才应该使用自定义指令。<p><p>一个常见例子是使元素获取焦点的 <code>v-focus<code> 指令。<p><div class=\"composition-api\"><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>// 在模板中启用 v-focus<span><span>\n<span class=\"line\"><span>const<span><span> vFocus<span><span> =<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 13, "_doc_id": "13_4595826270812293981"}}
{"doc_id": "14_276853647708462936", "text": "an><span>\n<span class=\"line\"><span>const<span><span> vFocus<span><span> =<span><span> {<span><span>\n<span class=\"line\"><span> mounted<span><span>: (<span><span>el<span><span>) <span><span>=><span><span> el.<span><span>focus<span><span>()<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 14, "_doc_id": "14_276853647708462936"}}
{"doc_id": "15_7759366352279599518", "text": ">\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>input<span><span> v-focus<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span><code><pre><div><div><div class=\"options-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> focus<span><span> =<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 15, "_doc_id": "15_7759366352279599518"}}
{"doc_id": "16_3134244627004408784", "text": "ode\"><code><span class=\"line\"><span>const<span><span> focus<span><span> =<span><span> {<span><span>\n<span class=\"line\"><span> mounted<span><span>: (<span><span>el<span><span>) <span><span>=><span><span> el.<span><span>focus<span><span>()<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> directives: {<span><span>\n<span class=\"line\"><span> // 在模板中启用 v-focus<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 16, "_doc_id": "16_3134244627004408784"}}
{"doc_id": "17_6650299634259822072", "text": "ass=\"line\"><span> directives: {<span><span>\n<span class=\"line\"><span> // 在模板中启用 v-focus<span><span>\n<span class=\"line\"><span> focus<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 17, "_doc_id": "17_6650299634259822072"}}
{"doc_id": "18_3010723294224767608", "text": "cus<span><span>\n<span class=\"line\"><span> focus<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>input<span><span> v-focus<span><span> /><span><span><code><pre><div><div><p>该指令比 <code>autofocus<code> 属性更有用，因为它不仅在页面加载时有效，而且在 Vue 动态插入元素时也有效！<p><p>建议尽可能使用 <code>v-bind<code> 等内置指令声明模板，因为它们更高效，对服务端渲染也更友好。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 18, "_doc_id": "18_3010723294224767608"}}
{"doc_id": "19_2361924872320388882", "text": "性更有用，因为它不仅在页面加载时有效，而且在 Vue 动态插入元素时也有效！<p><p>建议尽可能使用 <code>v-bind<code> 等内置指令声明模板，因为它们更高效，对服务端渲染也更友好。<p><h2 id=\"directive-hooks\">指令钩子 <a class=\"header-anchor\" href=\"#directive-hooks\">​<a><h2><p>一个指令的定义对象可以提供几种钩子函数 (都是可选的)：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> myDirective<span><span> =<span><span> {<span><span>\n<span class=\"line\"><span> // 在绑定元素的 attribute 前<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 19, "_doc_id": "19_2361924872320388882"}}
{"doc_id": "20_8471838246390527593", "text": "span><span> =<span><span> {<span><span>\n<span class=\"line\"><span> // 在绑定元素的 attribute 前<span><span>\n<span class=\"line\"><span> // 或事件监听器应用前调用<span><span>\n<span class=\"line\"><span> created<span><span>(<span><span>el<span><span>, <span><span>binding<span><span>, <span><span>vnode<span><span>) {<span><span>\n<span class=\"line\"><span> // 下面会介绍各个参数的细节<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> // 在元素被插入到 DOM 前调用<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 20, "_doc_id": "20_8471838246390527593"}}
{"doc_id": "21_3365889527089085230", "text": ">\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> // 在元素被插入到 DOM 前调用<span><span>\n<span class=\"line\"><span> beforeMount<span><span>(<span><span>el<span><span>, <span><span>binding<span><span>, <span><span>vnode<span><span>) {},<span><span>\n<span class=\"line\"><span> // 在绑定元素的父组件<span><span>\n<span class=\"line\"><span> // 及他自己的所有子节点都挂载完成后调用<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 21, "_doc_id": "21_3365889527089085230"}}
{"doc_id": "22_8842081860751451888", "text": "=\"line\"><span> // 在绑定元素的父组件<span><span>\n<span class=\"line\"><span> // 及他自己的所有子节点都挂载完成后调用<span><span>\n<span class=\"line\"><span> mounted<span><span>(<span><span>el<span><span>, <span><span>binding<span><span>, <span><span>vnode<span><span>) {},<span><span>\n<span class=\"line\"><span> // 绑定元素的父组件更新前调用<span><span>\n<span class=\"line\"><span> beforeUpdate<span><span>(<span><span>el<span><span>, <span><span>binding<span><span>, <span><span>vnode<span><span>, <span><span>prevVnode<span><span>) {},<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 22, "_doc_id": "22_8842081860751451888"}}
{"doc_id": "23_5253205252361059428", "text": "ding<span><span>, <span><span>vnode<span><span>, <span><span>prevVnode<span><span>) {},<span><span>\n<span class=\"line\"><span> // 在绑定元素的父组件<span><span>\n<span class=\"line\"><span> // 及他自己的所有子节点都更新后调用<span><span>\n<span class=\"line\"><span> updated<span><span>(<span><span>el<span><span>, <span><span>binding<span><span>, <span><span>vnode<span><span>, <span><span>prevVnode<span><span>) {},<span><span>\n<span class=\"line\"><span> // 绑定元素的父组件卸载前调用<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 23, "_doc_id": "23_5253205252361059428"}}
{"doc_id": "24_208827483997569662", "text": "<span>prevVnode<span><span>) {},<span><span>\n<span class=\"line\"><span> // 绑定元素的父组件卸载前调用<span><span>\n<span class=\"line\"><span> beforeUnmount<span><span>(<span><span>el<span><span>, <span><span>binding<span><span>, <span><span>vnode<span><span>) {},<span><span>\n<span class=\"line\"><span> // 绑定元素的父组件卸载后调用<span><span>\n<span class=\"line\"><span> unmounted<span><span>(<span><span>el<span><span>, <span><span>binding<span><span>, <span><span>vnode<span><span>) {}<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 24, "_doc_id": "24_208827483997569662"}}
{"doc_id": "25_9030883566198232201", "text": "span>el<span><span>, <span><span>binding<span><span>, <span><span>vnode<span><span>) {}<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><h3 id=\"hook-arguments\">钩子参数 <a class=\"header-anchor\" href=\"#hook-arguments\">​<a><h3><p>指令的钩子会传递以下几种参数：<p><p>举例来说，", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 25, "_doc_id": "25_9030883566198232201"}}
{"doc_id": "26_6749895163955012619", "text": "rguments\">钩子参数 <a class=\"header-anchor\" href=\"#hook-arguments\">​<a><h3><p>指令的钩子会传递以下几种参数：<p><p>举例来说，像下面这样使用指令：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> v-example<span><span>:<span><span>foo<span><span>.<span><span>bar<span><span>=<span><span>\"<span><span>baz<span><span>\"<span><span>><span><span><code><pre><div><p><code>binding<code> 参数会是一个这样的对象：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>{<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 26, "_doc_id": "26_6749895163955012619"}}
{"doc_id": "27_6085814655305516967", "text": "=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>{<span><span>\n<span class=\"line\"><span> arg<span><span>: <span><span>'foo'<span><span>,<span><span>\n<span class=\"line\"><span> modifiers<span><span>: { <span><span>bar<span><span>: <span><span>true<span><span> },<span><span>\n<span class=\"line\"><span> value<span><span>: <span><span>/* `baz` 的值 */<span><span>,<span><span>\n<span class=\"line\"><span> oldValue<span><span>: <span><span>/* 上一次更新时 `baz` 的值 */<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 27, "_doc_id": "27_6085814655305516967"}}
{"doc_id": "28_47753632511962328", "text": "span>\n<span class=\"line\"><span> oldValue<span><span>: <span><span>/* 上一次更新时 `baz` 的值 */<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>和内置指令类似，自定义指令的参数也可以是动态的。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 28, "_doc_id": "28_47753632511962328"}}
{"doc_id": "29_4472410106953711706", "text": "的值 */<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>和内置指令类似，自定义指令的参数也可以是动态的。举例来说：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> v-example:<span><span>[<span><span>arg<span><span>]=<span><span>\"value\"<span><span>></<span><span>div<span><span>><span><span><code><pre><div><p>这里指令的参数会基于组件的 <code>arg<code> 数据属性响应式地更新。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 29, "_doc_id": "29_4472410106953711706"}}
{"doc_id": "30_1749559985005093124", "text": "<span><span>div<span><span>><span><span><code><pre><div><p>这里指令的参数会基于组件的 <code>arg<code> 数据属性响应式地更新。<p><div class=\"tip custom-block\"><p class=\"custom-block-title\">Note<p><p>除了 <code>el<code> 外，其他参数都是只读的，不要更改它们。若你需要在不同的钩子间共享信息，推荐通过元素的 <a href=\"https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/dataset\" target=\"_blank\">dataset<a> attribute 实现。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 30, "_doc_id": "30_1749559985005093124"}}
{"doc_id": "31_6092583910737958366", "text": "veloper.mozilla.org/en-US/docs/Web/API/HTMLElement/dataset\" target=\"_blank\">dataset<a> attribute 实现。<p><div><h2 id=\"function-shorthand\">简化形式 <a class=\"header-anchor\" href=\"#function-shorthand\">​<a><h2><p>对于自定义指令来说，一个很常见的情况是仅仅需要在 <code>mounted<code> 和 <code>updated<code> 上实现相同的行为，除此之外并不需要其他钩子。这种情况下我们可以直接用一个函数来定义指令，", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 31, "_doc_id": "31_6092583910737958366"}}
{"doc_id": "32_1588792238883662359", "text": "个很常见的情况是仅仅需要在 <code>mounted<code> 和 <code>updated<code> 上实现相同的行为，除此之外并不需要其他钩子。这种情况下我们可以直接用一个函数来定义指令，如下所示：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> v-color<span><span>=<span><span>\"<span><span>color<span><span>\"<span><span>></<span><span>div<span><span>><span><span><code><pre><div><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>app.<span><span>directive<span><span>(<span><span>'color'<span><span>,", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 32, "_doc_id": "32_1588792238883662359"}}
{"doc_id": "33_3162558646259435978", "text": "ode><span class=\"line\"><span>app.<span><span>directive<span><span>(<span><span>'color'<span><span>, (<span><span>el<span><span>, <span><span>binding<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> // 这会在 `mounted` 和 `updated` 时都调用<span><span>\n<span class=\"line\"><span> el.style.color <span><span>=<span><span> binding.value<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 33, "_doc_id": "33_3162558646259435978"}}
{"doc_id": "34_1739609004948198872", "text": "<span>\n<span class=\"line\"><span> el.style.color <span><span>=<span><span> binding.value<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><h2 id=\"object-literals\">对象字面量 <a class=\"header-anchor\" href=\"#object-literals\">​<a><h2><p>如果你的指令需要多个值，你可以向它传递一个 JavaScript 对象字面量。别忘了，指令也可以接收任何合法的 JavaScript 表达式。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 34, "_doc_id": "34_1739609004948198872"}}
{"doc_id": "35_321160523916089893", "text": "#object-literals\">​<a><h2><p>如果你的指令需要多个值，你可以向它传递一个 JavaScript 对象字面量。别忘了，指令也可以接收任何合法的 JavaScript 表达式。<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> v-demo<span><span>=<span><span>\"<span><span>{ color: <span><span>'white'<span><span>,", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 35, "_doc_id": "35_321160523916089893"}}
{"doc_id": "36_2040525059463013105", "text": "v<span><span> v-demo<span><span>=<span><span>\"<span><span>{ color: <span><span>'white'<span><span>, text: <span><span>'hello!'<span><span> }<span><span>\"<span><span>></<span><span>div<span><span>><span><span><code><pre><div><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>app.<span><span>directive<span><span>(<span><span>'demo'<span><span>, (<span><span>el<span><span>,", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 36, "_doc_id": "36_2040525059463013105"}}
{"doc_id": "37_5807342873054669086", "text": ">app.<span><span>directive<span><span>(<span><span>'demo'<span><span>, (<span><span>el<span><span>, <span><span>binding<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> console.<span><span>log<span><span>(binding.value.color) <span><span>// => \"white\"<span><span>\n<span class=\"line\"><span> console.<span><span>log<span><span>(binding.value.text) <span><span>// => \"hello!\"<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 37, "_doc_id": "37_5807342873054669086"}}
{"doc_id": "38_1455251841568813712", "text": "pan> console.<span><span>log<span><span>(binding.value.text) <span><span>// => \"hello!\"<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><h2 id=\"usage-on-components\">在组件上使用 <a class=\"header-anchor\" href=\"#usage-on-components\">​<a><h2><div class=\"warning custom-block\"><p class=\"custom-block-title\">不推荐<p><p>不推荐在组件上使用自定义指令。当组件具有多个根节点时可能会出现预期外的行为。<p><div><p>当在组件上使用自定义指令时，它会始终应用于组件的根节点，和<a href=\"/guide/components/attrs.html\">透传 attributes<a> 类似。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 38, "_doc_id": "38_1455251841568813712"}}
{"doc_id": "39_7972617647991826527", "text": "。<p><div><p>当在组件上使用自定义指令时，它会始终应用于组件的根节点，和<a href=\"/guide/components/attrs.html\">透传 attributes<a> 类似。<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyComponent<span><span> v-demo<span><span>=<span><span>\"<span><span>test<span><span>\"<span><span> /><span><span><code><pre><div><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- MyComponent 的模板 --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 39, "_doc_id": "39_7972617647991826527"}}
{"doc_id": "40_8257586658403397699", "text": "ass=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- MyComponent 的模板 --><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>div<span><span>> <span><span><!-- v-demo 指令会被应用在此处 --><span><span>\n<span class=\"line\"><span> <<span><span>span<span><span>>My component content</<span><span>span<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 40, "_doc_id": "40_8257586658403397699"}}
{"doc_id": "41_1648436935771564615", "text": "span> <<span><span>span<span><span>>My component content</<span><span>span<span><span>><span><span>\n<span class=\"line\"><span></<span><span>div<span><span>><span><span><code><pre><div><p>需要注意的是组件可能含有多个根节点。当应用到一个多根组件时，指令将会被忽略且抛出一个警告。和 attribute 不同，指令不能通过 <code>v-bind=\"$attrs\"<code> 来传递给一个不同的元素。<p><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/custom-directives.html", "title": "自定义指令", "doc_id": "fe4010e526604856ab27eb74ac1e7a4d", "content_type": "web_page", "word_count": 650, "chunk_index": 41, "_doc_id": "41_1648436935771564615"}}
{"doc_id": "0_9156409863713439776", "text": "<div><div><h1 id=\"plugins\">插件 <a class=\"header-anchor\" href=\"#plugins\">​<a><h1><h2 id=\"introduction\">介绍 <a class=\"header-anchor\" href=\"#introduction\">​<a><h2><p>插件 (Plugins) 是一种能为 Vue 添加全局功能的工具代码。下面是如何安装一个插件的示例：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> { createApp } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 0, "_doc_id": "0_9156409863713439776"}}
{"doc_id": "1_9085899629983010793", "text": "<span><span> { createApp } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> app<span><span> =<span><span> createApp<span><span>({})<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>app.<span><span>use<span><span>(myPlugin, {<span><span>\n<span class=\"line\"><span> /* 可选的选项 */<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 1, "_doc_id": "1_9085899629983010793"}}
{"doc_id": "2_3374929691453360183", "text": "pan><span>use<span><span>(myPlugin, {<span><span>\n<span class=\"line\"><span> /* 可选的选项 */<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><p>一个插件可以是一个拥有 <code>install()<code> 方法的对象，也可以直接是一个安装函数本身。安装函数会接收到安装它的<a href=\"/api/application.html\">应用实例<a>和传递给 <code>app.use()<code> 的额外选项作为参数：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> myPlugin<span><span> =<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 2, "_doc_id": "2_3374929691453360183"}}
{"doc_id": "3_416382935403796471", "text": "\"><code><span class=\"line\"><span>const<span><span> myPlugin<span><span> =<span><span> {<span><span>\n<span class=\"line\"><span> install<span><span>(<span><span>app<span><span>, <span><span>options<span><span>) {<span><span>\n<span class=\"line\"><span> // 配置此应用<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 3, "_doc_id": "3_416382935403796471"}}
{"doc_id": "4_3544679810014737843", "text": "<span><span>\n<span class=\"line\"><span> // 配置此应用<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>插件没有严格定义的使用范围，但是插件发挥作用的常见场景主要包括以下几种：<p><ol><li><p>通过 <a href=\"/api/application.html#app-component\"><code>app.component()<code><a> 和 <a href=\"/api/application.html#app-directive\"><code>app.directive()<code><a> 注册一到多个全局组件或自定义指令。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 4, "_doc_id": "4_3544679810014737843"}}
{"doc_id": "5_4246401145153986171", "text": "<a> 和 <a href=\"/api/application.html#app-directive\"><code>app.directive()<code><a> 注册一到多个全局组件或自定义指令。<p><li><li><p>通过 <a href=\"/api/application.html#app-provide\"><code>app.provide()<code><a> 使一个资源<a href=\"/guide/components/provide-inject.html\">可被注入<a>进整个应用。<p><li><li><p>向 <a href=\"/api/application.html#app-config-globalproperties\"><code>app.config.globalProperties<code><a> 中添加一些全局实例属性或方法<p><li><li><p>一个可能上述三种都包含了的功能库 (例如 <a href=\"https://github.com/vuejs/vue-router-next\" target=\"_blank\">vue-router<a>)。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 5, "_doc_id": "5_4246401145153986171"}}
{"doc_id": "6_7092477495929906801", "text": "能上述三种都包含了的功能库 (例如 <a href=\"https://github.com/vuejs/vue-router-next\" target=\"_blank\">vue-router<a>)。<p><li><ol><h2 id=\"writing-a-plugin\">编写一个插件 <a class=\"header-anchor\" href=\"#writing-a-plugin\">​<a><h2><p>为了更好地理解如何构建 Vue.js 插件，我们可以试着写一个简单的 <code>i18n<code> (<a href=\"https://en.wikipedia.org/wiki/Internationalization_and_localization\" target=\"_blank\">国际化 (Internationalization)<a> 的缩写) 插件。<p><p>让我们从设置插件对象开始。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 6, "_doc_id": "6_7092477495929906801"}}
{"doc_id": "7_2294151971993937169", "text": "lization_and_localization\" target=\"_blank\">国际化 (Internationalization)<a> 的缩写) 插件。<p><p>让我们从设置插件对象开始。建议在一个单独的文件中创建并导出它，以保证更好地管理逻辑，如下所示：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">plugins/i18n.js<span><p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 7, "_doc_id": "7_2294151971993937169"}}
{"doc_id": "8_3580437134999047433", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> install<span><span>: (<span><span>app<span><span>, <span><span>options<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> // 在这里编写插件代码<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p>我们希望有一个翻译函数，这个函数接收一个以 <code>.<code> 作为分隔符的 <code>key<code> 字符串，用来在用户提供的翻译字典中查找对应语言的文本。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 8, "_doc_id": "8_3580437134999047433"}}
{"doc_id": "9_1122899782572828748", "text": "><div><div><p>我们希望有一个翻译函数，这个函数接收一个以 <code>.<code> 作为分隔符的 <code>key<code> 字符串，用来在用户提供的翻译字典中查找对应语言的文本。期望的使用方式如下：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>h1<span><span>>{{ <span><span>$translate<span><span>(<span><span>'greetings.hello'<span><span>) }}</<span><span>h1<span><span>><span><span><code><pre><div><p>这个函数应当能够在任意模板中被全局调用。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 9, "_doc_id": "9_1122899782572828748"}}
{"doc_id": "10_5705557936894747324", "text": "llo'<span><span>) }}</<span><span>h1<span><span>><span><span><code><pre><div><p>这个函数应当能够在任意模板中被全局调用。这一点可以通过在插件中将它添加到 <code>app.config.globalProperties<code> 上来实现：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">plugins/i18n.js<span><p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 10, "_doc_id": "10_5705557936894747324"}}
{"doc_id": "11_3536719242354412608", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> install<span><span>: (<span><span>app<span><span>, <span><span>options<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line highlighted\"><span> // 注入一个全局可用的 $translate() 方法<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 11, "_doc_id": "11_3536719242354412608"}}
{"doc_id": "12_4837349727779318903", "text": "<span> {<span><span>\n<span class=\"line highlighted\"><span> // 注入一个全局可用的 $translate() 方法<span><span>\n<span class=\"line highlighted\"><span> app.config.globalProperties.<span><span>$translate<span><span> =<span><span> (<span><span>key<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line highlighted\"><span> // 获取 `options` 对象的深层属性<span><span>\n<span class=\"line highlighted\"><span> // 使用 `key` 作为索引<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 12, "_doc_id": "12_4837349727779318903"}}
{"doc_id": "13_7261485880680994903", "text": "获取 `options` 对象的深层属性<span><span>\n<span class=\"line highlighted\"><span> // 使用 `key` 作为索引<span><span>\n<span class=\"line highlighted\"><span> return<span><span> key.<span><span>split<span><span>(<span><span>'.'<span><span>).<span><span>reduce<span><span>((<span><span>o<span><span>, <span><span>i<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line highlighted\"><span> if<span><span> (o) <span><span>return<span><span> o[i]<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 13, "_doc_id": "13_7261485880680994903"}}
{"doc_id": "14_8786014986502264295", "text": "class=\"line highlighted\"><span> if<span><span> (o) <span><span>return<span><span> o[i]<span><span>\n<span class=\"line highlighted\"><span> }, options)<span><span>\n<span class=\"line highlighted\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 14, "_doc_id": "14_8786014986502264295"}}
{"doc_id": "15_5571986517150937184", "text": "><span>\n<span class=\"line highlighted\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p>我们的 <code>$translate<code> 函数会接收一个例如 <code>greetings.hello<code> 的字符串，在用户提供的翻译字典中查找，并返回翻译得到的值。<p><p>用于查找的翻译字典对象则应当在插件被安装时作为 <code>app.use()<code> 的额外参数被传入：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>import<span><span> i18nPlugin <span><span>from<span><span> './plugins/i18n'<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 15, "_doc_id": "15_5571986517150937184"}}
{"doc_id": "16_1026203998712371700", "text": "line\"><span>import<span><span> i18nPlugin <span><span>from<span><span> './plugins/i18n'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>app.<span><span>use<span><span>(i18nPlugin, {<span><span>\n<span class=\"line\"><span> greetings: {<span><span>\n<span class=\"line\"><span> hello: <span><span>'Bonjour!'<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 16, "_doc_id": "16_1026203998712371700"}}
{"doc_id": "17_1395000501564248002", "text": "ass=\"line\"><span> hello: <span><span>'Bonjour!'<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><p>这样，我们一开始的表达式 <code>$translate('greetings.hello')<code> 就会在运行时被替换为 <code>Bonjour!<code> 了。<p><p>TypeScript 用户请参考：<a href=\"/guide/typescript/options-api.html#augmenting-global-properties\">扩展全局属性<a> <p><div class=\"tip custom-block\"><p class=\"custom-block-title\">TIP<p><p>请谨慎使用全局属性，如果在整个应用中使用不同插件注入的太多全局属性，很容易让应用变得难以理解和维护。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 17, "_doc_id": "17_1395000501564248002"}}
{"doc_id": "18_5102605589634443041", "text": "tom-block\"><p class=\"custom-block-title\">TIP<p><p>请谨慎使用全局属性，如果在整个应用中使用不同插件注入的太多全局属性，很容易让应用变得难以理解和维护。<p><div><h3 id=\"provide-inject-with-plugins\">插件中的 Provide / Inject <a class=\"header-anchor\" href=\"#provide-inject-with-plugins\">​<a><h3><p>在插件中，我们可以通过 <code>provide<code> 来为插件用户提供访问某个函数或属性的能力。举例来说，我们可以将插件接收到的 <code>options<code> 参数提供给整个应用，让任何组件都能使用这个翻译字典对象。", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 18, "_doc_id": "18_5102605589634443041"}}
{"doc_id": "19_7068142497550008731", "text": "provide<code> 来为插件用户提供访问某个函数或属性的能力。举例来说，我们可以将插件接收到的 <code>options<code> 参数提供给整个应用，让任何组件都能使用这个翻译字典对象。<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">plugins/i18n.js<span><p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 19, "_doc_id": "19_7068142497550008731"}}
{"doc_id": "20_3800879259054431984", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> install<span><span>: (<span><span>app<span><span>, <span><span>options<span><span>) <span><span>=><span><span> {<span><span>\n<span class=\"line highlighted\"><span> app.<span><span>provide<span><span>(<span><span>'i18n'<span><span>, options)<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 20, "_doc_id": "20_3800879259054431984"}}
{"doc_id": "21_7334704036411695462", "text": "<span>(<span><span>'i18n'<span><span>, options)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p>现在，插件用户就可以在他们的组件中以 <code>i18n<code> 为 key 注入并访问插件的选项对象了。<p><div class=\"composition-api\"><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 21, "_doc_id": "21_7334704036411695462"}}
{"doc_id": "22_6108058491823397978", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { inject } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line highlighted\"><span>const<span><span> i18n<span><span> =<span><span> inject<span><span>(<span><span>'i18n'<span><span>)<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>console.<span><span>log<span><span>(i18n.greetings.hello)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 22, "_doc_id": "22_6108058491823397978"}}
{"doc_id": "23_3829606015929164516", "text": "pan>\n<span class=\"line\"><span>console.<span><span>log<span><span>(i18n.greetings.hello)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><div><div class=\"options-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line highlighted\"><span> inject: [<span><span>'i18n'<span><span>],<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 23, "_doc_id": "23_3829606015929164516"}}
{"doc_id": "24_3339583222648423302", "text": "><span>\n<span class=\"line highlighted\"><span> inject: [<span><span>'i18n'<span><span>],<span><span>\n<span class=\"line\"><span> created<span><span>() {<span><span>\n<span class=\"line\"><span> console.<span><span>log<span><span>(<span><span>this<span><span>.i18n.greetings.hello)<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 24, "_doc_id": "24_3339583222648423302"}}
{"doc_id": "25_8578304339949412281", "text": "an><span>this<span><span>.i18n.greetings.hello)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><h3 id=\"为-npm-打包\">为 NPM 打包 <a class=\"header-anchor\" href=\"#%E4%B8%BA-npm-%E6%89%93%E5%8C%85\">​<a><h3><p>如果你想进一步打包并发布插件给他人使用，请参阅 <a href=\"https://vite.dev/guide/build.html#library-mode\" target=\"_blank\">Vite 库模式<a>。<p><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/reusability/plugins.html", "title": "插件 | Vue.js", "doc_id": "de16056595e442418eef34a6255cce99", "content_type": "web_page", "word_count": 378, "chunk_index": 25, "_doc_id": "25_8578304339949412281"}}
{"doc_id": "0_8467981841934067824", "text": "<div><div><h1 id=\"transition\">Transition <a class=\"header-anchor\" href=\"#transition\">​<a><h1><p>Vue 提供了两个内置组件，可以帮助你制作基于状态变化的过渡和动画：<p><p>除了这两个组件，我们也可以通过其他技术手段来应用动画，比如切换 CSS class 或用状态绑定样式来驱动动画。这些其他的方法会在<a href=\"/guide/extras/animation.html\">动画技巧<a>章节中展开。<p><h2 id=\"the-transition-component\"><code><Transition><code> 组件 <a class=\"header-anchor\" href=\"#the-transition-component\">​<a><h2><p><code><Transition><code> 是一个内置组件，这意味着它在任意别的组件中都可以被使用，无需注册。它可以将进入和离开动画应用到通过默认插槽传递给它的元素或组件上。进入或离开可以由以下的条件之一触发：<p><ul><li>由", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 0, "_doc_id": "0_8467981841934067824"}}
{"doc_id": "1_5588558747475527668", "text": "de> 是一个内置组件，这意味着它在任意别的组件中都可以被使用，无需注册。它可以将进入和离开动画应用到通过默认插槽传递给它的元素或组件上。进入或离开可以由以下的条件之一触发：<p><ul><li>由 <code>v-if<code> 所触发的切换<li><li>由 <code>v-show<code> 所触发的切换<li><li>由特殊元素 <code><component><code> 切换的动态组件<li><li>改变特殊的 <code>key<code> 属性<li><ul><p>以下是最基本用法的示例：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>button<span><span> @<span><span>click<span><span>=<span><span>\"<span><span>show", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 1, "_doc_id": "1_5588558747475527668"}}
{"doc_id": "2_8561560647092155725", "text": "><span><<span><span>button<span><span> @<span><span>click<span><span>=<span><span>\"<span><span>show <span><span>=<span><span> !<span><span>show<span><span>\"<span><span>>Toggle</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span><<span><span>Transition<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span> v-if<span><span>=<span><span>\"<span><span>show<span><span>\"<span><span>>hello</<span><span>p<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 2, "_doc_id": "2_8561560647092155725"}}
{"doc_id": "3_9071841483440123769", "text": "span><span>\"<span><span>show<span><span>\"<span><span>>hello</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><div class=\"language-css\"> <span class=\"lang\">css<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>/* 下面我们会解释这些 class 是做什么的 */<span><span>\n<span class=\"line\"><span>.v-enter-active<span><span>,<span><span>\n<span class=\"line\"><span>.v-leave-active<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 3, "_doc_id": "3_9071841483440123769"}}
{"doc_id": "4_6347913501385113514", "text": "-active<span><span>,<span><span>\n<span class=\"line\"><span>.v-leave-active<span><span> {<span><span>\n<span class=\"line\"><span> transition<span><span>: opacity <span><span>0.5<span><span>s<span><span> ease<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>.v-enter-from<span><span>,<span><span>\n<span class=\"line\"><span>.v-leave-to<span><span> {<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 4, "_doc_id": "4_6347913501385113514"}}
{"doc_id": "5_6309955168331021219", "text": "{<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div class=\"tip custom-block\"><p class=\"custom-block-title\">TIP<p><p><code><Transition><code> 仅支持单个元素或组件作为其插槽内容。如果内容是一个组件，这个组件必须仅有一个根元素。<p><div><p>当一个 <code><Transition><code> 组件中的元素被插入或移除时，会发生下面这些事情：<p><ol><li><p>Vue 会自动检测目标元素是否应用了 CSS 过渡或动画。如果是，则一些 <a href=\"#transition-classes\">CSS 过渡 class<a> 会在适当的时机被添加和移除。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 5, "_doc_id": "5_6309955168331021219"}}
{"doc_id": "6_4717575409271632678", "text": "<p>Vue 会自动检测目标元素是否应用了 CSS 过渡或动画。如果是，则一些 <a href=\"#transition-classes\">CSS 过渡 class<a> 会在适当的时机被添加和移除。<p><li><li><p>如果有作为监听器的 <a href=\"#javascript-hooks\">JavaScript 钩子<a>，这些钩子函数会在适当时机被调用。<p><li><li><p>如果没有探测到 CSS 过渡或动画、也没有提供 JavaScript 钩子，那么 DOM 的插入、删除操作将在浏览器的下一个动画帧后执行。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 6, "_doc_id": "6_4717575409271632678"}}
{"doc_id": "7_338711562849986240", "text": "，这些钩子函数会在适当时机被调用。<p><li><li><p>如果没有探测到 CSS 过渡或动画、也没有提供 JavaScript 钩子，那么 DOM 的插入、删除操作将在浏览器的下一个动画帧后执行。<p><li><ol><h2 id=\"css-based-transitions\">基于 CSS 的过渡效果 <a class=\"header-anchor\" href=\"#css-based-transitions\">​<a><h2><h3 id=\"transition-classes\">CSS 过渡 class <a class=\"header-anchor\" href=\"#transition-classes\">​<a><h3><p>一共有 6 个应用于进入与离开过渡效果的 CSS class。<p><p> <p><ol><li><p><code>v-enter-from<code>：进入动画的起始状态。在元素插入之前添加，在元素插入完成后的下一帧移除。<p><li><li><p><code>v-enter-active<code>：进入动画的生效状态。应用于整个进入动画阶段。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 7, "_doc_id": "7_338711562849986240"}}
{"doc_id": "8_2756814679089051902", "text": ">：进入动画的起始状态。在元素插入之前添加，在元素插入完成后的下一帧移除。<p><li><li><p><code>v-enter-active<code>：进入动画的生效状态。应用于整个进入动画阶段。在元素被插入之前添加，在过渡或动画完成之后移除。这个 class 可以被用来定义进入动画的持续时间、延迟与速度曲线类型。<p><li><li><p><code>v-enter-to<code>：进入动画的结束状态。在元素插入完成后的下一帧被添加 (也就是 <code>v-enter-from<code> 被移除的同时)，在过渡或动画完成之后移除。<p><li><li><p><code>v-leave-from<code>：离开动画的起始状态。在离开过渡效果被触发时立即添加，在一帧后被移除。<p><li><li><p><code>v-leave-active<code>：离开动画的生效状态。应用于整个离开动画阶段。在离开过渡效果被触发时立即添加，在过渡或动画完成之后移除。这个 class 可以被用来定义离开动画的持续时间、延迟与速度曲线类型。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 8, "_doc_id": "8_2756814679089051902"}}
{"doc_id": "9_5827360382190076011", "text": "active<code>：离开动画的生效状态。应用于整个离开动画阶段。在离开过渡效果被触发时立即添加，在过渡或动画完成之后移除。这个 class 可以被用来定义离开动画的持续时间、延迟与速度曲线类型。<p><li><li><p><code>v-leave-to<code>：离开动画的结束状态。在一个离开动画被触发后的下一帧被添加 (也就是 <code>v-leave-from<code> 被移除的同时)，在过渡或动画完成之后移除。<p><li><ol><p><code>v-enter-active<code> 和 <code>v-leave-active<code> 给我们提供了为进入和离开动画指定不同速度曲线的能力，我们将在下面的小节中看到一个示例。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 9, "_doc_id": "9_5827360382190076011"}}
{"doc_id": "10_139603806124380782", "text": "><code>v-enter-active<code> 和 <code>v-leave-active<code> 给我们提供了为进入和离开动画指定不同速度曲线的能力，我们将在下面的小节中看到一个示例。<p><h3 id=\"named-transitions\">为过渡效果命名 <a class=\"header-anchor\" href=\"#named-transitions\">​<a><h3><p>我们可以给 <code><Transition><code> 组件传一个 <code>name<code> prop 来声明一个过渡效果名：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> name<span><span>=<span><span>\"fade\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 10, "_doc_id": "10_139603806124380782"}}
{"doc_id": "11_6998711790743445374", "text": "an><<span><span>Transition<span><span> name<span><span>=<span><span>\"fade\"<span><span>><span><span>\n<span class=\"line\"><span> ...<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 11, "_doc_id": "11_6998711790743445374"}}
{"doc_id": "12_5202810404440570393", "text": "e<span><span>=<span><span>\"fade\"<span><span>><span><span>\n<span class=\"line\"><span> ...<span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><p>对于一个有名字的过渡效果，对它起作用的过渡 class 会以其名字而不是 <code>v<code> 作为前缀。比如，上方例子中被应用的 class 将会是 <code>fade-enter-active<code> 而不是 <code>v-enter-active<code>。这个“fade”过渡的 class 应该是这样：<p><div class=\"language-css\"> <span class=\"lang\">css<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>.fade-enter-active<span><span>,<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 12, "_doc_id": "12_5202810404440570393"}}
{"doc_id": "13_4513188545132730450", "text": "iki github-dark vp-code\"><code><span class=\"line\"><span>.fade-enter-active<span><span>,<span><span>\n<span class=\"line\"><span>.fade-leave-active<span><span> {<span><span>\n<span class=\"line\"><span> transition<span><span>: opacity <span><span>0.5<span><span>s<span><span> ease<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>.fade-enter-from<span><span>,<span><span>\n<span class=\"line\"><span>.fade-leave-to<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 13, "_doc_id": "13_4513188545132730450"}}
{"doc_id": "14_7768966974828748254", "text": "ter-from<span><span>,<span><span>\n<span class=\"line\"><span>.fade-leave-to<span><span> {<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 14, "_doc_id": "14_7768966974828748254"}}
{"doc_id": "15_8100999396790678586", "text": "{<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><h3 id=\"css-transitions\">CSS 的 transition <a class=\"header-anchor\" href=\"#css-transitions\">​<a><h3><p><code><Transition><code> 一般都会搭配<a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_Transitions/Using_CSS_transitions\" target=\"_blank\">原生 CSS 过渡<a>一起使用，正如你在上面的例子中所看到的那样。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 15, "_doc_id": "15_8100999396790678586"}}
{"doc_id": "16_3982018251442493759", "text": "cs/Web/CSS/CSS_Transitions/Using_CSS_transitions\" target=\"_blank\">原生 CSS 过渡<a>一起使用，正如你在上面的例子中所看到的那样。这个 <code>transition<code> CSS 属性是一个简写形式，使我们可以一次定义一个过渡的各个方面，包括需要执行动画的属性、持续时间和<a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/easing-function\" target=\"_blank\">速度曲线<a>。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 16, "_doc_id": "16_3982018251442493759"}}
{"doc_id": "17_879769564371021801", "text": "和<a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/easing-function\" target=\"_blank\">速度曲线<a>。<p><p>下面是一个更高级的例子，它使用了不同的持续时间和速度曲线来过渡多个属性：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> name<span><span>=<span><span>\"slide-fade\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 17, "_doc_id": "17_879769564371021801"}}
{"doc_id": "18_4982099243294632273", "text": "pan><span>Transition<span><span> name<span><span>=<span><span>\"slide-fade\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span> v-if<span><span>=<span><span>\"<span><span>show<span><span>\"<span><span>>hello</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><div class=\"language-css\"> <span class=\"lang\">css<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>/*<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 18, "_doc_id": "18_4982099243294632273"}}
{"doc_id": "19_6941440197094911466", "text": "lang\">css<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>/*<span><span>\n<span class=\"line\"><span> 进入和离开动画可以使用不同<span><span>\n<span class=\"line\"><span> 持续时间和速度曲线。<span><span>\n<span class=\"line\"><span>*/<span><span>\n<span class=\"line\"><span>.slide-fade-enter-active<span><span> {<span><span>\n<span class=\"line\"><span> transition<span><span>: <span><span>all<span><span> 0.3<span><span>s<span><span> ease-out<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 19, "_doc_id": "19_6941440197094911466"}}
{"doc_id": "20_5718532518635320734", "text": "3<span><span>s<span><span> ease-out<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>.slide-fade-leave-active<span><span> {<span><span>\n<span class=\"line\"><span> transition<span><span>: <span><span>all<span><span> 0.8<span><span>s<span><span> cubic-bezier<span><span>(<span><span>1<span><span>, <span><span>0.5<span><span>, <span><span>0.8<span><span>, <span><span>1<span><span>);<span><span>\n<span class=\"line\"><span>}<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 20, "_doc_id": "20_5718532518635320734"}}
{"doc_id": "21_3551732625177024532", "text": "pan>0.8<span><span>, <span><span>1<span><span>);<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>.slide-fade-enter-from<span><span>,<span><span>\n<span class=\"line\"><span>.slide-fade-leave-to<span><span> {<span><span>\n<span class=\"line\"><span> transform<span><span>: <span><span>translateX<span><span>(<span><span>20<span><span>px<span><span>);<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 21, "_doc_id": "21_3551732625177024532"}}
{"doc_id": "22_5154326489638797419", "text": ";<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><h3 id=\"css-animations\">CSS 的 animation <a class=\"header-anchor\" href=\"#css-animations\">​<a><h3><p><a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_Animations/Using_CSS_animations\" target=\"_blank\">原生 CSS 动画<a>和 CSS transition 的应用方式基本上是相同的，只有一点不同，那就是 <code>*-enter-from<code> 不是在元素插入后立即移除，而是在一个 <code>animationend<code> 事件触发时被移除。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 22, "_doc_id": "22_5154326489638797419"}}
{"doc_id": "23_1793566606025405735", "text": "用方式基本上是相同的，只有一点不同，那就是 <code>*-enter-from<code> 不是在元素插入后立即移除，而是在一个 <code>animationend<code> 事件触发时被移除。<p><p>对于大多数的 CSS 动画，我们可以简单地在 <code>*-enter-active<code> 和 <code>*-leave-active<code> class 下声明它们。下面是一个示例：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> name<span><span>=<span><span>\"bounce\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 23, "_doc_id": "23_1793566606025405735"}}
{"doc_id": "24_7337011950338925813", "text": "><<span><span>Transition<span><span> name<span><span>=<span><span>\"bounce\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span> v-if<span><span>=<span><span>\"<span><span>show<span><span>\"<span><span> style<span><span>=<span><span>\"text-align: center;\"<span><span>><span><span>\n<span class=\"line\"><span> Hello here is some bouncy text!<span><span>\n<span class=\"line\"><span> </<span><span>p<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 24, "_doc_id": "24_7337011950338925813"}}
{"doc_id": "25_627988197131856419", "text": "is some bouncy text!<span><span>\n<span class=\"line\"><span> </<span><span>p<span><span>><span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><div class=\"language-css\"> <span class=\"lang\">css<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>.bounce-enter-active<span><span> {<span><span>\n<span class=\"line\"><span> animation<span><span>: bounce-in <span><span>0.5<span><span>s<span><span>;<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 25, "_doc_id": "25_627988197131856419"}}
{"doc_id": "26_4893921542749193444", "text": "line\"><span> animation<span><span>: bounce-in <span><span>0.5<span><span>s<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>.bounce-leave-active<span><span> {<span><span>\n<span class=\"line\"><span> animation<span><span>: bounce-in <span><span>0.5<span><span>s<span><span> reverse<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>@keyframes<span><span> bounce-in<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 26, "_doc_id": "26_4893921542749193444"}}
{"doc_id": "27_8303599777005647929", "text": "n>}<span><span>\n<span class=\"line\"><span>@keyframes<span><span> bounce-in<span><span> {<span><span>\n<span class=\"line\"><span> 0%<span><span> {<span><span>\n<span class=\"line\"><span> transform<span><span>: <span><span>scale<span><span>(<span><span>0<span><span>);<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> 50%<span><span> {<span><span>\n<span class=\"line\"><span> transform<span><span>: <span><span>scale<span><span>(<span><span>1.25<span><span>);<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 27, "_doc_id": "27_8303599777005647929"}}
{"doc_id": "28_5297768019859005799", "text": "an> transform<span><span>: <span><span>scale<span><span>(<span><span>1.25<span><span>);<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> 100%<span><span> {<span><span>\n<span class=\"line\"><span> transform<span><span>: <span><span>scale<span><span>(<span><span>1<span><span>);<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div class=\"demo\"> Toggle <p> Hello here is some bouncy text!", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 28, "_doc_id": "28_5297768019859005799"}}
{"doc_id": "29_452228200065062920", "text": "e\"><span>}<span><span><code><pre><div><div class=\"demo\"> Toggle <p> Hello here is some bouncy text! <p><div><h3 id=\"custom-transition-classes\">自定义过渡 class <a class=\"header-anchor\" href=\"#custom-transition-classes\">​<a><h3><p>你也可以向 <code><Transition><code> 传递以下的 props 来指定自定义的过渡 class：<p><ul><li><code>enter-from-class<code><li><li><code>enter-active-class<code><li><li><code>enter-to-class<code><li><li><code>leave-from-class<code><li><li><code>leave-active-class<code><li><li><code>leave-to-class<code><li><ul><p>你传入的这些 class 会覆盖相应阶段的默认 class 名。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 29, "_doc_id": "29_452228200065062920"}}
{"doc_id": "30_1325635383846361411", "text": "eave-active-class<code><li><li><code>leave-to-class<code><li><ul><p>你传入的这些 class 会覆盖相应阶段的默认 class 名。这个功能在你想要在 Vue 的动画机制下集成其他的第三方 CSS 动画库时非常有用，比如 <a href=\"https://daneden.github.io/animate.css/\" target=\"_blank\">Animate.css<a>：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- 假设你已经在页面中引入了 Animate.css --><span><span>\n<span class=\"line\"><span><<span><span>Transition<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 30, "_doc_id": "30_1325635383846361411"}}
{"doc_id": "31_7361464434484588573", "text": "你已经在页面中引入了 Animate.css --><span><span>\n<span class=\"line\"><span><<span><span>Transition<span><span>\n<span class=\"line\"><span> name<span><span>=<span><span>\"custom-classes\"<span><span>\n<span class=\"line\"><span> enter-active-class<span><span>=<span><span>\"animate__animated animate__tada\"<span><span>\n<span class=\"line\"><span> leave-active-class<span><span>=<span><span>\"animate__animated animate__bounceOutRight\"<span><span>\n<span class=\"line\"><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 31, "_doc_id": "31_7361464434484588573"}}
{"doc_id": "32_6938974746561698417", "text": "span>\"animate__animated animate__bounceOutRight\"<span><span>\n<span class=\"line\"><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span> v-if<span><span>=<span><span>\"<span><span>show<span><span>\"<span><span>>hello</<span><span>p<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 32, "_doc_id": "32_6938974746561698417"}}
{"doc_id": "33_7702468078696166829", "text": "span><span>\"<span><span>show<span><span>\"<span><span>>hello</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><h3 id=\"using-transitions-and-animations-together\">同时使用 transition 和 animation <a class=\"header-anchor\" href=\"#using-transitions-and-animations-together\">​<a><h3><p>Vue 需要附加事件监听器，以便知道过渡何时结束。可以是 <code>transitionend<code> 或 <code>animationend<code>，这取决于你所应用的 CSS 规则。如果你仅仅使用二者的其中之一，Vue 可以自动探测到正确的类型。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 33, "_doc_id": "33_7702468078696166829"}}
{"doc_id": "34_479159171458494971", "text": "ode>transitionend<code> 或 <code>animationend<code>，这取决于你所应用的 CSS 规则。如果你仅仅使用二者的其中之一，Vue 可以自动探测到正确的类型。<p><p>然而在某些场景中，你或许想要在同一个元素上同时使用它们两个。举例来说，Vue 触发了一个 CSS 动画，同时鼠标悬停触发另一个 CSS 过渡。此时你需要显式地传入 <code>type<code> prop 来声明，告诉 Vue 需要关心哪种类型，传入的值是 <code>animation<code> 或 <code>transition<code>：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> type<span><span>=<span><span>\"animation\"<span><span>>..", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 34, "_doc_id": "34_479159171458494971"}}
{"doc_id": "35_6701089490036599690", "text": "e\"><span><<span><span>Transition<span><span> type<span><span>=<span><span>\"animation\"<span><span>>...</<span><span>Transition<span><span>><span><span><code><pre><div><h3 id=\"nested-transitions-and-explicit-transition-durations\">深层级过渡与显式过渡时长 <a class=\"header-anchor\" href=\"#nested-transitions-and-explicit-transition-durations\">​<a><h3><p>尽管过渡 class 仅能应用在 <code><Transition><code> 的直接子元素上，我们还是可以使用深层级的 CSS 选择器，", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 35, "_doc_id": "35_6701089490036599690"}}
{"doc_id": "36_3573072055035230494", "text": "sition-durations\">​<a><h3><p>尽管过渡 class 仅能应用在 <code><Transition><code> 的直接子元素上，我们还是可以使用深层级的 CSS 选择器，在深层级的元素上触发过渡效果：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> name<span><span>=<span><span>\"nested\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 36, "_doc_id": "36_3573072055035230494"}}
{"doc_id": "37_6757668644498075124", "text": "><<span><span>Transition<span><span> name<span><span>=<span><span>\"nested\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> v-if<span><span>=<span><span>\"<span><span>show<span><span>\"<span><span> class<span><span>=<span><span>\"outer\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> class<span><span>=<span><span>\"inner\"<span><span>><span><span>\n<span class=\"line\"><span> Hello<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 37, "_doc_id": "37_6757668644498075124"}}
{"doc_id": "38_3166388456849004133", "text": "pan><span>=<span><span>\"inner\"<span><span>><span><span>\n<span class=\"line\"><span> Hello<span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><div class=\"language-css\"> <span class=\"lang\">css<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>/* 应用于嵌套元素的规则 */<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 38, "_doc_id": "38_3166388456849004133"}}
{"doc_id": "39_6672908835206104437", "text": "><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>/* 应用于嵌套元素的规则 */<span><span>\n<span class=\"line\"><span>.nested-enter-active<span><span> .inner<span><span>,<span><span>\n<span class=\"line\"><span>.nested-leave-active<span><span> .inner<span><span> {<span><span>\n<span class=\"line\"><span> transition<span><span>: <span><span>all<span><span> 0.3<span><span>s<span><span> ease-in-out<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 39, "_doc_id": "39_6672908835206104437"}}
{"doc_id": "40_8556398391727901966", "text": "se-in-out<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>.nested-enter-from<span><span> .inner<span><span>,<span><span>\n<span class=\"line\"><span>.nested-leave-to<span><span> .inner<span><span> {<span><span>\n<span class=\"line\"><span> transform<span><span>: <span><span>translateX<span><span>(<span><span>30<span><span>px<span><span>);<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 40, "_doc_id": "40_8556398391727901966"}}
{"doc_id": "41_7345047624238228354", "text": ";<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>/* ... 省略了其他必要的 CSS */<span><span><code><pre><div><p>我们甚至可以在深层元素上添加一个过渡延迟，从而创建一个带渐进延迟的动画序列：<p><div class=\"language-css\"> <span class=\"lang\">css<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>/* 延迟嵌套元素的进入以获得交错效果 */<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 41, "_doc_id": "41_7345047624238228354"}}
{"doc_id": "42_2109631079413702662", "text": "class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>/* 延迟嵌套元素的进入以获得交错效果 */<span><span>\n<span class=\"line\"><span>.nested-enter-active<span><span> .inner<span><span> {<span><span>\n<span class=\"line highlighted\"><span> transition-delay<span><span>: <span><span>0.25<span><span>s<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>然而，这会带来一个小问题。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 42, "_doc_id": "42_2109631079413702662"}}
{"doc_id": "43_2574492564678331412", "text": "an>s<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><p>然而，这会带来一个小问题。默认情况下，<code><Transition><code> 组件会通过监听过渡根元素上的<strong>第一个<strong> <code>transitionend<code> 或者 <code>animationend<code> 事件来尝试自动判断过渡何时结束。而在嵌套的过渡中，期望的行为应该是等待所有内部元素的过渡完成。<p><p>在这种情况下，你可以通过向 <code><Transition><code> 组件传入 <code>duration<code> prop 来显式指定过渡的持续时间 (以毫秒为单位)。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 43, "_doc_id": "43_2574492564678331412"}}
{"doc_id": "44_8839576733860042666", "text": "成。<p><p>在这种情况下，你可以通过向 <code><Transition><code> 组件传入 <code>duration<code> prop 来显式指定过渡的持续时间 (以毫秒为单位)。总持续时间应该匹配延迟加上内部元素的过渡持续时间：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> :<span><span>duration<span><span>=<span><span>\"<span><span>550<span><span>\"<span><span>>...</<span><span>Transition<span><span>><span><span><code><pre><div><p><a href=\"https://play.vuejs.org/#eNqVVd9v0zAQ/leO8LAfr", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 44, "_doc_id": "44_8839576733860042666"}}
{"doc_id": "45_2482366750268952531", "text": "on<span><span>><span><span><code><pre><div><p><a href=\"https://play.vuejs.org/#", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 45, "_doc_id": "45_2482366750268952531"}}
{"doc_id": "46_8581649663999166871", "text": "", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 46, "_doc_id": "46_8581649663999166871"}}
{"doc_id": "47_551354260470909958", "text": "VhiEVJ7GftHZTganUZ56EYLL3FykjhL195MlMM7qxXdmEGDPOG6boRE86UJVPMki+p4H01WLz4Fm78hSdBo5xXy+yfsd3bpbXny1SA1M8c82fgcMyW66L75/hmXtN44a120ktDPOL+h1bL1HCPsA42DaPdwge3HcO/TOCb2ZumQJtA15Yl65Crg84S+BdfPtL6lezY8C3GkZ7L6Bc1zNR0=\" target=\"_blank\">在演练场中尝试一下<a><p><p>如果有必要的话，你也可以用对象的形式传入，", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 47, "_doc_id": "47_551354260470909958"}}
{"doc_id": "48_8973442325270134574", "text": "tA15Yl65Crg84S+BdfPtL6lezY8C3GkZ7L6Bc1zNR0=\" target=\"_blank\">在演练场中尝试一下<a><p><p>如果有必要的话，你也可以用对象的形式传入，分开指定进入和离开所需的时间：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> :<span><span>duration<span><span>=<span><span>\"<span><span>{ enter: <span><span>500<span><span>,", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 48, "_doc_id": "48_8973442325270134574"}}
{"doc_id": "49_528348088976463451", "text": "n> :<span><span>duration<span><span>=<span><span>\"<span><span>{ enter: <span><span>500<span><span>, leave: <span><span>800<span><span> }<span><span>\"<span><span>>...</<span><span>Transition<span><span>><span><span><code><pre><div><h3 id=\"performance-considerations\">性能考量 <a class=\"header-anchor\" href=\"#performance-considerations\">​<a><h3><p>你可能注意到我们上面例子中展示的动画所用到的 CSS 属性大多是 <code>transform<code> 和 <code>opacity<code> 之类的。用这些属性制作动画非常高效，因为：<p><ol><li><p>他们在动画过程中不会影响到 DOM 结构，因此不会每一帧都触发昂贵的 CSS 布局重新计算。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 49, "_doc_id": "49_528348088976463451"}}
{"doc_id": "50_9034906497311894044", "text": "code>opacity<code> 之类的。用这些属性制作动画非常高效，因为：<p><ol><li><p>他们在动画过程中不会影响到 DOM 结构，因此不会每一帧都触发昂贵的 CSS 布局重新计算。<p><li><li><p>大多数的现代浏览器都可以在执行 <code>transform<code> 动画时利用 GPU 进行硬件加速。<p><li><ol><p>相比之下，像 <code>height<code> 或者 <code>margin<code> 这样的属性会触发 CSS 布局变动，因此执行它们的动画效果更昂贵，需要谨慎使用。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 50, "_doc_id": "50_9034906497311894044"}}
{"doc_id": "51_8329313472395862575", "text": "><li><ol><p>相比之下，像 <code>height<code> 或者 <code>margin<code> 这样的属性会触发 CSS 布局变动，因此执行它们的动画效果更昂贵，需要谨慎使用。<p><h2 id=\"javascript-hooks\">JavaScript 钩子 <a class=\"header-anchor\" href=\"#javascript-hooks\">​<a><h2><p>你可以通过监听 <code><Transition><code> 组件事件的方式在过渡过程中挂上钩子函数：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 51, "_doc_id": "51_8329313472395862575"}}
{"doc_id": "52_380478850216114742", "text": "lass=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span>\n<span class=\"line\"><span> @<span><span>before-enter<span><span>=<span><span>\"<span><span>onBeforeEnter<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>enter<span><span>=<span><span>\"<span><span>onEnter<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>after-enter<span><span>=<span><span>\"<span><span>onAfterEnter<span><span>\"<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 52, "_doc_id": "52_380478850216114742"}}
{"doc_id": "53_3198307764226648086", "text": "@<span><span>after-enter<span><span>=<span><span>\"<span><span>onAfterEnter<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>enter-cancelled<span><span>=<span><span>\"<span><span>onEnterCancelled<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>before-leave<span><span>=<span><span>\"<span><span>onBeforeLeave<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>leave<span><span>=<span><span>\"<span><span>onLeave<span><span>\"<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 53, "_doc_id": "53_3198307764226648086"}}
{"doc_id": "54_2035870883246565603", "text": "ne\"><span> @<span><span>leave<span><span>=<span><span>\"<span><span>onLeave<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>after-leave<span><span>=<span><span>\"<span><span>onAfterLeave<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>leave-cancelled<span><span>=<span><span>\"<span><span>onLeaveCancelled<span><span>\"<span><span>\n<span class=\"line\"><span>><span><span>\n<span class=\"line\"><span> <!-- ... --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 54, "_doc_id": "54_2035870883246565603"}}
{"doc_id": "55_2643819430073256573", "text": "an><span>\n<span class=\"line\"><span>><span><span>\n<span class=\"line\"><span> <!-- ... --><span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><div class=\"composition-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>// 在元素被插入到 DOM 之前被调用<span><span>\n<span class=\"line\"><span>// 用这个来设置元素的 \"enter-from\" 状态<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 55, "_doc_id": "55_2643819430073256573"}}
{"doc_id": "56_3630484507886500990", "text": ">// 在元素被插入到 DOM 之前被调用<span><span>\n<span class=\"line\"><span>// 用这个来设置元素的 \"enter-from\" 状态<span><span>\n<span class=\"line\"><span>function<span><span> onBeforeEnter<span><span>(<span><span>el<span><span>) {}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 在元素被插入到 DOM 之后的下一帧被调用<span><span>\n<span class=\"line\"><span>// 用这个来开始进入动画<span><span>\n<span class=\"line\"><span>function<span><span> onEnter<span><span>(<span><span>el<span><span>, <span><span>done<span><span>) {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 56, "_doc_id": "56_3630484507886500990"}}
{"doc_id": "57_1053555267352795560", "text": "><span> onEnter<span><span>(<span><span>el<span><span>, <span><span>done<span><span>) {<span><span>\n<span class=\"line\"><span> // 调用回调函数 done 表示过渡结束<span><span>\n<span class=\"line\"><span> // 如果与 CSS 结合使用，则这个回调是可选参数<span><span>\n<span class=\"line\"><span> done<span><span>()<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 当进入过渡完成时调用。<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 57, "_doc_id": "57_1053555267352795560"}}
{"doc_id": "58_5713755735495725366", "text": "\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 当进入过渡完成时调用。<span><span>\n<span class=\"line\"><span>function<span><span> onAfterEnter<span><span>(<span><span>el<span><span>) {}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 当进入过渡在完成之前被取消时调用<span><span>\n<span class=\"line\"><span>function<span><span> onEnterCancelled<span><span>(<span><span>el<span><span>) {}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 在 leave 钩子之前调用<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 58, "_doc_id": "58_5713755735495725366"}}
{"doc_id": "59_96515083574357661", "text": "n>) {}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 在 leave 钩子之前调用<span><span>\n<span class=\"line\"><span>// 大多数时候，你应该只会用到 leave 钩子<span><span>\n<span class=\"line\"><span>function<span><span> onBeforeLeave<span><span>(<span><span>el<span><span>) {}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 在离开过渡开始时调用<span><span>\n<span class=\"line\"><span>// 用这个来开始离开动画<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 59, "_doc_id": "59_96515083574357661"}}
{"doc_id": "60_9043737715221652740", "text": "pan class=\"line\"><span>// 在离开过渡开始时调用<span><span>\n<span class=\"line\"><span>// 用这个来开始离开动画<span><span>\n<span class=\"line\"><span>function<span><span> onLeave<span><span>(<span><span>el<span><span>, <span><span>done<span><span>) {<span><span>\n<span class=\"line\"><span> // 调用回调函数 done 表示过渡结束<span><span>\n<span class=\"line\"><span> // 如果与 CSS 结合使用，则这个回调是可选参数<span><span>\n<span class=\"line\"><span> done<span><span>()<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 60, "_doc_id": "60_9043737715221652740"}}
{"doc_id": "61_4231121452451364329", "text": "an> done<span><span>()<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 在离开过渡完成、<span><span>\n<span class=\"line\"><span>// 且元素已从 DOM 中移除时调用<span><span>\n<span class=\"line\"><span>function<span><span> onAfterLeave<span><span>(<span><span>el<span><span>) {}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 仅在 v-show 过渡中可用<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 61, "_doc_id": "61_4231121452451364329"}}
{"doc_id": "62_7198170761551146413", "text": ">) {}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>// 仅在 v-show 过渡中可用<span><span>\n<span class=\"line\"><span>function<span><span> onLeaveCancelled<span><span>(<span><span>el<span><span>) {}<span><span><code><pre><div><div><div class=\"options-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> // ...<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 62, "_doc_id": "62_7198170761551146413"}}
{"doc_id": "63_649695462185701123", "text": "n>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> // ...<span><span>\n<span class=\"line\"><span> methods: {<span><span>\n<span class=\"line\"><span> // 在元素被插入到 DOM 之前被调用<span><span>\n<span class=\"line\"><span> // 用这个来设置元素的 \"enter-from\" 状态<span><span>\n<span class=\"line\"><span> onBeforeEnter<span><span>(<span><span>el<span><span>) {},<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 在元素被插入到 DOM 之后的下一帧被调用<span><span>\n<span class=\"line\"><span> // 用这个来开始进入动画<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 63, "_doc_id": "63_649695462185701123"}}
{"doc_id": "64_1256747520024349801", "text": "ne\"><span> // 在元素被插入到 DOM 之后的下一帧被调用<span><span>\n<span class=\"line\"><span> // 用这个来开始进入动画<span><span>\n<span class=\"line\"><span> onEnter<span><span>(<span><span>el<span><span>, <span><span>done<span><span>) {<span><span>\n<span class=\"line\"><span> // 调用回调函数 done 表示过渡结束<span><span>\n<span class=\"line\"><span> // 如果与 CSS 结合使用，则这个回调是可选参数<span><span>\n<span class=\"line\"><span> done<span><span>()<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 64, "_doc_id": "64_1256747520024349801"}}
{"doc_id": "65_2219497949010599797", "text": "> done<span><span>()<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 当进入过渡完成时调用。<span><span>\n<span class=\"line\"><span> onAfterEnter<span><span>(<span><span>el<span><span>) {},<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 当进入过渡在完成之前被取消时调用<span><span>\n<span class=\"line\"><span> onEnterCancelled<span><span>(<span><span>el<span><span>) {},<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 65, "_doc_id": "65_2219497949010599797"}}
{"doc_id": "66_5012233691114779506", "text": "onEnterCancelled<span><span>(<span><span>el<span><span>) {},<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 在 leave 钩子之前调用<span><span>\n<span class=\"line\"><span> // 大多数时候，你应该只会用到 leave 钩子<span><span>\n<span class=\"line\"><span> onBeforeLeave<span><span>(<span><span>el<span><span>) {},<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 在离开过渡开始时调用<span><span>\n<span class=\"line\"><span> // 用这个来开始离开动画<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 66, "_doc_id": "66_5012233691114779506"}}
{"doc_id": "67_7553999889044161850", "text": "n class=\"line\"><span> // 在离开过渡开始时调用<span><span>\n<span class=\"line\"><span> // 用这个来开始离开动画<span><span>\n<span class=\"line\"><span> onLeave<span><span>(<span><span>el<span><span>, <span><span>done<span><span>) {<span><span>\n<span class=\"line\"><span> // 调用回调函数 done 表示过渡结束<span><span>\n<span class=\"line\"><span> // 如果与 CSS 结合使用，则这个回调是可选参数<span><span>\n<span class=\"line\"><span> done<span><span>()<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 67, "_doc_id": "67_7553999889044161850"}}
{"doc_id": "68_276330940044829109", "text": "> done<span><span>()<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 在离开过渡完成、<span><span>\n<span class=\"line\"><span> // 且元素已从 DOM 中移除时调用<span><span>\n<span class=\"line\"><span> onAfterLeave<span><span>(<span><span>el<span><span>) {},<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> // 仅在 v-show 过渡中可用<span><span>\n<span class=\"line\"><span> onLeaveCancelled<span><span>(<span><span>el<span><span>) {}<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 68, "_doc_id": "68_276330940044829109"}}
{"doc_id": "69_2683745487046540999", "text": ">\n<span class=\"line\"><span> onLeaveCancelled<span><span>(<span><span>el<span><span>) {}<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 69, "_doc_id": "69_2683745487046540999"}}
{"doc_id": "70_6856853347986226359", "text": "lled<span><span>(<span><span>el<span><span>) {}<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p>这些钩子可以与 CSS 过渡或动画结合使用，也可以单独使用。<p><p>在使用仅由 JavaScript 执行的动画时，最好是添加一个 <code>:css=\"false\"<code> prop。这显式地向 Vue 表明可以跳过对 CSS 过渡的自动探测。除了性能稍好一些之外，还可以防止 CSS 规则意外地干扰过渡效果：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 70, "_doc_id": "70_6856853347986226359"}}
{"doc_id": "71_1911640603527884413", "text": "lass=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span>\n<span class=\"line\"><span> ...<span><span>\n<span class=\"line highlighted\"><span> :<span><span>css<span><span>=<span><span>\"<span><span>false<span><span>\"<span><span>\n<span class=\"line\"><span>><span><span>\n<span class=\"line\"><span> ...<span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><p>在有了 <code>:css=\"false\"<code> 后，我们就自己全权负责控制什么时候过渡结束了。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 71, "_doc_id": "71_1911640603527884413"}}
{"doc_id": "72_4754013406803684594", "text": "tion<span><span>><span><span><code><pre><div><p>在有了 <code>:css=\"false\"<code> 后，我们就自己全权负责控制什么时候过渡结束了。这种情况下对于 <code>@enter<code> 和 <code>@leave<code> 钩子来说，回调函数 <code>done<code> 就是必须的。否则，钩子将被同步调用，过渡将立即完成。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 72, "_doc_id": "72_4754013406803684594"}}
{"doc_id": "73_3553428350490270845", "text": "种情况下对于 <code>@enter<code> 和 <code>@leave<code> 钩子来说，回调函数 <code>done<code> 就是必须的。否则，钩子将被同步调用，过渡将立即完成。<p><p>这里是使用 <a href=\"https://gsap.com/\" target=\"_blank\">GSAP 库<a>执行动画的一个示例，你也可以使用任何你想要的库，比如 <a href=\"https://animejs.com/\" target=\"_blank\">Anime.js<a> 或者 <a href=\"https://motion.dev/\" target=\"_blank\">Motion One<a>：<p><h2 id=\"reusable-transitions\">可复用过渡效果 <a class=\"header-anchor\" href=\"#reusable-transitions\">​<a><h2><p>得益于 Vue 的组件系统，过渡效果是可以被封装复用的。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 73, "_doc_id": "73_3553428350490270845"}}
{"doc_id": "74_5077162381111389146", "text": "复用过渡效果 <a class=\"header-anchor\" href=\"#reusable-transitions\">​<a><h2><p>得益于 Vue 的组件系统，过渡效果是可以被封装复用的。要创建一个可被复用的过渡，我们需要为 <code><Transition><code> 组件创建一个包装组件，并向内传入插槽内容：<p><div class=\"vp-code-block-title\"><p class=\"vp-code-block-title-bar\"><span class=\"vp-code-block-title-text\">MyTransition.vue<span><p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 74, "_doc_id": "74_5077162381111389146"}}
{"doc_id": "75_3478190894920111019", "text": "ki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>// JavaScript 钩子逻辑...<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line highlighted\"><span> <!-- 包装内置的 Transition 组件 --><span><span>\n<span class=\"line\"><span> <<span><span>Transition<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 75, "_doc_id": "75_3478190894920111019"}}
{"doc_id": "76_6387094583025086564", "text": "- 包装内置的 Transition 组件 --><span><span>\n<span class=\"line\"><span> <<span><span>Transition<span><span>\n<span class=\"line\"><span> name<span><span>=<span><span>\"my-transition\"<span><span>\n<span class=\"line\"><span> @enter<span><span>=<span><span>\"onEnter\"<span><span>\n<span class=\"line\"><span> @leave<span><span>=<span><span>\"onLeave\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>slot<span><span>></<span><span>slot<span><span>> <span><span><!-- 向内传递插槽内容 --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 76, "_doc_id": "76_6387094583025086564"}}
{"doc_id": "77_3820839984234778715", "text": "an><span>slot<span><span>></<span><span>slot<span><span>> <span><span><!-- 向内传递插槽内容 --><span><span>\n<span class=\"line\"><span> </<span><span>Transition<span><span>><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>style<span><span>><span><span>\n<span class=\"line\"><span>/*<span><span>\n<span class=\"line\"><span> 必要的 CSS...<span><span>\n<span class=\"line\"><span> 注意：避免在这里使用 <style scoped><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 77, "_doc_id": "77_3820839984234778715"}}
{"doc_id": "78_7674713318088926894", "text": "line\"><span> 必要的 CSS...<span><span>\n<span class=\"line\"><span> 注意：避免在这里使用 <style scoped><span><span>\n<span class=\"line\"><span> 因为那不会应用到插槽内容上<span><span>\n<span class=\"line\"><span>*/<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 78, "_doc_id": "78_7674713318088926894"}}
{"doc_id": "79_4177182494649088755", "text": "><span>\n<span class=\"line\"><span> 因为那不会应用到插槽内容上<span><span>\n<span class=\"line\"><span>*/<span><span>\n<span class=\"line\"><span></<span><span>style<span><span>><span><span><code><pre><div><div><p>现在 <code>MyTransition<code> 可以在导入后像内置组件那样使用了：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyTransition<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 79, "_doc_id": "79_4177182494649088755"}}
{"doc_id": "80_8251730226580289699", "text": "hub-dark vp-code\"><code><span class=\"line\"><span><<span><span>MyTransition<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span> v-if<span><span>=<span><span>\"<span><span>show<span><span>\"<span><span>>Hello</<span><span>div<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 80, "_doc_id": "80_8251730226580289699"}}
{"doc_id": "81_9021155498471056870", "text": "an><span>\"<span><span>show<span><span>\"<span><span>>Hello</<span><span>div<span><span>><span><span>\n<span class=\"line\"><span></<span><span>MyTransition<span><span>><span><span><code><pre><div><h2 id=\"transition-on-appear\">出现时过渡 <a class=\"header-anchor\" href=\"#transition-on-appear\">​<a><h2><p>如果你想在某个节点初次渲染时应用一个过渡效果，你可以添加 <code>appear<code> prop：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> appear<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 81, "_doc_id": "81_9021155498471056870"}}
{"doc_id": "82_3018034618132246983", "text": "><code><span class=\"line\"><span><<span><span>Transition<span><span> appear<span><span>><span><span>\n<span class=\"line\"><span> ...<span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><h2 id=\"transition-between-elements\">元素间过渡 <a class=\"header-anchor\" href=\"#transition-between-elements\">​<a><h2><p>除了通过 <code>v-if<code> / <code>v-show<code> 切换一个元素，我们也可以通过 <code>v-if<code> / <code>v-else<code> / <code>v-else-if<code> 在几个组件间进行切换，", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 82, "_doc_id": "82_3018034618132246983"}}
{"doc_id": "83_4102038940510081797", "text": "-show<code> 切换一个元素，我们也可以通过 <code>v-if<code> / <code>v-else<code> / <code>v-else-if<code> 在几个组件间进行切换，只要确保任一时刻只会有一个元素被渲染即可：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 83, "_doc_id": "83_4102038940510081797"}}
{"doc_id": "84_6311032331496635504", "text": "ithub-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>button<span><span> v-if<span><span>=<span><span>\"<span><span>docState <span><span>===<span><span> 'saved'\"<span><span>>Edit</<span><span>button<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 84, "_doc_id": "84_6311032331496635504"}}
{"doc_id": "85_3783855597502818195", "text": "<span><span>===<span><span> 'saved'\"<span><span>>Edit</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>button<span><span> v-else-if<span><span>=<span><span>\"<span><span>docState <span><span>===<span><span> 'edited'\"<span><span>>Save</<span><span>button<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 85, "_doc_id": "85_3783855597502818195"}}
{"doc_id": "86_4783729213267066455", "text": "<span><span>===<span><span> 'edited'\"<span><span>>Save</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>button<span><span> v-else-if<span><span>=<span><span>\"<span><span>docState <span><span>===<span><span> 'editing'\"<span><span>>Cancel</<span><span>button<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 86, "_doc_id": "86_4783729213267066455"}}
{"doc_id": "87_4872768282276259771", "text": "an><span>===<span><span> 'editing'\"<span><span>>Cancel</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><div class=\"demo transition-demo\"><span>Click to cycle through states: <span><p class=\"btn-container\"> Edit <p><div><p><a href=\"https://play.vuejs.org/#eNqdk8tu2zAQRX9loI0SoLLcFN2ostEi6BekmwLa0NTYJkKRBDkSYhj+9wxJO3ZegBGu+Lhz7syQ3Bd/nJtNIxZN0QbplSMISKNbdkYNznqCPXhcwwHW3g5QsrTsTGekNYGgt/KBBCEsouimDGLCvrztTFtnGGN4QTg4zbK4oj", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 87, "_doc_id": "87_4872768282276259771"}}
{"doc_id": "88_8298220698345370691", "text": "", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 88, "_doc_id": "88_8298220698345370691"}}
{"doc_id": "89_3080372862138271291", "text": "PTU6jQEPpKyMj8dnmgkQs+HmQcvVTIQK1hPrv7GQAFt9eO9Bk6fZ8Ub52Qiri8eUo+4dbWD02exh79v/nBP+H2PStnwz/jelJ1geKvk/peHJ4BoRZYow==\" target=\"_blank\">在演练场中尝试一下<a><p><h2 id=\"transition-modes\">过渡模式 <a class=\"header-anchor\" href=\"#transition-modes\">​<a><h2><p>在之前的例子中，进入和离开的元素都是在同时开始动画的，因此我们不得不将它们设为 <code>position: absolute<code> 以避免二者同时存在时出现的布局问题。<p><p>然而，很多情况下这可能并不符合需求。我们可能想要先执行离开动画，然后在其完成<strong>之后<strong>再执行元素的进入动画。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 89, "_doc_id": "89_3080372862138271291"}}
{"doc_id": "90_6730047476093643202", "text": "te<code> 以避免二者同时存在时出现的布局问题。<p><p>然而，很多情况下这可能并不符合需求。我们可能想要先执行离开动画，然后在其完成<strong>之后<strong>再执行元素的进入动画。手动编排这样的动画是非常复杂的，好在我们可以通过向 <code><Transition><code> 传入一个 <code>mode<code> prop 来实现这个行为：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> mode<span><span>=<span><span>\"out-in\"<span><span>><span><span>\n<span class=\"line\"><span> ...<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 90, "_doc_id": "90_6730047476093643202"}}
{"doc_id": "91_7090846994262791447", "text": "span><span>=<span><span>\"out-in\"<span><span>><span><span>\n<span class=\"line\"><span> ...<span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><p>将之前的例子改为 <code>mode=\"out-in\"<code> 后是这样：<p><div class=\"demo transition-demo\"><span>Click to cycle through states: <span><p class=\"btn-container\"> Edit <p><div><p><code><Transition><code> 也支持 <code>mode=\"in-out\"<code>，虽然这并不常用。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 91, "_doc_id": "91_7090846994262791447"}}
{"doc_id": "92_1347797697686295738", "text": "ass=\"btn-container\"> Edit <p><div><p><code><Transition><code> 也支持 <code>mode=\"in-out\"<code>，虽然这并不常用。<p><h2 id=\"transition-between-components\">组件间过渡 <a class=\"header-anchor\" href=\"#transition-between-components\">​<a><h2><p><code><Transition><code> 也可以作用于<a href=\"/guide/essentials/component-basics.", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 92, "_doc_id": "92_1347797697686295738"}}
{"doc_id": "93_7624481364446748869", "text": "n-components\">​<a><h2><p><code><Transition><code> 也可以作用于<a href=\"/guide/essentials/component-basics.html#dynamic-components\">动态组件<a>之间的切换：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> name<span><span>=<span><span>\"fade\"<span><span> mode<span><span>=<span><span>\"out-in\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 93, "_doc_id": "93_7624481364446748869"}}
{"doc_id": "94_4040794830437958767", "text": "span>=<span><span>\"fade\"<span><span> mode<span><span>=<span><span>\"out-in\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>component<span><span> :<span><span>is<span><span>=<span><span>\"<span><span>activeComponent<span><span>\"<span><span>></<span><span>component<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 94, "_doc_id": "94_4040794830437958767"}}
{"doc_id": "95_6529327316203247440", "text": "pan><span>activeComponent<span><span>\"<span><span>></<span><span>component<span><span>><span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><h2 id=\"dynamic-transitions\">动态过渡 <a class=\"header-anchor\" href=\"#dynamic-transitions\">​<a><h2><p><code><Transition><code> 的 props (比如 <code>name<code>) 也可以是动态的！", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 95, "_doc_id": "95_6529327316203247440"}}
{"doc_id": "96_4893165499726654303", "text": "ef=\"#dynamic-transitions\">​<a><h2><p><code><Transition><code> 的 props (比如 <code>name<code>) 也可以是动态的！这让我们可以根据状态变化动态地应用不同类型的过渡：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>Transition<span><span> :<span><span>name<span><span>=<span><span>\"<span><span>transitionName<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> <!-- ... --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 96, "_doc_id": "96_4893165499726654303"}}
{"doc_id": "97_7670066627722329196", "text": "sitionName<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> <!-- ... --><span><span>\n<span class=\"line\"><span></<span><span>Transition<span><span>><span><span><code><pre><div><p>这个特性的用处是可以提前定义好多组 CSS 过渡或动画的 class，然后在它们之间动态切换。<p><p>你也可以根据你的组件的当前状态在 JavaScript 过渡钩子中应用不同的行为。最后，创建动态过渡的终极方式还是创建<a href=\"#reusable-transitions\">可复用的过渡组件<a>，并让这些组件根据动态的 props 来改变过渡的效果。掌握了这些技巧后，就真的只有你想不到，没有做不到的了。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 97, "_doc_id": "97_7670066627722329196"}}
{"doc_id": "98_6162255785426490009", "text": "创建<a href=\"#reusable-transitions\">可复用的过渡组件<a>，并让这些组件根据动态的 props 来改变过渡的效果。掌握了这些技巧后，就真的只有你想不到，没有做不到的了。<p><h2 id=\"transitions-with-the-key-attribute\">使用 Key Attribute 过渡 <a class=\"header-anchor\" href=\"#transitions-with-the-key-attribute\">​<a><h2><p>有时为了触发过渡，你需要强制重新渲染 DOM 元素。<p><p>以计数器组件为例：<p><div class=\"composition-api\"><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 98, "_doc_id": "98_6162255785426490009"}}
{"doc_id": "99_8202154052025057618", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { ref } <span><span>from<span><span> 'vue'<span><span>;<span><span>\n<span class=\"line\"><span>const<span><span> count<span><span> =<span><span> ref<span><span>(<span><span>0<span><span>);<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 99, "_doc_id": "99_8202154052025057618"}}
{"doc_id": "100_6474532782430997103", "text": "an> =<span><span> ref<span><span>(<span><span>0<span><span>);<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>setInterval<span><span>(() <span><span>=><span><span> count.value<span><span>++<span><span>, <span><span>1000<span><span>);<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>Transition<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 100, "_doc_id": "100_6474532782430997103"}}
{"doc_id": "101_4457352765584183891", "text": "span><span>><span><span>\n<span class=\"line\"><span> <<span><span>Transition<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>span<span><span> :key<span><span>=<span><span>\"count\"<span><span>>{{ count }}</<span><span>span<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>Transition<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 101, "_doc_id": "101_4457352765584183891"}}
{"doc_id": "102_5468443059089553973", "text": "pan><span>><span><span>\n<span class=\"line\"><span> </<span><span>Transition<span><span>><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span><code><pre><div><div><div class=\"options-api\"><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 102, "_doc_id": "102_5468443059089553973"}}
{"doc_id": "103_9146286879450965686", "text": "n><span>><span><span>\n<span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> data<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> count: <span><span>1<span><span>,<span><span>\n<span class=\"line\"><span> interval: <span><span>null<span><span> <span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> mounted<span><span>() {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 103, "_doc_id": "103_9146286879450965686"}}
{"doc_id": "104_7497629229146460101", "text": "an class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> mounted<span><span>() {<span><span>\n<span class=\"line\"><span> this<span><span>.interval <span><span>=<span><span> setInterval<span><span>(() <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> this<span><span>.count<span><span>++<span><span>;<span><span>\n<span class=\"line\"><span> }, <span><span>1000<span><span>)<span><span>\n<span class=\"line\"><span> },<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 104, "_doc_id": "104_7497629229146460101"}}
{"doc_id": "105_8268935776809589815", "text": "\"line\"><span> }, <span><span>1000<span><span>)<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> beforeDestroy<span><span>() {<span><span>\n<span class=\"line\"><span> clearInterval<span><span>(<span><span>this<span><span>.interval)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 105, "_doc_id": "105_8268935776809589815"}}
{"doc_id": "106_6916673441267420107", "text": "n>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>Transition<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>span<span><span> :key<span><span>=<span><span>\"count\"<span><span>>{{ count }}</<span><span>span<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>Transition<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 106, "_doc_id": "106_6916673441267420107"}}
{"doc_id": "107_8481314625245442111", "text": "pan><span>><span><span>\n<span class=\"line\"><span> </<span><span>Transition<span><span>><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span><code><pre><div><div><p>如果不使用 <code>key<code> attribute，则只有文本节点会被更新，因此不会发生过渡。但是，有了 <code>key<code> 属性，Vue 就知道在 <code>count<code> 改变时创建一个新的 <code>span<code> 元素，因此 <code>Transition<code> 组件有两个不同的元素在它们之间进行过渡。<p>\n<p><strong>参考<strong><p><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition.html", "title": "Transition | Vue.js", "doc_id": "7601c4cac3b14109a91fe9910f3ac39d", "content_type": "web_page", "word_count": 1496, "chunk_index": 107, "_doc_id": "107_8481314625245442111"}}
{"doc_id": "0_4514014591718619665", "text": "<div><div><h1 id=\"transitiongroup\">TransitionGroup <a class=\"header-anchor\" href=\"#transitiongroup\">​<a><h1><p><code><TransitionGroup><code> 是一个内置组件，用于对 <code>v-for<code> 列表中的元素或组件的插入、移除和顺序改变添加动画效果。<p><h2 id=\"differences-from-transition\">和 <code><Transition><code> 的区别 <a class=\"header-anchor\" href=\"#differences-from-transition\">​<a><h2><p><code><TransitionGroup><code> 支持和 <code><Transition><code> 基本相同的 props、CSS 过渡 class 和 JavaScript 钩子监听器，但有以下几点区别：<p><ul><li><p>默认情况下，它不会渲染一个容器元素。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 0, "_doc_id": "0_4514014591718619665"}}
{"doc_id": "1_2400070267131954004", "text": "nsition><code> 基本相同的 props、CSS 过渡 class 和 JavaScript 钩子监听器，但有以下几点区别：<p><ul><li><p>默认情况下，它不会渲染一个容器元素。但你可以通过传入 <code>tag<code> prop 来指定一个元素作为容器元素来渲染。<p><li><li><p><a href=\"./transition.html#transition-modes\">过渡模式<a>在这里不可用，因为我们不再是在互斥的元素之间进行切换。<p><li><li><p>列表中的每个元素都<strong>必须<strong>有一个独一无二的 <code>key<code> attribute。<p><li><li><p>CSS 过渡 class 会被应用在列表内的元素上，<strong>而不是<strong>容器元素上。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 1, "_doc_id": "1_2400070267131954004"}}
{"doc_id": "2_6904266375694332298", "text": "有一个独一无二的 <code>key<code> attribute。<p><li><li><p>CSS 过渡 class 会被应用在列表内的元素上，<strong>而不是<strong>容器元素上。<p><li><ul><div class=\"tip custom-block\"><p class=\"custom-block-title\">TIP<p><p>当在 <a href=\"/guide/essentials/component-basics.html#in-dom-template-parsing-caveats\">DOM 内模板<a>中使用时，组件名需要写为 <code><transition-group><code>。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 2, "_doc_id": "2_6904266375694332298"}}
{"doc_id": "3_4486852926042184865", "text": "-basics.html#in-dom-template-parsing-caveats\">DOM 内模板<a>中使用时，组件名需要写为 <code><transition-group><code>。<p><div><h2 id=\"enter-leave-transitions\">进入 / 离开动画 <a class=\"header-anchor\" href=\"#enter-leave-transitions\">​<a><h2><p>这里是 <code><TransitionGroup><code> 对一个 <code>v-for<code> 列表添加进入 / 离开动画的示例：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>TransitionGroup<span><span> name<span><span>=<span><span>\"list\"<span><span> tag<span><span>=<span><span>\"ul\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 3, "_doc_id": "3_4486852926042184865"}}
{"doc_id": "4_6057197341509128545", "text": "pan><span>=<span><span>\"list\"<span><span> tag<span><span>=<span><span>\"ul\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>li<span><span> v-for<span><span>=<span><span>\"<span><span>item <span><span>in<span><span> items<span><span>\"<span><span> :<span><span>key<span><span>=<span><span>\"<span><span>item<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> {{ item }}<span><span>\n<span class=\"line\"><span> </<span><span>li<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 4, "_doc_id": "4_6057197341509128545"}}
{"doc_id": "5_7408484230846532430", "text": "\"><span> {{ item }}<span><span>\n<span class=\"line\"><span> </<span><span>li<span><span>><span><span>\n<span class=\"line\"><span></<span><span>TransitionGroup<span><span>><span><span><code><pre><div><div class=\"language-css\"> <span class=\"lang\">css<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>.list-enter-active<span><span>,<span><span>\n<span class=\"line\"><span>.list-leave-active<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 5, "_doc_id": "5_7408484230846532430"}}
{"doc_id": "6_7934826525312403997", "text": "tive<span><span>,<span><span>\n<span class=\"line\"><span>.list-leave-active<span><span> {<span><span>\n<span class=\"line\"><span> transition<span><span>: <span><span>all<span><span> 0.5<span><span>s<span><span> ease<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>.list-enter-from<span><span>,<span><span>\n<span class=\"line\"><span>.list-leave-to<span><span> {<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 6, "_doc_id": "6_7934826525312403997"}}
{"doc_id": "7_1855543228609076189", "text": "{<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>\n<span class=\"line\"><span> transform<span><span>: <span><span>translateX<span><span>(<span><span>30<span><span>px<span><span>);<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 7, "_doc_id": "7_1855543228609076189"}}
{"doc_id": "8_5273630262158899686", "text": "n><span>: <span><span>translateX<span><span>(<span><span>30<span><span>px<span><span>);<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><h2 id=\"move-transitions\">移动动画 <a class=\"header-anchor\" href=\"#move-transitions\">​<a><h2><p>上面的示例有一些明显的缺陷：当某一项被插入或移除时，它周围的元素会立即发生“跳跃”而不是平稳地移动。我们可以通过添加一些额外的 CSS 规则来解决这个问题：<p><div class=\"language-css\"> <span class=\"lang\">css<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line highlighted\"><span>.list-move<span><span>, <span><span>/* 对移动中的元素应用的过渡 */<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 8, "_doc_id": "8_5273630262158899686"}}
{"doc_id": "9_2785081120684608117", "text": "n class=\"line highlighted\"><span>.list-move<span><span>, <span><span>/* 对移动中的元素应用的过渡 */<span><span>\n<span class=\"line\"><span>.list-enter-active<span><span>,<span><span>\n<span class=\"line\"><span>.list-leave-active<span><span> {<span><span>\n<span class=\"line\"><span> transition<span><span>: <span><span>all<span><span> 0.5<span><span>s<span><span> ease<span><span>;<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>.list-enter-from<span><span>,<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 9, "_doc_id": "9_2785081120684608117"}}
{"doc_id": "10_8531640093077522828", "text": "<span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>.list-enter-from<span><span>,<span><span>\n<span class=\"line\"><span>.list-leave-to<span><span> {<span><span>\n<span class=\"line\"><span> opacity<span><span>: <span><span>0<span><span>;<span><span>\n<span class=\"line\"><span> transform<span><span>: <span><span>translateX<span><span>(<span><span>30<span><span>px<span><span>);<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 10, "_doc_id": "10_8531640093077522828"}}
{"doc_id": "11_2770781496471757691", "text": "<span>px<span><span>);<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span>\n<span class=\"line highlighted\"><span>/* 确保将离开的元素从布局流中删除<span><span>\n<span class=\"line highlighted\"><span> 以便能够正确地计算移动的动画。 */<span><span>\n<span class=\"line highlighted\"><span>.list-leave-active<span><span> {<span><span>\n<span class=\"line highlighted\"><span> position<span><span>: <span><span>absolute<span><span>;<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 11, "_doc_id": "11_2770781496471757691"}}
{"doc_id": "12_2430353585370365797", "text": "class=\"line highlighted\"><span> position<span><span>: <span><span>absolute<span><span>;<span><span>\n<span class=\"line highlighted\"><span>}<span><span><code><pre><div><p>现在它看起来好多了，甚至对整个列表执行洗牌的动画也都非常流畅：<p><p><a href=\"/examples/#list-transition\">完整的示例<a><p><h3 id=\"custom-transitiongroup-classes\">自定义过渡组 class <a class=\"header-anchor\" href=\"#custom-transitiongroup-classes\">​<a><h3><p>你还可以通过向 <code><TransitionGroup><code> 传递 <code>moveClass<code> prop 为移动元素指定自定义过渡 class，类似于<a href=\"/guide/built-ins/transition.html#custom-transition-classes\">自定义过渡 class<a>。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 12, "_doc_id": "12_2430353585370365797"}}
{"doc_id": "13_3206638181786586874", "text": "定自定义过渡 class，类似于<a href=\"/guide/built-ins/transition.html#custom-transition-classes\">自定义过渡 class<a>。<p><h2 id=\"staggering-list-transitions\">渐进延迟列表动画 <a class=\"header-anchor\" href=\"#staggering-list-transitions\">​<a><h2><p>通过在 JavaScript 钩子中读取元素的 data attribute，我们可以实现带渐进延迟的列表动画。首先，我们把每一个元素的索引渲染为该元素上的一个 data attribute：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>TransitionGroup<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 13, "_doc_id": "13_3206638181786586874"}}
{"doc_id": "14_3305835891848157904", "text": "\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>TransitionGroup<span><span>\n<span class=\"line\"><span> tag<span><span>=<span><span>\"ul\"<span><span>\n<span class=\"line\"><span> :<span><span>css<span><span>=<span><span>\"<span><span>false<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>before-enter<span><span>=<span><span>\"<span><span>onBeforeEnter<span><span>\"<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 14, "_doc_id": "14_3305835891848157904"}}
{"doc_id": "15_4899801130297471545", "text": "span><span>before-enter<span><span>=<span><span>\"<span><span>onBeforeEnter<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>enter<span><span>=<span><span>\"<span><span>onEnter<span><span>\"<span><span>\n<span class=\"line\"><span> @<span><span>leave<span><span>=<span><span>\"<span><span>onLeave<span><span>\"<span><span>\n<span class=\"line\"><span>><span><span>\n<span class=\"line\"><span> <<span><span>li<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 15, "_doc_id": "15_4899801130297471545"}}
{"doc_id": "16_7400260294152264680", "text": "<span>\n<span class=\"line\"><span>><span><span>\n<span class=\"line\"><span> <<span><span>li<span><span>\n<span class=\"line\"><span> v-for<span><span>=<span><span>\"<span><span>(item, index) <span><span>in<span><span> computedList<span><span>\"<span><span>\n<span class=\"line\"><span> :<span><span>key<span><span>=<span><span>\"<span><span>item.msg<span><span>\"<span><span>\n<span class=\"line highlighted\"><span> :<span><span>data-index<span><span>=<span><span>\"<span><span>index<span><span>\"<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 16, "_doc_id": "16_7400260294152264680"}}
{"doc_id": "17_3642384476877518193", "text": "><span> :<span><span>data-index<span><span>=<span><span>\"<span><span>index<span><span>\"<span><span>\n<span class=\"line\"><span> ><span><span>\n<span class=\"line\"><span> {{ item.msg }}<span><span>\n<span class=\"line\"><span> </<span><span>li<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 17, "_doc_id": "17_3642384476877518193"}}
{"doc_id": "18_5170250745508780354", "text": "pan> {{ item.msg }}<span><span>\n<span class=\"line\"><span> </<span><span>li<span><span>><span><span>\n<span class=\"line\"><span></<span><span>TransitionGroup<span><span>><span><span><code><pre><div><p>接着，在 JavaScript 钩子中，我们基于当前元素的 data attribute 对该元素的进场动画添加一个延迟。以下是一个基于 <a href=\"https://gsap.com/\" target=\"_blank\">GSAP library<a> 的动画示例：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>function<span><span> onEnter<span><span>(<span><span>el<span><span>, <span><span>done<span><span>) {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 18, "_doc_id": "18_5170250745508780354"}}
{"doc_id": "19_5018598575436779432", "text": "><span> onEnter<span><span>(<span><span>el<span><span>, <span><span>done<span><span>) {<span><span>\n<span class=\"line\"><span> gsap.<span><span>to<span><span>(el, {<span><span>\n<span class=\"line\"><span> opacity: <span><span>1<span><span>,<span><span>\n<span class=\"line\"><span> height: <span><span>'1.6em'<span><span>,<span><span>\n<span class=\"line highlighted\"><span> delay: el.dataset.index <span><span>*<span><span> 0.15<span><span>,<span><span>\n<span class=\"line\"><span> onComplete: done<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 19, "_doc_id": "19_5018598575436779432"}}
{"doc_id": "20_4493975790337992471", "text": ">*<span><span> 0.15<span><span>,<span><span>\n<span class=\"line\"><span> onComplete: done<span><span>\n<span class=\"line\"><span> })<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div>\n<p><strong>参考<strong><p><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/transition-group.html", "title": "TransitionGroup | Vue.js", "doc_id": "63c7d6044eb74dcc881c4cbb0317d683", "content_type": "web_page", "word_count": 306, "chunk_index": 20, "_doc_id": "20_4493975790337992471"}}
{"doc_id": "0_4989804403213058759", "text": "<div><div><h1 id=\"keepalive\">KeepAlive <a class=\"header-anchor\" href=\"#keepalive\">​<a><h1><p><code><KeepAlive><code> 是一个内置组件，它的功能是在多个组件间动态切换时缓存被移除的组件实例。<p><h2 id=\"basic-usage\">基本使用 <a class=\"header-anchor\" href=\"#basic-usage\">​<a><h2><p>在组件基础章节中，", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 0, "_doc_id": "0_4989804403213058759"}}
{"doc_id": "1_6148776128071863362", "text": "的组件实例。<p><h2 id=\"basic-usage\">基本使用 <a class=\"header-anchor\" href=\"#basic-usage\">​<a><h2><p>在组件基础章节中，我们已经介绍了通过特殊的 <code><component><code> 元素来实现<a href=\"/guide/essentials/component-basics.html#dynamic-components\">动态组件<a>的用法：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>component<span><span> :<span><span>is<span><span>=<span><span>\"<span><span>activeComponent<span><span>\"<span><span> /><span><span><code><pre><div><p>默认情况下，", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 1, "_doc_id": "1_6148776128071863362"}}
{"doc_id": "2_3997623110509074729", "text": "><span>\"<span><span>activeComponent<span><span>\"<span><span> /><span><span><code><pre><div><p>默认情况下，一个组件实例在被替换掉后会被销毁。这会导致它丢失其中所有已变化的状态——当这个组件再一次被显示时，会创建一个只带有初始状态的新实例。<p><p>在下面的例子中，你会看到两个有状态的组件——A 有一个计数器，而 B 有一个通过 <code>v-model<code> 同步 input 框输入内容的文字展示。尝试先更改一下任意一个组件的状态，然后切走，再切回来：<p><p>你会发现在切回来之后，之前已更改的状态都被重置了。<p><p>在切换时创建新的组件实例通常是有意义的，但在这个例子中，我们的确想要组件能在被“切走”的时候保留它们的状态。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 2, "_doc_id": "2_3997623110509074729"}}
{"doc_id": "3_420059748672566840", "text": "后切走，再切回来：<p><p>你会发现在切回来之后，之前已更改的状态都被重置了。<p><p>在切换时创建新的组件实例通常是有意义的，但在这个例子中，我们的确想要组件能在被“切走”的时候保留它们的状态。要解决这个问题，我们可以用 <code><KeepAlive><code> 内置组件将这些动态组件包装起来：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- 非活跃的组件将会被缓存！ --><span><span>\n<span class=\"line\"><span><<span><span>KeepAlive<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 3, "_doc_id": "3_420059748672566840"}}
{"doc_id": "4_6455751273208590143", "text": "跃的组件将会被缓存！ --><span><span>\n<span class=\"line\"><span><<span><span>KeepAlive<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>component<span><span> :<span><span>is<span><span>=<span><span>\"<span><span>activeComponent<span><span>\"<span><span> /><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 4, "_doc_id": "4_6455751273208590143"}}
{"doc_id": "5_2383290219144296124", "text": "pan>is<span><span>=<span><span>\"<span><span>activeComponent<span><span>\"<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>KeepAlive<span><span>><span><span><code><pre><div><p>现在，在组件切换时状态也能被保留了：<p><div class=\"tip custom-block\"><p class=\"custom-block-title\">TIP<p><p>在 <a href=\"/guide/essentials/component-basics.html#in-dom-template-parsing-caveats\">DOM 内模板<a>中使用时，它应该被写为 <code><keep-alive><code>。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 5, "_doc_id": "5_2383290219144296124"}}
{"doc_id": "6_7612219892049010372", "text": "mponent-basics.html#in-dom-template-parsing-caveats\">DOM 内模板<a>中使用时，它应该被写为 <code><keep-alive><code>。<p><div><h2 id=\"include-exclude\">包含/排除 <a class=\"header-anchor\" href=\"#include-exclude\">​<a><h2><p><code><KeepAlive><code> 默认会缓存内部的所有组件实例，但我们可以通过 <code>include<code> 和 <code>exclude<code> prop 来定制该行为。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 6, "_doc_id": "6_7612219892049010372"}}
{"doc_id": "7_482111824719089712", "text": "code><KeepAlive><code> 默认会缓存内部的所有组件实例，但我们可以通过 <code>include<code> 和 <code>exclude<code> prop 来定制该行为。这两个 prop 的值都可以是一个以英文逗号分隔的字符串、一个正则表达式，或是包含这两种类型的一个数组：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><!-- 以英文逗号分隔的字符串 --><span><span>\n<span class=\"line\"><span><<span><span>KeepAlive<span><span> include<span><span>=<span><span>\"a,b\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 7, "_doc_id": "7_482111824719089712"}}
{"doc_id": "8_1482144287194012486", "text": "n><<span><span>KeepAlive<span><span> include<span><span>=<span><span>\"a,b\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>component<span><span> :<span><span>is<span><span>=<span><span>\"<span><span>view<span><span>\"<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>KeepAlive<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><!-- 正则表达式 (需使用 `v-bind`) --><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 8, "_doc_id": "8_1482144287194012486"}}
{"doc_id": "9_2687098795849672736", "text": "<span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><!-- 正则表达式 (需使用 `v-bind`) --><span><span>\n<span class=\"line\"><span><<span><span>KeepAlive<span><span> :<span><span>include<span><span>=<span><span>\"/<span><span>a<span><span>|<span><span>b<span><span>/\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>component<span><span> :<span><span>is<span><span>=<span><span>\"<span><span>view<span><span>\"<span><span> /><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 9, "_doc_id": "9_2687098795849672736"}}
{"doc_id": "10_4659088121219042983", "text": "> :<span><span>is<span><span>=<span><span>\"<span><span>view<span><span>\"<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>KeepAlive<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><!-- 数组 (需使用 `v-bind`) --><span><span>\n<span class=\"line\"><span><<span><span>KeepAlive<span><span> :<span><span>include<span><span>=<span><span>\"<span><span>[<span><span>'a'<span><span>, <span><span>'b'<span><span>]<span><span>\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 10, "_doc_id": "10_4659088121219042983"}}
{"doc_id": "11_8697693222707296300", "text": "an>[<span><span>'a'<span><span>, <span><span>'b'<span><span>]<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>component<span><span> :<span><span>is<span><span>=<span><span>\"<span><span>view<span><span>\"<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>KeepAlive<span><span>><span><span><code><pre><div><p>它会根据组件的 <a href=\"/api/options-misc.html#name\"><code>name<code><a> 选项进行匹配，所以组件如果想要条件性地被 <code>KeepAlive<code> 缓存，就必须显式声明一个 <code>name<code> 选项。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 11, "_doc_id": "11_8697693222707296300"}}
{"doc_id": "12_7499406190585333616", "text": "me\"><code>name<code><a> 选项进行匹配，所以组件如果想要条件性地被 <code>KeepAlive<code> 缓存，就必须显式声明一个 <code>name<code> 选项。<p><div class=\"tip custom-block\"><p class=\"custom-block-title\">TIP<p><p>在 3.2.34 或以上的版本中，使用 <code><script setup><code> 的单文件组件会自动根据文件名生成对应的 <code>name<code> 选项，无需再手动声明。<p><div><h2 id=\"max-cached-instances\">最大缓存实例数 <a class=\"header-anchor\" href=\"#max-cached-instances\">​<a><h2><p>我们可以通过传入 <code>max<code> prop 来限制可被缓存的最大组件实例数。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 12, "_doc_id": "12_7499406190585333616"}}
{"doc_id": "13_2806937603747017131", "text": "eader-anchor\" href=\"#max-cached-instances\">​<a><h2><p>我们可以通过传入 <code>max<code> prop 来限制可被缓存的最大组件实例数。<code><KeepAlive><code> 的行为在指定了 <code>max<code> 后类似一个 <a href=\"https://en.wikipedia.org/wiki/Cache_replacement_policies#Least_recently_used_(LRU)\" target=\"_blank\">LRU 缓存<a>：如果缓存的实例数量即将超过指定的那个最大数量，则最久没有被访问的缓存实例将被销毁，以便为新的实例腾出空间。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 13, "_doc_id": "13_2806937603747017131"}}
{"doc_id": "14_1877110604149465783", "text": "recently_used_(LRU)\" target=\"_blank\">LRU 缓存<a>：如果缓存的实例数量即将超过指定的那个最大数量，则最久没有被访问的缓存实例将被销毁，以便为新的实例腾出空间。<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>KeepAlive<span><span> :<span><span>max<span><span>=<span><span>\"<span><span>10<span><span>\"<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 14, "_doc_id": "14_1877110604149465783"}}
{"doc_id": "15_14652681894071931", "text": "pan> :<span><span>max<span><span>=<span><span>\"<span><span>10<span><span>\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>component<span><span> :<span><span>is<span><span>=<span><span>\"<span><span>activeComponent<span><span>\"<span><span> /><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 15, "_doc_id": "15_14652681894071931"}}
{"doc_id": "16_5883685302939283313", "text": "pan>is<span><span>=<span><span>\"<span><span>activeComponent<span><span>\"<span><span> /><span><span>\n<span class=\"line\"><span></<span><span>KeepAlive<span><span>><span><span><code><pre><div><h2 id=\"lifecycle-of-cached-instance\">缓存实例的生命周期 <a class=\"header-anchor\" href=\"#lifecycle-of-cached-instance\">​<a><h2><p>当一个组件实例从 DOM 上移除但因为被 <code><KeepAlive><code> 缓存而仍作为组件树的一部分时，它将变为<strong>不活跃<strong>状态而不是被卸载。当一个组件实例作为缓存树的一部分插入到 DOM 中时，它将重新<strong>被激活<strong>。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 16, "_doc_id": "16_5883685302939283313"}}
{"doc_id": "17_981361515142587378", "text": "> 缓存而仍作为组件树的一部分时，它将变为<strong>不活跃<strong>状态而不是被卸载。当一个组件实例作为缓存树的一部分插入到 DOM 中时，它将重新<strong>被激活<strong>。<p><div class=\"composition-api\"><p>一个持续存在的组件可以通过 <a href=\"/api/composition-api-lifecycle.html#onactivated\"><code>onActivated()<code><a> 和 <a href=\"/api/composition-api-lifecycle.html#ondeactivated\"><code>onDeactivated()<code><a> 注册相应的两个状态的生命周期钩子：<p><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 17, "_doc_id": "17_981361515142587378"}}
{"doc_id": "18_3124383691955215687", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { onActivated, onDeactivated } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>onActivated<span><span>(() <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> // 调用时机为首次挂载<span><span>\n<span class=\"line\"><span> // 以及每次从缓存中被重新插入时<span><span>\n<span class=\"line\"><span>})<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 18, "_doc_id": "18_3124383691955215687"}}
{"doc_id": "19_6688858546604246095", "text": "an>\n<span class=\"line\"><span> // 以及每次从缓存中被重新插入时<span><span>\n<span class=\"line\"><span>})<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>onDeactivated<span><span>(() <span><span>=><span><span> {<span><span>\n<span class=\"line\"><span> // 在从 DOM 上移除、进入缓存<span><span>\n<span class=\"line\"><span> // 以及组件卸载时调用<span><span>\n<span class=\"line\"><span>})<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 19, "_doc_id": "19_6688858546604246095"}}
{"doc_id": "20_119287060650951431", "text": "n><span>\n<span class=\"line\"><span> // 以及组件卸载时调用<span><span>\n<span class=\"line\"><span>})<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><div><div class=\"options-api\"><p>一个持续存在的组件可以通过 <a href=\"/api/options-lifecycle.html#activated\"><code>activated<code><a> 和 <a href=\"/api/options-lifecycle.html#deactivated\"><code>deactivated<code><a> 选项来注册相应的两个状态的生命周期钩子：<p><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 20, "_doc_id": "20_119287060650951431"}}
{"doc_id": "21_7278274509844647179", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> activated<span><span>() {<span><span>\n<span class=\"line\"><span> // 在首次挂载、<span><span>\n<span class=\"line\"><span> // 以及每次从缓存中被重新插入的时候调用<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> deactivated<span><span>() {<span><span>\n<span class=\"line\"><span> // 在从 DOM 上移除、进入缓存<span><span>\n<span class=\"line\"><span> // 以及组件卸载时调用<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 21, "_doc_id": "21_7278274509844647179"}}
{"doc_id": "22_4448178115110755540", "text": "ass=\"line\"><span> // 在从 DOM 上移除、进入缓存<span><span>\n<span class=\"line\"><span> // 以及组件卸载时调用<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p>请注意：<p>\n<p><strong>参考<strong><p><div><div>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/keep-alive.html", "title": "KeepAlive | Vue.js", "doc_id": "47b47a6720b5455cbd470c2d504b0a14", "content_type": "web_page", "word_count": 290, "chunk_index": 22, "_doc_id": "22_4448178115110755540"}}
{"doc_id": "0_1872354660258675435", "text": "<div><div><h1 id=\"teleport\">Teleport <a class=\"header-anchor\" href=\"#teleport\">​<a><h1><p><code><Teleport><code> 是一个内置组件，它可以将一个组件内部的一部分模板“传送”到该组件的 DOM 结构外层的位置去。<p><h2 id=\"basic-usage\">基本用法 <a class=\"header-anchor\" href=\"#basic-usage\">​<a><h2><p>有时我们可能会遇到这样的场景：一个组件模板的一部分在逻辑上从属于该组件，但从整个应用视图的角度来看，它在 DOM 中应该被渲染在其他地方，甚至在整个 Vue 应用外部。<p><p>这类场景最常见的例子就是全屏的模态框。理想情况下，我们希望触发模态框的按钮和模态框本身的代码是在同一个单文件组件中，因为它们都与组件的开关状态有关。但这意味着该模态框将与按钮一起渲染在应用 DOM 结构里很深的地方。这会导致该模态框的 CSS 布局代码很难写。", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/teleport.html", "title": "Teleport | Vue.js", "doc_id": "2b897bdcb43448898ecbf09f53100229", "content_type": "web_page", "word_count": 499, "chunk_index": 0, "_doc_id": "0_1872354660258675435"}}
{"doc_id": "1_8197479905737174282", "text": "发模态框的按钮和模态框本身的代码是在同一个单文件组件中，因为它们都与组件的开关状态有关。但这意味着该模态框将与按钮一起渲染在应用 DOM 结构里很深的地方。这会导致该模态框的 CSS 布局代码很难写。<p><p>试想下面这样的 HTML 结构：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> class<span><span>=<span><span>\"outer\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>h3<span><span>>Tooltips with Vue 3 Teleport</<span><span>h3<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/teleport.html", "title": "Teleport | Vue.js", "doc_id": "2b897bdcb43448898ecbf09f53100229", "content_type": "web_page", "word_count": 499, "chunk_index": 1, "_doc_id": "1_8197479905737174282"}}
{"doc_id": "2_3261222381242028904", "text": "> <<span><span>h3<span><span>>Tooltips with Vue 3 Teleport</<span><span>h3<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>div<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>MyModal<span><span> /><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/teleport.html", "title": "Teleport | Vue.js", "doc_id": "2b897bdcb43448898ecbf09f53100229", "content_type": "web_page", "word_count": 499, "chunk_index": 2, "_doc_id": "2_3261222381242028904"}}
{"doc_id": "3_8579725532235724701", "text": "dal<span><span> /><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span></<span><span>div<span><span>><span><span><code><pre><div><p>接下来我们来看看 <code><MyModal><code> 的实现：<p><div class=\"composition-api\"><div class=\"language-vue\"> <span class=\"lang\">vue<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/teleport.html", "title": "Teleport | Vue.js", "doc_id": "2b897bdcb43448898ecbf09f53100229", "content_type": "web_page", "word_count": 499, "chunk_index": 3, "_doc_id": "3_8579725532235724701"}}
{"doc_id": "4_7314357496413587111", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>import<span><span> { ref } <span><span>from<span><span> 'vue'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> open<span><span> =<span><span> ref<span><span>(<span><span>false<span><span>)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/teleport.html", "title": "Teleport | Vue.js", "doc_id": "2b897bdcb43448898ecbf09f53100229", "content_type": "web_page", "word_count": 499, "chunk_index": 4, "_doc_id": "4_7314357496413587111"}}
{"doc_id": "5_3803937200978341222", "text": "n>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>button<span><span> @click<span><span>=<span><span>\"open = true\"<span><span>>Open Modal</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/teleport.html", "title": "Teleport | Vue.js", "doc_id": "2b897bdcb43448898ecbf09f53100229", "content_type": "web_page", "word_count": 499, "chunk_index": 5, "_doc_id": "5_3803937200978341222"}}
{"doc_id": "6_4030246923630153211", "text": "true\"<span><span>>Open Modal</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> <<span><span>div<span><span> v-if<span><span>=<span><span>\"open\"<span><span> class<span><span>=<span><span>\"modal\"<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>p<span><span>>Hello from the modal!</<span><span>p<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/teleport.html", "title": "Teleport | Vue.js", "doc_id": "2b897bdcb43448898ecbf09f53100229", "content_type": "web_page", "word_count": 499, "chunk_index": 6, "_doc_id": "6_4030246923630153211"}}
{"doc_id": "7_8838074581535168165", "text": "ne\"><span> <<span><span>p<span><span>>Hello from the modal!</<span><span>p<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>button<span><span> @click<span><span>=<span><span>\"open = false\"<span><span>>Close</<span><span>button<span><span>><span><span>\n<span class=\"line\"><span> </<span><span>div<span><span>><span><span>\n<span class=\"line\"><span></<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/teleport.html", "title": "Teleport | Vue.js", "doc_id": "2b897bdcb43448898ecbf09f53100229", "content_type": "web_page", "word_count": 499, "chunk_index": 7, "_doc_id": "7_8838074581535168165"}}
{"doc_id": "8_4299088596187064994", "text": "<span class=\"line\"><span></<span><span>template<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>style<span><span> scoped<span><span>><span><span>\n<span class=\"line\"><span>.modal<span><span> {<span><span>\n<span class=\"line\"><span> position<span><span>: <span><span>fixed<span><span>;<span><span>\n<span class=\"line\"><span> z-index<span><span>: <span><span>999<span><span>;<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/built-ins/teleport.html", "title": "Teleport | Vue.js", "doc_id": "2b897bdcb43448898ecbf09f53100229", "content_type": "web_page", "word_count": 499, "chunk_index": 8, "_doc_id": "8_4299088596187064994"}}
