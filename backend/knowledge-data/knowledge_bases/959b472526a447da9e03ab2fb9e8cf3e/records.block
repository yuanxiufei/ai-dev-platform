{"doc_id": "40_147899765994492122", "text": "class=\"line\"><span> value: {<span><span>\n<span class=\"line\"><span> get<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> this<span><span>.modelValue<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> set<span><span>(<span><span>value<span><span>) {<span><span>\n<span class=\"line\"><span> this<span><span>.<span><span>$emit<span><span>(<span><span>'update:modelValue'<span><span>, value)<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "e5a6b5a7baae4b688591173d9eb47bf3", "content_type": "web_page", "word_count": 1636, "chunk_index": 40, "_doc_id": "40_147899765994492122"}}
{"doc_id": "41_7062037124901246787", "text": "n><span>'update:modelValue'<span><span>, value)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>input<span><span> v-model<span><span>=<span><span>\"value\"<span><span> /><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "e5a6b5a7baae4b688591173d9eb47bf3", "content_type": "web_page", "word_count": 1636, "chunk_index": 41, "_doc_id": "41_7062037124901246787"}}
