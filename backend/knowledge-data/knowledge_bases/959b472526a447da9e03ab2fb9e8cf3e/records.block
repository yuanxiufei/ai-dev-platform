{"doc_id": "92_6530672285126727977", "text": "code\"><code><span class=\"line\"><span><<span><span>script<span><span> setup<span><span>><span><span>\n<span class=\"line\"><span>const<span><span> props<span><span> =<span><span> defineProps<span><span>({<span><span>\n<span class=\"line\"><span> modelValue: String,<span><span>\n<span class=\"line\"><span> modelModifiers: { <span><span>default<span><span>: () <span><span>=><span><span> ({}) }<span><span>\n<span class=\"line\"><span>})<span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/components/v-model.html", "title": "组件 v-model", "doc_id": "749d024c41bc4d7281978acfb8b13e02", "content_type": "web_page", "word_count": 1636, "chunk_index": 92, "_doc_id": "92_6530672285126727977"}}
