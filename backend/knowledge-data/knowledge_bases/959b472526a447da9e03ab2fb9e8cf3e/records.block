{"doc_id": "1_7607633251122800443", "text": "<td><td>Illegal '/' in tags.<td><tr><tr class=\"\"><td id=\"compiler-5\">5<td><td>Unexpected EOF in tag.<td><tr><tr class=\"\"><td id=\"compiler-6\">6<td><td>Unexpected EOF in CDATA section.<td><tr><tr class=\"\"><td id=\"compiler-7\">7<td><td>Unexpected EOF in comment.<td><tr><tr class=\"\"><td id=\"compiler-8\">8<td><td>Unexpected EOF in script.<td><tr><tr class=\"\"><td id=\"compiler-9\">9<td><td>Unexpected EOF in tag.<td><tr><tr class=\"\"><td id=\"compiler-10\">10<td><td>Incorrectly closed comment.", "metadata": {"source": "https://cn.vuejs.org/error-reference/", "title": "生产环境错误代码参考", "doc_id": "7a236724b5004177a5e61a7ec1f9a708", "content_type": "web_page", "word_count": 574, "chunk_index": 1, "_doc_id": "1_7607633251122800443"}}
