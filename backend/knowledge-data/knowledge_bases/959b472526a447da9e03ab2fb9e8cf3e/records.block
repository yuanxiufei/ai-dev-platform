{"doc_id": "44_5071782666120257595", "text": "MyComponent <span><span>from<span><span> './my-component.js'<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> createApp<span><span>(MyComponent).<span><span>mount<span><span>(<span><span>'#app'<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/quick-start.html", "title": "快速上手", "doc_id": "67f18a7c6c2e43af890fc1973d75f794", "content_type": "web_page", "word_count": 917, "chunk_index": 44, "_doc_id": "44_5071782666120257595"}}
