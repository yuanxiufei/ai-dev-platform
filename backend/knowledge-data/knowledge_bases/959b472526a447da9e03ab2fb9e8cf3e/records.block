{"doc_id": "51_6408200386770212120", "text": "pan> ]<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> },<span><span>\n<span class=\"line\"><span> mounted<span><span>() {<span><span>\n<span class=\"line\"><span> console.<span><span>log<span><span>(<span><span>this<span><span>.$refs.items)<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/template-refs.html", "title": "模板引用", "doc_id": "b0c23bddf7b549de9f938a851591b7fa", "content_type": "web_page", "word_count": 925, "chunk_index": 51, "_doc_id": "51_6408200386770212120"}}
{"doc_id": "52_265968043857177190", "text": "n>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>template<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>ul<span><span>><span><span>\n<span class=\"line\"><span> <<span><span>li<span><span> v-for<span><span>=<span><span>\"item in list\"<span><span> ref<span><span>=<span><span>\"items\"<span><span>><span><span>\n<span class=\"line\"><span> {{ item }}<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/template-refs.html", "title": "模板引用", "doc_id": "b0c23bddf7b549de9f938a851591b7fa", "content_type": "web_page", "word_count": 925, "chunk_index": 52, "_doc_id": "52_265968043857177190"}}
