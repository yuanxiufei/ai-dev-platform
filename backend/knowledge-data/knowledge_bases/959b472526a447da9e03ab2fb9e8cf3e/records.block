{"doc_id": "11_4536321496013526938", "text": "r <template> tags.<td><tr><tr class=\"\"><td id=\"compiler-41\">41<td><td>v-model is missing expression.<td><tr><tr class=\"\"><td id=\"compiler-42\">42<td><td>v-model value must be a valid JavaScript member expression.<td><tr><tr class=\"\"><td id=\"compiler-43\">43<td><td>v-model cannot be used on v-for or v-slot scope variables because they are not writable.<td><tr><tr class=\"\"><td id=\"compiler-44\">44<td><td>v-model cannot be used on a prop, because local prop bindings are not writable.", "metadata": {"source": "https://cn.vuejs.org/error-reference/", "title": "生产环境错误代码参考", "doc_id": "a8693cde9ea5461ea2be08554b113435", "content_type": "web_page", "word_count": 574, "chunk_index": 11, "_doc_id": "11_4536321496013526938"}}
{"doc_id": "12_590560854580763000", "text": "piler-44\">44<td><td>v-model cannot be used on a prop, because local prop bindings are not writable.\nUse a v-bind binding combined with a v-on listener that emits update:x event instead.<td><tr><tr class=\"\"><td id=\"compiler-45\">45<td><td>v-model cannot be used on a const binding because it is not writable.<td><tr><tr class=\"\"><td id=\"compiler-46\">46<td><td>Error parsing JavaScript expression: <td><tr><tr class=\"\"><td id=\"compiler-47\">47<td><td><KeepAlive> expects exactly one child component.", "metadata": {"source": "https://cn.vuejs.org/error-reference/", "title": "生产环境错误代码参考", "doc_id": "a8693cde9ea5461ea2be08554b113435", "content_type": "web_page", "word_count": 574, "chunk_index": 12, "_doc_id": "12_590560854580763000"}}
{"doc_id": "13_8242615948703483459", "text": "<td><tr><tr class=\"\"><td id=\"compiler-47\">47<td><td><KeepAlive> expects exactly one child component.<td><tr><tr class=\"\"><td id=\"compiler-48\">48<td><td>\"prefixIdentifiers\" option is not supported in this build of compiler.<td><tr><tr class=\"\"><td id=\"compiler-49\">49<td><td>ES module mode is not supported in this build of compiler.<td><tr><tr class=\"\"><td id=\"compiler-50\">50<td><td>\"cacheHandlers\" option is only supported when the \"prefixIdentifiers\" option is enabled.", "metadata": {"source": "https://cn.vuejs.org/error-reference/", "title": "生产环境错误代码参考", "doc_id": "a8693cde9ea5461ea2be08554b113435", "content_type": "web_page", "word_count": 574, "chunk_index": 13, "_doc_id": "13_8242615948703483459"}}
{"doc_id": "14_6402972262044100588", "text": "\">50<td><td>\"cacheHandlers\" option is only supported when the \"prefixIdentifiers\" option is enabled.<td><tr><tr class=\"\"><td id=\"compiler-51\">51<td><td>\"scopeId\" option is only supported in module mode.<td><tr><tr class=\"\"><td id=\"compiler-52\">52<td><td>@vnode-* hooks in templates are no longer supported. Use the vue: prefix instead. For example, @vnode-mounted should be changed to @vue:mounted. @vnode-* hooks support has been removed in 3.4.", "metadata": {"source": "https://cn.vuejs.org/error-reference/", "title": "生产环境错误代码参考", "doc_id": "a8693cde9ea5461ea2be08554b113435", "content_type": "web_page", "word_count": 574, "chunk_index": 14, "_doc_id": "14_6402972262044100588"}}
{"doc_id": "15_2362993793874438590", "text": "e, @vnode-mounted should be changed to @vue:mounted. @vnode-* hooks support has been removed in 3.4.<td><tr><tr class=\"\"><td id=\"compiler-53\">53<td><td>v-bind with same-name shorthand only allows static argument.<td><tr><tr class=\"\"><td id=\"compiler-54\">54<td><td>v-html is missing expression.<td><tr><tr class=\"\"><td id=\"compiler-55\">55<td><td>v-html will override element children.<td><tr><tr class=\"\"><td id=\"compiler-56\">56<td><td>v-text is missing expression.", "metadata": {"source": "https://cn.vuejs.org/error-reference/", "title": "生产环境错误代码参考", "doc_id": "a8693cde9ea5461ea2be08554b113435", "content_type": "web_page", "word_count": 574, "chunk_index": 15, "_doc_id": "15_2362993793874438590"}}
{"doc_id": "16_569856424452261846", "text": "e element children.<td><tr><tr class=\"\"><td id=\"compiler-56\">56<td><td>v-text is missing expression.<td><tr><tr class=\"\"><td id=\"compiler-57\">57<td><td>v-text will override element children.<td><tr><tr class=\"\"><td id=\"compiler-58\">58<td><td>v-model can only be used on <input>,", "metadata": {"source": "https://cn.vuejs.org/error-reference/", "title": "生产环境错误代码参考", "doc_id": "a8693cde9ea5461ea2be08554b113435", "content_type": "web_page", "word_count": 574, "chunk_index": 16, "_doc_id": "16_569856424452261846"}}
{"doc_id": "17_6423918721819790089", "text": "t children.<td><tr><tr class=\"\"><td id=\"compiler-58\">58<td><td>v-model can only be used on <input>, <textarea> and <select> elements.<td><tr><tr class=\"\"><td id=\"compiler-59\">59<td><td>v-model argument is not supported on plain elements.<td><tr><tr class=\"\"><td id=\"compiler-60\">60<td><td>v-model cannot be used on file inputs since they are read-only. Use a v-on:change listener instead.<td><tr><tr class=\"\"><td id=\"compiler-61\">61<td><td>Unnecessary value binding used alongside v-model.", "metadata": {"source": "https://cn.vuejs.org/error-reference/", "title": "生产环境错误代码参考", "doc_id": "a8693cde9ea5461ea2be08554b113435", "content_type": "web_page", "word_count": 574, "chunk_index": 17, "_doc_id": "17_6423918721819790089"}}
{"doc_id": "18_6613299600335074606", "text": "d><tr><tr class=\"\"><td id=\"compiler-61\">61<td><td>Unnecessary value binding used alongside v-model. It will interfere with v-model's behavior.<td><tr><tr class=\"\"><td id=\"compiler-62\">62<td><td>v-show is missing expression.<td><tr><tr class=\"\"><td id=\"compiler-63\">63<td><td><Transition> expects exactly one child element or component.<td><tr><tr class=\"\"><td id=\"compiler-64\">64<td><td>Tags with side effect (<script> and <style>) are ignored in client component templates.<td><tr><tbody><div>", "metadata": {"source": "https://cn.vuejs.org/error-reference/", "title": "生产环境错误代码参考", "doc_id": "a8693cde9ea5461ea2be08554b113435", "content_type": "web_page", "word_count": 574, "chunk_index": 18, "_doc_id": "18_6613299600335074606"}}
{"doc_id": "0_8083239613095207606", "text": "[Failed to extract content from: https://cn.vuejs.org/api/]", "metadata": {"source": "https://cn.vuejs.org/api/", "title": "API 参考", "doc_id": "c113ba90fb67435292fc056f0488e089", "content_type": "web_page", "word_count": 6, "chunk_index": 0, "_doc_id": "0_8083239613095207606"}}
{"doc_id": "0_734584512330508212", "text": "<div><div><h1 id=\"class-and-style-bindings\">Class 与 Style 绑定 <a class=\"header-anchor\" href=\"#class-and-style-bindings\">​<a><h1><p>数据绑定的一个常见需求场景是操纵元素的 CSS class 列表和内联样式。因为 <code>class<code> 和 <code>style<code> 都是 attribute，我们可以和其他 attribute 一样使用 <code>v-bind<code> 将它们和动态的字符串绑定。但是，在处理比较复杂的绑定时，通过拼接生成字符串是麻烦且易出错的。因此，Vue 专门为 <code>class<code> 和 <code>style<code> 的 <code>v-bind<code> 用法提供了特殊的功能增强。除了字符串外，表达式的值也可以是对象或数组。<p><h2 id=\"binding-html-classes\">绑定 HTML class <a class=\"header-anchor\"", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 0, "_doc_id": "0_734584512330508212"}}
{"doc_id": "1_597954815941686560", "text": "的功能增强。除了字符串外，表达式的值也可以是对象或数组。<p><h2 id=\"binding-html-classes\">绑定 HTML class <a class=\"header-anchor\" href=\"#binding-html-classes\">​<a><h2><h3 id=\"binding-to-objects\">绑定对象 <a class=\"header-anchor\" href=\"#binding-to-objects\">​<a><h3><p>我们可以给 <code>:class<code> (<code>v-bind:class<code> 的缩写) 传递一个对象来动态切换 class：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 1, "_doc_id": "1_597954815941686560"}}
{"doc_id": "2_2666086225288142162", "text": "><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> :<span><span>class<span><span>=<span><span>\"<span><span>{ active: isActive }<span><span>\"<span><span>></<span><span>div<span><span>><span><span><code><pre><div><p>上面的语法表示 <code>active<code> 是否存在取决于数据属性 <code>isActive<code> 的<a href=\"https://developer.mozilla.org/en-US/docs/Glossary/Truthy\" target=\"_blank\">真假值<a>。<p><p>你可以在对象中写多个字段来操作多个 class。此外，<code>:class<code> 指令也可以和一般的 <code>class<code> attribute 共存。", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 2, "_doc_id": "2_2666086225288142162"}}
{"doc_id": "3_5964135936635237841", "text": "真假值<a>。<p><p>你可以在对象中写多个字段来操作多个 class。此外，<code>:class<code> 指令也可以和一般的 <code>class<code> attribute 共存。举例来说，下面这样的状态：<p><div class=\"composition-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> isActive<span><span> =<span><span> ref<span><span>(<span><span>true<span><span>)<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 3, "_doc_id": "3_5964135936635237841"}}
{"doc_id": "4_7412097866390408402", "text": "<span> isActive<span><span> =<span><span> ref<span><span>(<span><span>true<span><span>)<span><span>\n<span class=\"line\"><span>const<span><span> hasError<span><span> =<span><span> ref<span><span>(<span><span>false<span><span>)<span><span><code><pre><div><div><div class=\"options-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>data<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 4, "_doc_id": "4_7412097866390408402"}}
{"doc_id": "5_1274288942395957713", "text": "\"><span>data<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> isActive: <span><span>true<span><span>,<span><span>\n<span class=\"line\"><span> hasError: <span><span>false<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 5, "_doc_id": "5_1274288942395957713"}}
{"doc_id": "6_5479003255530477579", "text": "class=\"line\"><span> hasError: <span><span>false<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span>}<span><span><code><pre><div><div><p>配合以下模板：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span>\n<span class=\"line\"><span> class<span><span>=<span><span>\"static\"<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 6, "_doc_id": "6_5479003255530477579"}}
{"doc_id": "7_3855693260378572675", "text": "><span>div<span><span>\n<span class=\"line\"><span> class<span><span>=<span><span>\"static\"<span><span>\n<span class=\"line\"><span> :<span><span>class<span><span>=<span><span>\"<span><span>{ active: isActive, <span><span>'text-danger'<span><span>: hasError }<span><span>\"<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 7, "_doc_id": "7_3855693260378572675"}}
{"doc_id": "8_2731515688531594353", "text": "span>{ active: isActive, <span><span>'text-danger'<span><span>: hasError }<span><span>\"<span><span>\n<span class=\"line\"><span>></<span><span>div<span><span>><span><span><code><pre><div><p>渲染的结果会是：<p><div class=\"language-template\"> <span class=\"lang\">template<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>div<span><span> class<span><span>=<span><span>\"static active\"<span><span>></<span><span>div<span><span>><span><span><code><pre><div><p>当 <code>isActive<code> 或者 <code>hasError<code> 改变时，class 列表会随之更新。", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 8, "_doc_id": "8_2731515688531594353"}}
{"doc_id": "9_2586728573003327069", "text": "an>><span><span><code><pre><div><p>当 <code>isActive<code> 或者 <code>hasError<code> 改变时，class 列表会随之更新。举例来说，如果 <code>hasError<code> 变为 <code>true<code>，class 列表也会变成 <code>\"static active text-danger\"<code>。<p><p>绑定的对象并不一定需要写成内联字面量的形式，也可以直接绑定一个对象：<p><div class=\"composition-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> classObject<span><span> =<span><span> reactive<span><span>({<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 9, "_doc_id": "9_2586728573003327069"}}
{"doc_id": "10_4286768172945305159", "text": "e\"><span>const<span><span> classObject<span><span> =<span><span> reactive<span><span>({<span><span>\n<span class=\"line\"><span> active: <span><span>true<span><span>,<span><span>\n<span class=\"line\"><span> 'text-danger'<span><span>: <span><span>false<span><span>\n<span class=\"line\"><span>})<span><span><code><pre><div><div><div class=\"options-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>data<span><span>() {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 10, "_doc_id": "10_4286768172945305159"}}
{"doc_id": "11_1192037600641513214", "text": "e class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>data<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> classObject: {<span><span>\n<span class=\"line\"><span> active: <span><span>true<span><span>,<span><span>\n<span class=\"line\"><span> 'text-danger'<span><span>: <span><span>false<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>\n<span", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/class-and-style.html", "title": "Class 与 Style 绑定", "doc_id": "82d16c6b93eb4b32b529f1c9b5520813", "content_type": "web_page", "word_count": 797, "chunk_index": 11, "_doc_id": "11_1192037600641513214"}}
