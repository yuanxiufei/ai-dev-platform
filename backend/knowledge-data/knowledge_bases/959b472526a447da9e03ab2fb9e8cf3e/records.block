{"doc_id": "17_8702636963017127997", "text": "bjects/Set\" target=\"_blank\">集合<a>的值：<p><div class=\"composition-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>const<span><span> checkedNames<span><span> =<span><span> ref<span><span>([])<span><span><code><pre><div><div><div class=\"options-api\"><div class=\"language-js\"> <span class=\"lang\">js<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/forms.html", "title": "表单输入绑定", "doc_id": "13c92f8edd764e929f47f6f54c29e00e", "content_type": "web_page", "word_count": 829, "chunk_index": 17, "_doc_id": "17_8702636963017127997"}}
{"doc_id": "18_3262948072753359212", "text": "b-dark vp-code\"><code><span class=\"line\"><span>export<span><span> default<span><span> {<span><span>\n<span class=\"line\"><span> data<span><span>() {<span><span>\n<span class=\"line\"><span> return<span><span> {<span><span>\n<span class=\"line\"><span> checkedNames: []<span><span>\n<span class=\"line\"><span> }<span><span>\n<span class=\"line\"><span> }<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/forms.html", "title": "表单输入绑定", "doc_id": "13c92f8edd764e929f47f6f54c29e00e", "content_type": "web_page", "word_count": 829, "chunk_index": 18, "_doc_id": "18_3262948072753359212"}}
