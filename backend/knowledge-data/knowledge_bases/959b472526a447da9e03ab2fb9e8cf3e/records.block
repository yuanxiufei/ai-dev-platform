{"doc_id": "16_9195884321769100254", "text": "an class=\"line\"><span> }).<span><span>mount<span><span>(<span><span>'#app'<span><span>)<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span><code><pre><div><p><a href=\"https://codepen.io/vuejs-examples/pen/QWJwJLp\" target=\"_blank\">CodePen 示例 ><a><p><div><div class=\"composition-api\"><div class=\"language-html\"> <span class=\"lang\">html<span><pre class=\"shiki github-dark vp-code\"><code><span class=\"line\"><span><<span><span>script<span><span> src<span><span>=<span><span>\"https://unpkg.com/vue@3/dist/vue.global.js\"<span><span>></<span><span>script<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/quick-start.html", "title": "快速上手", "doc_id": "7bbea11cbdc04fc492ab7f8bcdb47bdf", "content_type": "web_page", "word_count": 917, "chunk_index": 16, "_doc_id": "16_9195884321769100254"}}
{"doc_id": "17_5410409336545622799", "text": "tps://unpkg.com/vue@3/dist/vue.global.js\"<span><span>></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>div<span><span> id<span><span>=<span><span>\"app\"<span><span>>{{ message }}</<span><span>div<span><span>><span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>script<span><span>><span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/quick-start.html", "title": "快速上手", "doc_id": "7bbea11cbdc04fc492ab7f8bcdb47bdf", "content_type": "web_page", "word_count": 917, "chunk_index": 17, "_doc_id": "17_5410409336545622799"}}
{"doc_id": "18_2704428213409555065", "text": "an>\n<span class=\"line\"><span>\n<span class=\"line\"><span><<span><span>script<span><span>><span><span>\n<span class=\"line\"><span> const<span><span> { <span><span>createApp<span><span>, <span><span>ref<span><span> } <span><span>=<span><span> Vue<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span> createApp<span><span>({<span><span>\n<span class=\"line\"><span> setup<span><span>() {<span><span>", "metadata": {"source": "https://cn.vuejs.org/guide/quick-start.html", "title": "快速上手", "doc_id": "7bbea11cbdc04fc492ab7f8bcdb47bdf", "content_type": "web_page", "word_count": 917, "chunk_index": 18, "_doc_id": "18_2704428213409555065"}}
