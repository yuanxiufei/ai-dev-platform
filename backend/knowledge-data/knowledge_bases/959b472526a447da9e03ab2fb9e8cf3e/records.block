{"doc_id": "46_2470736744517447741", "text": "ine\"><span> /* ... */<span><span>\n<span class=\"line\"><span>])<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>const<span><span> itemRefs<span><span> =<span><span> ref<span><span>([])<span><span>\n<span class=\"line\"><span>\n<span class=\"line\"><span>onMounted<span><span>(() <span><span>=><span><span> console.<span><span>log<span><span>(itemRefs.value))<span><span>\n<span class=\"line\"><span></<span><span>script<span><span>><span><span>\n<span class=\"line\"><span>", "metadata": {"source": "https://cn.vuejs.org/guide/essentials/template-refs.html", "title": "模板引用", "doc_id": "b03f6f94fd6547fdb4a1ca6347e53e57", "content_type": "web_page", "word_count": 925, "chunk_index": 46, "_doc_id": "46_2470736744517447741"}}
