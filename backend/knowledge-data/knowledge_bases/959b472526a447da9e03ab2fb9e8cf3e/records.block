{"doc_id": "10_8956072996505205883", "text": "om/item/category/vuejs-admin-templates/?ref=14\" class=\"link\" target=\"_blank\">Vue Admin Template<a>, Vue + Laravel & NuxtJS Admin Templates to build modern web applications in no time!<p><section><div><div class=\"item\"><section class=\"ThemeListItem\"><h2 class=\"title\">AdminMart<h2><p class=\"description\">Check out top <a href=\"https://adminmart.com/templates/vuejs-admin/?ref=34\" class=\"link\" target=\"_blank\">Vue dashboard templates<a> built by our partners from <a href=\"https://adminmart.com/?ref=34\" class=\"link\" target=\"_blank\">AdminMart<a>.", "metadata": {"source": "https://cn.vuejs.org/ecosystem/themes", "title": "Vue.js", "doc_id": "4703c78e653746c4a5a22c9159542f3b", "content_type": "web_page", "word_count": 270, "chunk_index": 10, "_doc_id": "10_8956072996505205883"}}
