# AI Fullstack Platform — 开发/部署环境配置模板
# 复制此文件为 .env 并修改对应平台的值
# 注意：根目录 .env 优先级最高，会覆盖 backend/.env 中的同名字段

# ── 项目基础 ──
PROJECT_NAME=AI Fullstack Platform
ENVIRONMENT=local
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=11520
FRONTEND_HOST=http://localhost:5173

# ── 首次管理员 ──
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# ── 数据库（Docker Compose 使用 postgres/db，本地开发用 localhost）──
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app

# ── Redis ──
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# ── Qdrant (向量数据库) ──
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Celery 任务队列 ──
TASK_QUEUE_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/1

# ── AI 模型目录（compose volume 挂载源）──
# Linux:   MODELS_DIR=/run/media/username/Software/app/LLM/models
# Windows: MODELS_DIR=D:/app/LLM/models
MODELS_DIR=/path/to/your/LLM/models

# HuggingFace 缓存（vLLM 使用，容器内映射到 /root/.cache/huggingface）
# 模型文件应存放在 ${MODELS_DIR}/huggingface/hub/ 下
HF_HOME=${MODELS_DIR}/huggingface
HF_HUB_CACHE=${MODELS_DIR}/huggingface/hub

# 默认模型 & 本地优先
DEFAULT_MODEL=gemma-31b
MODEL_PREFER_LOCAL=true

# ── 模型调度 ──
MODEL_REQUEST_TIMEOUT=30
MODEL_MAX_RETRIES=2
MODEL_FALLBACK_ENABLED=true
AUTO_OPTIMIZE_ENABLED=true
AUTO_OPTIMIZE_INTERVAL_HOURS=24

# ── 邮件（可选）──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME=AI Fullstack Platform

# ── 第三方 API 密钥（按需填写）──
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
# AZURE_OPENAI_API_KEY=
# REPLICATE_API_KEY=
# ZHIPU_API_KEY=
# QWEN_API_KEY=

# ── Sentry（可选）──
SENTRY_DSN=

# ── 监控告警（可选）──
WECHAT_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alert@ai-platform.local
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Standalone 模式 ──
STANDALONE_MODE=false
STANDALONE_BIND_PORT=18000
